<%- include("../../partials/system-admin/header", { page_title: "BreedIT | System Admin Support Tickets" }) %>

<div class="sa-backdrop d-lg-none" id="saBackdrop"></div>

<%- include("../../partials/system-admin/sidebar", {
  current_page: "tickets",
  virtualNow,
  isTimeMocked
}) %>

<div class="sa-main">
  <header class="sa-topbar">
    <div class="container-fluid px-3 px-lg-4">
      <div class="row g-3 align-items-center">
        <div class="col-12 col-lg-6">
          <div class="d-flex align-items-center gap-2">
            <button class="btn sa-icon-btn d-lg-none" type="button" id="sidebarToggleBtn">
              <i class="bi bi-list"></i>
            </button>
            <div>
              <div class="sa-page-kicker">System Administration</div>
              <h1 class="sa-page-title mb-0">Support Tickets Oversight</h1>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6">
          <div class="d-flex justify-content-lg-end gap-2">
            <span id="ticketCountBadge" class="sa-badge-danger align-self-center">0 Open Tickets</span>
            <button class="btn sa-btn-outline" id="manualRefreshBtn" type="button">
              <i class="bi bi-arrow-repeat me-2"></i>
              Refresh Data
            </button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="sa-content">
    <div class="container-fluid px-3 px-lg-4">
      <section id="support-tickets" class="sa-panel">
        <div class="sa-panel-header">
          <div>
            <h2 class="sa-panel-title mb-1">Tickets</h2>
            <p class="sa-panel-text mb-0">Track reported issues and update their resolution status.</p>
          </div>
        </div>

        <div class="table-responsive sa-table-wrap">
          <table id="adminTicketsTable" class="table sa-table align-middle mb-0">
            <thead>
              <tr>
                <th>Ticket ID</th>
                <th>User Info</th>
                <th>Category</th>
                <th>Subject</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Resolution</th>
              </tr>
            </thead>
            <tbody id="adminTicketsBody"></tbody>
          </table>
        </div>
      </section>

      <footer class="sa-footer">
        © 2026 BreedIT System | Infrastructure & Security Monitoring
      </footer>
    </div>
  </main>
</div>

<%- include("../../partials/system-admin/footer") %>