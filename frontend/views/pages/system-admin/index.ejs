<%- include("../../partials/system-admin/header", { page_title: "BreedIT | System Admin Dashboard" }) %>

<div class="sa-backdrop d-lg-none" id="saBackdrop"></div>

<%- include("../../partials/system-admin/sidebar", {
  current_page: "dashboard",
  virtualNow,
  isTimeMocked
}) %>

<div class="sa-main">
  <header class="sa-topbar">
    <div class="container-fluid px-3 px-lg-4">
      <div class="row g-3 align-items-center">
        <div class="col-12 col-lg-7">
          <div class="d-flex align-items-center gap-2">
            <button
              class="btn sa-icon-btn d-lg-none"
              type="button"
              id="sidebarToggleBtn"
              aria-label="Open sidebar"
            >
              <i class="bi bi-list"></i>
            </button>

            <div class="min-w-0">
              <div class="sa-page-kicker">System Administration</div>
              <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 class="sa-page-title mb-0">Dashboard Overview</h1>
                <span class="sa-page-chip">
                  <i class="bi bi-shield-check me-1"></i>
                  Control Center
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-5">
          <div class="d-flex flex-column flex-sm-row justify-content-lg-end gap-2">
            <button class="btn sa-btn-outline" id="manualRefreshBtn" type="button">
              <i class="bi bi-arrow-repeat me-2"></i>
              Refresh Data
            </button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="sa-content">
    <div class="container-fluid px-3 px-lg-4">
      <section class="sa-hero-panel mb-4">
        <div class="row g-4 align-items-center">
          <div class="col-12 col-xl-8">
            <div class="sa-hero-content">
              <div class="sa-hero-kicker">Live administration workspace</div>
              <h2 class="sa-hero-title">Monitor platform health, users, tickets, and infrastructure in one place.</h2>
              <p class="sa-hero-text mb-0">
                Use the quick actions below to manage your system efficiently across desktop, tablet, and mobile devices.
              </p>
            </div>
          </div>

          <div class="col-12 col-xl-4">
            <div class="sa-hero-side">
              <div class="sa-hero-stat">
                <span class="sa-hero-stat-label">Open Tickets</span>
                <span id="ticketCountBadge" class="sa-badge-danger">0 Open Tickets</span>
              </div>
              <div class="sa-hero-stat">
                <span class="sa-hero-stat-label">Server State</span>
                <span class="sa-inline-status" id="serverStatus">--</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="row g-3 g-xl-4 mb-4">
        <div class="col-12 col-sm-6 col-xl">
          <div class="sa-metric-card">
            <div class="sa-metric-top">
              <div class="sa-metric-icon">
                <i class="bi bi-activity"></i>
              </div>
              <span class="sa-metric-trend"><i class="bi bi-waveform"></i></span>
            </div>
            <div class="sa-metric-label">Server Status</div>
            <div class="sa-metric-value" id="serverStatus">--</div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl">
          <div class="sa-metric-card">
            <div class="sa-metric-top">
              <div class="sa-metric-icon">
                <i class="bi bi-cpu-fill"></i>
              </div>
              <span class="sa-metric-trend"><i class="bi bi-speedometer2"></i></span>
            </div>
            <div class="sa-metric-label">CPU Load</div>
            <div class="sa-metric-value" id="cpuLoad">--</div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl">
          <div class="sa-metric-card">
            <div class="sa-metric-top">
              <div class="sa-metric-icon">
                <i class="bi bi-memory"></i>
              </div>
              <span class="sa-metric-trend"><i class="bi bi-bar-chart-line"></i></span>
            </div>
            <div class="sa-metric-label">Memory Usage</div>
            <div class="sa-metric-value" id="memoryUsage">--</div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl">
          <div class="sa-metric-card">
            <div class="sa-metric-top">
              <div class="sa-metric-icon">
                <i class="bi bi-people-fill"></i>
              </div>
              <span class="sa-metric-trend"><i class="bi bi-person-lines-fill"></i></span>
            </div>
            <div class="sa-metric-label">Total Users</div>
            <div class="sa-metric-value" id="totalUsers">--</div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl">
          <div class="sa-metric-card">
            <div class="sa-metric-top">
              <div class="sa-metric-icon">
                <i class="bi bi-broadcast-pin"></i>
              </div>
              <span class="sa-metric-trend"><i class="bi bi-diagram-3"></i></span>
            </div>
            <div class="sa-metric-label">Active Sessions</div>
            <div class="sa-metric-value" id="concurrentUsers">--</div>
          </div>
        </div>
      </div>

      <div class="row g-3 g-xl-4">
        <div class="col-12 col-xl-8">
          <div class="sa-panel h-100">
            <div class="sa-panel-header">
              <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                  <h2 class="sa-panel-title mb-1">Quick Navigation</h2>
                  <p class="sa-panel-text mb-0">
                    Access the main system administration modules quickly.
                  </p>
                </div>

                <div class="sa-panel-chip">
                  <i class="bi bi-lightning-charge me-1"></i>
                  Shortcuts
                </div>
              </div>
            </div>

            <div class="row g-3">
              <div class="col-12 col-md-6">
                <a href="/system-admin/maintenance" class="sa-shortcut-card text-decoration-none">
                  <span class="sa-shortcut-icon"><i class="bi bi-tools"></i></span>
                  <div class="flex-grow-1">
                    <div class="sa-shortcut-title">Maintenance</div>
                    <div class="sa-shortcut-text">Broadcast maintenance notices and scheduled downtime alerts.</div>
                  </div>
                  <span class="sa-shortcut-arrow"><i class="bi bi-arrow-up-right"></i></span>
                </a>
              </div>

              <div class="col-12 col-md-6">
                <a href="/system-admin/users" class="sa-shortcut-card text-decoration-none">
                  <span class="sa-shortcut-icon"><i class="bi bi-people"></i></span>
                  <div class="flex-grow-1">
                    <div class="sa-shortcut-title">Users</div>
                    <div class="sa-shortcut-text">Manage roles, status, and access controls across the platform.</div>
                  </div>
                  <span class="sa-shortcut-arrow"><i class="bi bi-arrow-up-right"></i></span>
                </a>
              </div>

              <div class="col-12 col-md-6">
                <a href="/system-admin/tickets" class="sa-shortcut-card text-decoration-none">
                  <span class="sa-shortcut-icon"><i class="bi bi-life-preserver"></i></span>
                  <div class="flex-grow-1">
                    <div class="sa-shortcut-title">Support Tickets</div>
                    <div class="sa-shortcut-text">Track issue reports and update resolution workflows.</div>
                  </div>
                  <span class="sa-shortcut-arrow"><i class="bi bi-arrow-up-right"></i></span>
                </a>
              </div>

              <div class="col-12 col-md-6">
                <a href="/system-admin/infrastructure" class="sa-shortcut-card text-decoration-none">
                  <span class="sa-shortcut-icon"><i class="bi bi-hdd-network"></i></span>
                  <div class="flex-grow-1">
                    <div class="sa-shortcut-title">Infrastructure</div>
                    <div class="sa-shortcut-text">Review live environment details and account oversight tables.</div>
                  </div>
                  <span class="sa-shortcut-arrow"><i class="bi bi-arrow-up-right"></i></span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-xl-4">
          <div class="sa-panel h-100">
            <div class="sa-panel-header">
              <div>
                <h2 class="sa-panel-title mb-1">System Snapshot</h2>
                <p class="sa-panel-text mb-0">Current environment overview and infrastructure status.</p>
              </div>
            </div>

            <div class="sa-info-list">
              <div class="sa-info-item">
                <span class="sa-info-label"><i class="bi bi-pc-display-horizontal me-2"></i>Platform</span>
                <span class="sa-info-value" id="osPlatform">--</span>
              </div>
              <div class="sa-info-item">
                <span class="sa-info-label"><i class="bi bi-clock me-2"></i>System Uptime</span>
                <span class="sa-info-value" id="systemUptime">--</span>
              </div>
              <div class="sa-info-item">
                <span class="sa-info-label"><i class="bi bi-cpu me-2"></i>CPU Model</span>
                <span class="sa-info-value" id="cpuModel">--</span>
              </div>
              <div class="sa-info-item">
                <span class="sa-info-label"><i class="bi bi-memory me-2"></i>Total Memory</span>
                <span class="sa-info-value" id="totalMemory">--</span>
              </div>
            </div>

            <div class="mt-3">
              <a href="/system-admin/infrastructure" class="btn sa-btn-primary w-100">
                <i class="bi bi-arrow-right-circle me-2"></i>
                View Infrastructure
              </a>
            </div>
          </div>
        </div>
      </div>

      <footer class="sa-footer">
        © 2026 BreedIT System | Infrastructure & Security Monitoring
      </footer>
    </div>
  </main>
</div>

<%- include("../../partials/system-admin/footer") %>