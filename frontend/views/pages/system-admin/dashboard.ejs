<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>BreedIT | System Admin Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      color: #333;
    }

    header {
      background: #1e293b;
      color: #fff;
      padding: 15px 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    header h1 {
      margin: 0;
      font-size: 20px;
    }

    .header-actions {
      display: flex;
      gap: 10px;
    }

    header button {
      border: none;
      color: white;
      padding: 8px 14px;
      cursor: pointer;
      border-radius: 4px;
      font-weight: bold;
    }

    #logoutBtn { background: #ef4444; }
    #manualRefreshBtn { background: #3b82f6; }
    #manualRefreshBtn:hover { background: #2563eb; }

    .container {
      display: flex;
      min-height: calc(100vh - 60px);
    }

    nav {
      width: 240px;
      background: #111827;
      color: white;
      padding-top: 20px;
    }

    nav a {
      display: block;
      padding: 14px 20px;
      color: #d1d5db;
      text-decoration: none;
    }

    nav a:hover {
      background: #1f2937;
      color: white;
    }

    main {
      flex: 1;
      padding: 25px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }

    .card {
      background: white;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      position: relative;
      overflow: hidden;
    }

    .card h2 {
      margin: 0;
      font-size: 14px;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .card p {
      font-size: 28px;
      margin-top: 10px;
      font-weight: bold;
    }

    /* Maintenance Section Styling */
    .maintenance-box {
      background: white;
      padding: 25px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      margin-bottom: 40px;
    }

    .maintenance-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      max-width: 800px;
    }

    .maintenance-form .full-width {
      grid-column: span 2;
    }

    .maintenance-form label {
      font-size: 13px;
      font-weight: bold;
      color: #4b5563;
      margin-bottom: -10px;
    }

    .maintenance-form input, 
    .maintenance-form textarea {
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 4px;
      width: 100%;
      font-family: inherit;
      box-sizing: border-box;
    }

    .maintenance-form textarea {
      height: 80px;
      resize: vertical;
    }

    #sendMaintBtn {
      background: #f59e0b;
      color: white;
      border: none;
      padding: 12px;
      font-weight: bold;
      cursor: pointer;
      border-radius: 4px;
      transition: background 0.2s;
    }

    #sendMaintBtn:hover { background: #d97706; }

    /* Status styling for Server Health */
    .status-stable { color: #10b981; }
    .status-strained { color: #f59e0b; }
    .status-danger { color: #ef4444; }

    /* Indicator for Active Sessions */
    #concurrentUsers { color: #3b82f6; }
    .pulse-dot {
      display: inline-block;
      width: 10px;
      height: 10px;
      background-color: #10b981;
      border-radius: 50%;
      margin-right: 8px;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    #searchUser {
      padding: 10px 15px;
      width: 100%;
      max-width: 400px;
      margin-bottom: 20px;
      border: 1px solid #ddd;
      border-radius: 6px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      margin-bottom: 40px;
    }

    th, td {
      padding: 14px 15px;
      border-bottom: 1px solid #eee;
      text-align: left;
      font-size: 14px;
    }

    th {
      background: #1e293b;
      color: white;
      font-weight: 500;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
      background: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .info-grid p {
      margin: 8px 0;
      font-size: 15px;
    }

    footer {
      margin-top: 40px;
      padding: 20px;
      text-align: center;
      font-size: 13px;
      color: #9ca3af;
      border-top: 1px solid #e5e7eb;
    }
  </style>
</head>

<body>

<header>
  <h1>BreedIT – System Admin Dashboard</h1>
  <div class="header-actions">
    <button id="manualRefreshBtn">🔄 Refresh Data</button>
    <button id="logoutBtn">Logout</button>
  </div>
</header>

<div class="container">

  <nav>
    <a href="#">📊 System Health</a>
    <a href="#maintenance">🚧 Scheduling</a>
    <a href="#user-control">👤 User Control</a>
    <a href="#infrastructure">📁 Infrastructure</a>
  </nav>

  <main>

    <h2>System Performance</h2>
    <div class="cards">
      <div class="card">
        <h2>Server Status</h2>
        <p id="serverStatus">--</p>
      </div>
      <div class="card">
        <h2>CPU Load</h2>
        <p id="cpuLoad">--</p>
      </div>
      <div class="card">
        <h2>Memory Usage</h2>
        <p id="memoryUsage">--</p>
      </div>
      <div class="card">
        <h2>Total Users</h2>
        <p id="totalUsers">--</p>
      </div>
      <div class="card">
        <h2><span class="pulse-dot"></span>Active Sessions</h2>
        <p id="concurrentUsers">--</p>
      </div>
    </div>

    <section id="maintenance" class="maintenance-box">
      <h2>Broadcast System Maintenance</h2>
      <p style="color: #6b7280; font-size: 14px; margin-bottom: 20px;">
        Notify all users about upcoming downtime or system updates.
      </p>
      <div class="maintenance-form">
        <div class="full-width">
            <label for="maintTitle">Alert Title</label>
            <input type="text" id="maintTitle" placeholder="e.g., Sunday System Upgrade">
        </div>

        <div>
            <label for="maintStart">Maintenance Start</label>
            <input type="datetime-local" id="maintStart">
        </div>

        <div>
            <label for="maintEnd">Maintenance End (Notice Removal)</label>
            <input type="datetime-local" id="maintEnd">
        </div>

        <div class="full-width">
            <label for="maintMessage">Detailed Message</label>
            <textarea id="maintMessage" placeholder="Detailed message for all users..."></textarea>
        </div>

        <button id="sendMaintBtn" class="full-width">🚀 Broadcast to All Users</button>
      </div>
    </section>

    <section id="user-control">
      <h2>User Access Management</h2>
      <input type="text" id="searchUser" placeholder="Search by name or email..." />
      <table id="usersTable">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </section>

    <section id="infrastructure">
      <h2>Infrastructure Details</h2>

      <div class="info-grid" id="systemInfoBox">
        <div>
          <p><strong>OS Platform:</strong> <span id="osPlatform">--</span></p>
          <p><strong>System Uptime:</strong> <span id="systemUptime">--</span></p>
        </div>
        <div>
          <p><strong>CPU Model:</strong> <span id="cpuModel">--</span></p>
          <p><strong>Total Memory:</strong> <span id="totalMemory">--</span></p>
        </div>
      </div>

      <br>
      <h3>Farm Managers Oversight</h3>
      <table id="farmManagersTable">
        <thead>
          <tr>
            <th>User ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>

      <h3>Farmers Oversight</h3>
      <table id="farmersTable">
        <thead>
          <tr>
            <th>Farmer ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Contact</th>
            <th>Pens</th>
            <th>Registered By</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>

    </section>

    <footer>
      © 2026 BreedIT System | Infrastructure & Security Monitoring
    </footer>

  </main>
</div>

<script src="../../../js/system-admin/dashboard.js"></script>
</body>
</html>