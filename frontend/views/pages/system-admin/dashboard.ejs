<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>BreedIT | System Admin Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      color: #333;
    }

    header {
      background: #1e293b;
      color: #fff;
      padding: 15px 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    header h1 {
      margin: 0;
      font-size: 20px;
    }

    header button {
      background: #ef4444;
      border: none;
      color: white;
      padding: 8px 14px;
      cursor: pointer;
      border-radius: 4px;
    }

    .container {
      display: flex;
      min-height: calc(100vh - 60px);
    }

    nav {
      width: 240px;
      background: #111827;
      color: white;
      padding-top: 20px;
    }

    nav a {
      display: block;
      padding: 14px 20px;
      color: #d1d5db;
      text-decoration: none;
    }

    nav a:hover {
      background: #1f2937;
      color: white;
    }

    main {
      flex: 1;
      padding: 25px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }

    .card {
      background: white;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .card h2 {
      margin: 0;
      font-size: 14px;
      color: #6b7280;
    }

    .card p {
      font-size: 28px;
      margin-top: 10px;
      font-weight: bold;
    }

    /* Status styling for Server Health */
    .status-stable { color: #10b981; }
    .status-strained { color: #f59e0b; }
    .status-danger { color: #ef4444; }

    input[type="text"] {
      padding: 8px 12px;
      width: 300px;
      margin-bottom: 15px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      margin-bottom: 40px;
    }

    th, td {
      padding: 12px 15px;
      border-bottom: 1px solid #ddd;
      text-align: left;
      font-size: 14px;
    }

    th {
      background: #1e293b;
      color: white;
    }

    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      background: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    footer {
      margin-top: 30px;
      text-align: center;
      font-size: 13px;
      color: #6b7280;
    }
  </style>
</head>

<body>

<header>
  <h1>BreedIT – System Admin Dashboard</h1>
  <button id="logoutBtn">Logout</button>
</header>

<div class="container">

  <nav>
    <a href="#">📊 System Health</a>
    <a href="#user-control">👤 User Control</a>
    <a href="#infrastructure">📁 Infrastructure</a>
  </nav>

  <main>

    <h2>System Performance</h2>
    <div class="cards">
      <div class="card">
        <h2>Server Status</h2>
        <p id="serverStatus">--</p>
      </div>
      <div class="card">
        <h2>CPU Load</h2>
        <p id="cpuLoad">--</p>
      </div>
      <div class="card">
        <h2>Memory Usage</h2>
        <p id="memoryUsage">--</p>
      </div>
      <div class="card">
        <h2>Total Users</h2>
        <p id="totalUsers">--</p>
      </div>
      <div class="card">
        <h2>Active Sessions</h2>
        <p id="concurrentUsers">--</p>
      </div>
    </div>

    <section id="user-control">
      <h2>User Access Management</h2>
      <input type="text" id="searchUser" placeholder="Search by name or email..." />
      <table id="usersTable">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </section>

    <section id="infrastructure">
      <h2>Infrastructure Details</h2>

      <div class="info-grid" id="systemInfoBox">
        <div>
          <p><strong>OS Platform:</strong> <span id="osPlatform">--</span></p>
          <p><strong>System Uptime:</strong> <span id="systemUptime">--</span></p>
        </div>
        <div>
          <p><strong>CPU Model:</strong> <span id="cpuModel">--</span></p>
          <p><strong>Total Memory:</strong> <span id="totalMemory">--</span></p>
        </div>
      </div>

      <br>
      <h3>Farm Managers Oversight</h3>
      <table id="farmManagersTable">
        <thead>
          <tr>
            <th>User ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>

      <h3>Farmers Oversight</h3>
      <table id="farmersTable">
        <thead>
          <tr>
            <th>Farmer ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Contact</th>
            <th>Pens</th>
            <th>Registered By</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>

    </section>

    <footer>
      © 2026 BreedIT System | Infrastructure & Security Monitoring
    </footer>

  </main>
</div>

<script src="../../../js/system-admin/dashboard.js"></script>
</body>
</html>