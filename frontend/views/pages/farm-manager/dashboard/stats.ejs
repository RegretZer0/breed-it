<div class="row g-3 stats-grid">

  <!-- Total Pigs -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-main">
        <div class="stat-label">Total Pigs</div>
        <div class="stat-number" data-stat="totalPigs">—</div>
      </div>
      <div class="stat-icon orange" aria-hidden="true">
        <i class="bi bi-piggy-bank"></i>
      </div>
    </div>
  </div>

  <!-- Alive -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-main">
        <div class="stat-label">Alive</div>
        <div class="stat-number" data-stat="alive">—</div>
      </div>
      <div class="stat-icon green" aria-hidden="true">
        <i class="bi bi-heart-pulse"></i>
      </div>
    </div>
  </div>

  <!-- Mortality -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-main">
        <div class="stat-label">Mortality</div>
        <div class="stat-number" data-stat="mortality">—</div>
      </div>
      <div class="stat-icon red" aria-hidden="true">
        <i class="bi bi-activity"></i>
      </div>
    </div>
  </div>

  <!-- In-Heat -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-main">
        <div class="stat-label">In-Heat Phase</div>
        <div class="stat-number" data-stat="inHeat">—</div>
      </div>
      <div class="stat-icon brown" aria-hidden="true">
        <i class="bi bi-droplet"></i>
      </div>
    </div>
  </div>

  <!-- Pregnant -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-main">
        <div class="stat-label">Pregnant Sow</div>
        <div class="stat-number" data-stat="pregnant">—</div>
      </div>
      <div class="stat-icon purple" aria-hidden="true">
        <i class="bi bi-heart"></i>
      </div>
    </div>
  </div>

  <!-- Farrowing -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-main">
        <div class="stat-label">Farrowing Phase</div>
        <div class="stat-number" data-stat="farrowing">—</div>
      </div>
      <div class="stat-icon blue2" aria-hidden="true">
        <i class="bi bi-plus-circle"></i>
      </div>
    </div>
  </div>

  <!-- Weaning -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-main">
        <div class="stat-label">Weaning Phase</div>
        <div class="stat-number" data-stat="weaning">—</div>
      </div>
      <div class="stat-icon teal" aria-hidden="true">
        <i class="bi bi-star"></i>
      </div>
    </div>
  </div>

  <!-- Lactating -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-main">
        <div class="stat-label">Lactating Phase</div>
        <div class="stat-number" data-stat="lactating">—</div>
      </div>
      <div class="stat-icon blue" aria-hidden="true">
        <i class="bi bi-droplet-half"></i>
      </div>
    </div>
  </div>

</div>