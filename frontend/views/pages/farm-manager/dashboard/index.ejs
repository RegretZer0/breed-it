<%- include("../../../partials/farm-manager/header") %>
<%- include("../../../partials/farm-manager/navbar") %>
<%- include("../../../partials/farm-manager/sidepanel") %>

<main class="main-content">
  <div class="container-fluid dashboard-root">

    <!-- WELCOME CARD -->
    <div class="card page-card dashboard-welcome-card mb-3">
      <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="welcome-mark" aria-hidden="true">
            <i class="bi bi-house-heart"></i>
          </div>

          <div class="min-w-0">
            <h4 class="dashboard-welcome mb-1">Welcome</h4>
            <div class="welcome-sub text-muted small">
              Here’s a quick overview of your farm activity today.
            </div>
          </div>
        </div>

        <div class="welcome-meta d-flex align-items-center gap-2">
          <span class="badge rounded-pill text-bg-light border">
            <i class="bi bi-calendar2-week me-1"></i> Dashboard
          </span>
        </div>
      </div>
    </div>

    <!-- ================= STATS CARD ================= -->
    <div class="card page-card dashboard-card mb-3">
      <div class="card-body">
        <%- include("./stats") %>
      </div>
    </div>

    <!-- ================= CALENDAR + TASKS ================= -->
    <%- include("./calendar") %>

  </div>
</main>

<%- include("../../../partials/farm-manager/footer") %>