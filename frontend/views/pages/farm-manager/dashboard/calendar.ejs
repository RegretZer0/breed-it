<div class="row g-3 g-lg-4 align-items-stretch">

  <!-- ================= CALENDAR ================= -->
  <div class="col-12 col-lg-8">
    <div class="card page-card h-100 dashboard-card">
      <div class="card-body">

        <!-- Head -->
        <div class="dashboard-card-head d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
          <div class="min-w-0">
            <h5 class="mb-1">Breeding &amp; Farrowing Schedule</h5>
            <div class="text-muted small">
              Monitor Artificial Insemination, Heat re-checks, Farrowing, and Weaning events
            </div>
          </div>

          <!-- Optional helper note (no IDs added/changed) -->
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge rounded-pill text-bg-light border">
              <i class="bi bi-info-circle me-1"></i>
              Click a date to view tasks
            </span>
          </div>
        </div>

        <!-- FullCalendar Mount Point -->
        <div id="calendar"></div>

      </div>
    </div>
  </div>

  <!-- ================= TASK PANEL ================= -->
  <div class="col-12 col-lg-4">
    <div class="card page-card h-100 dashboard-card">
      <div class="card-body d-flex flex-column">

        <!-- Head -->
        <div class="dashboard-card-head d-flex align-items-start justify-content-between gap-2 mb-2">
          <div class="min-w-0">
            <h5 class="mb-1">Tasks</h5>
            <div class="text-muted small">Selected Date</div>
          </div>

          <!-- Quick hint -->
          <span class="badge rounded-pill text-bg-light border flex-shrink-0">
            <i class="bi bi-calendar-week me-1"></i>
            Use “This Week”
          </span>
        </div>

        <!-- Selected Date Label (KEEP ID) -->
        <div id="selectedDateLabel" class="small text-muted mb-2">
          No date selected
        </div>

        <!-- Task List Container (KEEP ID) -->
        <div id="taskPanel" class="task-panel flex-grow-1">
          <div class="text-muted small">
            Click a calendar date to view tasks.
          </div>
        </div>

      </div>
    </div>
  </div>

</div>