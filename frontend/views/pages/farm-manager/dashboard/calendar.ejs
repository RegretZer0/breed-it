<div class="row g-3 g-lg-4 align-items-stretch">

  <!-- ================= CALENDAR ================= -->
  <div class="col-12 col-lg-8">
    <div class="card page-card h-100 dashboard-card">
      <div class="card-body">

        <div class="dashboard-card-head mb-3">
          <div>
            <h5 class="mb-1">Breeding & Farrowing Schedule</h5>
            <div class="text-muted small">
              Monitor Artificial Insemination, Heat re-checks, Farrowing, and Weaning events
            </div>
          </div>
        </div>

        <!-- FullCalendar Mount Point -->
        <div id="calendar"></div>

      </div>
    </div>
  </div>

  <!-- ================= TASK PANEL ================= -->
  <div class="col-12 col-lg-4">
    <div class="card page-card h-100 dashboard-card">
      <div class="card-body d-flex flex-column">

        <div class="dashboard-card-head mb-2">
          <div>
            <h5 class="mb-1">Tasks</h5>
            <div class="text-muted small">Selected Date</div>
          </div>
        </div>

        <!-- Selected Date Label -->
        <div id="selectedDateLabel" class="small text-muted mb-2">
          No date selected
        </div>

        <!-- Task List Container -->
        <div id="taskPanel" class="task-panel flex-grow-1">
          <div class="text-muted small">
            Click a calendar date to view tasks.
          </div>
        </div>

      </div>
    </div>
  </div>

</div>