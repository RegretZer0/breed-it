<article class="heat-card" data-id="{{id}}">
    <header class="heat-card-header">
        <span class="heat-id">{{swine}}</span>
        <span class="status {{status}}">{{statusLabel}}</span>
</header>


<div class="heat-meta">
    <div>
        <small>Farmer</small>
        <strong>{{farmer}}</strong>
    </div>
    <div>
        <small>Heat Probability</small>
        <strong>{{probability}}%</strong>
    </div>
</div>


<div class="heat-progress">
    <div class="progress-bar">
        <span style="width: {{progress}}%"></span>
    </div>
        <small>{{progressLabel}}</small>
</div>


<footer class="heat-card-actions">
    <button class="btn-view" data-id="{{id}}">View Progress</button>
</footer>
</article>