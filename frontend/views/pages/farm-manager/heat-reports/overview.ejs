<div class="card page-card overview-card heat-soft-card">
  <div class="card-body">

    <!-- Title row (dashboard style) -->
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2 mb-3">
      <div>
        <h4 class="page-title mb-1">FARMER REPORTS</h4>
        <div class="text-muted small">
          Review heat monitoring reports and track reproductive progress.
        </div>
      </div>
    </div>

    <!-- Stats (5 cards) -->
    <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-4 row-cols-xl-5 stats-grid">

      <!-- In-Heat -->
      <div class="col">
        <div class="stat-card heat-stat-card">
          <div>
            <div class="stat-label">In-Heat</div>
            <div class="stat-number" id="countInHeat">0</div>
          </div>
          <div class="stat-icon orange">
            <i class="bi bi-fire"></i>
          </div>
        </div>
      </div>

      <!-- Under Observation -->
      <div class="col">
        <div class="stat-card heat-stat-card">
          <div>
            <div class="stat-label">Under Observation</div>
            <div class="stat-number" id="countAwaitingRecheck">0</div>
          </div>
          <div class="stat-icon blue">
            <i class="bi bi-clipboard2-pulse"></i>
          </div>
        </div>
      </div>

      <!-- Pregnant -->
      <div class="col">
        <div class="stat-card heat-stat-card">
          <div>
            <div class="stat-label">Pregnant</div>
            <div class="stat-number" id="countPregnant">0</div>
          </div>
          <div class="stat-icon green">
            <i class="bi bi-heart-fill"></i>
          </div>
        </div>
      </div>

      <!-- Farrowing -->
      <div class="col">
        <div class="stat-card heat-stat-card">
          <div>
            <div class="stat-label">Farrowing</div>
            <div class="stat-number" id="countFarrowingReady">0</div>
          </div>
          <div class="stat-icon red">
            <i class="bi bi-house-heart-fill"></i>
          </div>
        </div>
      </div>

      <!-- Lactating -->
      <div class="col">
        <div class="stat-card heat-stat-card">
          <div>
            <div class="stat-label">Lactating</div>
            <div class="stat-number" id="countLactating">0</div>
          </div>
          <div class="stat-icon pink">
            <i class="bi bi-droplet-fill"></i>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>