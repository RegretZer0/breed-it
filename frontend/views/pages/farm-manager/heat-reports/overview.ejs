<div class="card page-card overview-card mb-3">
  <div class="card-body">

    <div class="d-flex align-items-start align-items-md-center justify-content-between flex-wrap gap-2 mb-3">
      <div class="min-w-0">
        <h5 class="mb-1 fw-bold">Overview</h5>
        <div class="text-muted small">Quick counts by cycle status.</div>
      </div>
    </div>

    <!-- Responsive stats grid -->
    <div class="row g-3">

      <!-- In-Heat -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card d-flex justify-content-between align-items-center">
          <div class="min-w-0">
            <div class="stat-label">In-Heat</div>
            <div class="stat-number" id="countInHeat">0</div>
          </div>
          <div class="stat-icon orange">
            <i class="bi bi-fire"></i>
          </div>
        </div>
      </div>

      <!-- Under Observation -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card d-flex justify-content-between align-items-center">
          <div class="min-w-0">
            <div class="stat-label">Under Observation</div>
            <div class="stat-number" id="countAwaitingRecheck">0</div>
          </div>
          <div class="stat-icon blue">
            <i class="bi bi-search"></i>
          </div>
        </div>
      </div>

      <!-- Pregnant -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card d-flex justify-content-between align-items-center">
          <div class="min-w-0">
            <div class="stat-label">Pregnant</div>
            <div class="stat-number" id="countPregnant">0</div>
          </div>
          <div class="stat-icon green">
            <i class="bi bi-heart-fill"></i>
          </div>
        </div>
      </div>

      <!-- Farrowing -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card d-flex justify-content-between align-items-center">
          <div class="min-w-0">
            <div class="stat-label">Farrowing</div>
            <div class="stat-number" id="countFarrowingReady">0</div>
          </div>
          <div class="stat-icon red">
            <i class="bi bi-house-heart-fill"></i>
          </div>
        </div>
      </div>

      <!-- Lactating (keeps same ID) -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card d-flex justify-content-between align-items-center">
          <div class="min-w-0">
            <div class="stat-label">Lactating</div>
            <div class="stat-number" id="countLactating">0</div>
          </div>
          <div class="stat-icon pink">
            <i class="bi bi-droplet-fill"></i>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>