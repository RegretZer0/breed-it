<!-- ================= REPORT DETAILS MODAL ================= -->
<div id="reportDetailsModal" class="modal-overlay">
  <div class="modal-panel">

    <!-- HEADER -->
    <div class="modal-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-clipboard-check"></i>
        <h5 class="mb-0">Report Details</h5>
      </div>

      <button
        id="closeReportModal"
        class="modal-close"
        type="button"
        aria-label="Close"
      >
        &times;
      </button>
    </div>

    <!-- BODY -->
    <div class="modal-body">

      <!-- =======================================================
           LEGACY / COMPAT (DO NOT REMOVE)
           These IDs are still referenced by reports.js as fallback.
      ======================================================== -->
      <div class="visually-hidden" aria-hidden="true">
        <div id="reportSwine"></div>
        <div id="reportFarmer"></div>
      </div>

      <div class="report-summary d-flex flex-column gap-3">

        <!-- ================= HERO (Pig) ================= -->
        <div class="mini-card p-3 heat-soft-card" id="swineInfoCard">

          <div class="d-flex align-items-start justify-content-between gap-3">

            <!-- Left: Avatar + Content -->
            <div class="d-flex align-items-start gap-3 flex-grow-1" style="min-width:0;">

              <!-- Avatar Slot (ID preserved) -->
              <div id="pigAvatarSlot" class="heat-avatar-slot" aria-label="Pig profile slot">
                <img
                  id="pigAvatarImg"
                  src=""
                  alt="Pig"
                  class="heat-avatar-img"
                  style="display:none;"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="heat-avatar-fallback">
                  <i class="bi bi-piggy-bank"></i>
                </div>
              </div>

              <!-- Tag + chips -->
              <div class="flex-grow-1" style="min-width:0;">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <i class="bi bi-tag text-success"></i>
                  <div class="fw-bold heat-hero-title text-truncate">
                    <span id="pigTag">—</span>
                  </div>
                </div>

                <!-- Chips -->
                <div class="d-flex flex-wrap gap-2 mt-2">

                  <!-- DATE PILL -->
                  <div class="heat-pill" aria-label="Report date and time">
                    <i class="bi bi-calendar-event"></i>
                    <span class="heat-pill-label">Date:</span>
                    <span id="reportDateTime">—</span>
                  </div>

                  <!-- HEALTH PILL -->
                  <div
                    id="pigHealthPill"
                    data-health="unknown"
                    class="heat-pill text-capitalize"
                    aria-label="Pig health status"
                  >
                    <i class="bi bi-heart-pulse"></i>
                    <span class="heat-pill-label">Health:</span>
                    <span id="pigHealthText">Unknown</span>
                  </div>

                  <!-- Keep old id (compat) but hidden -->
                  <span id="pigStage" class="visually-hidden" aria-hidden="true">—</span>
                </div>

                <!-- Reported by + Farmer toggle -->
                <div class="d-flex align-items-center gap-2 flex-wrap mt-2">
                  <div class="text-muted small d-flex align-items-center gap-2">
                    <i class="bi bi-person-badge"></i>
                    <span>
                      Reported by:
                      <strong id="reportedByName">—</strong>
                      <span class="text-muted" id="reportedById">—</span>
                    </span>
                  </div>

                  <button
                    id="toggleFarmerBtn"
                    type="button"
                    class="btn-nav secondary ms-auto"
                    aria-expanded="false"
                    aria-controls="farmerInfoCard"
                  >
                    <i class="bi bi-person-vcard me-1"></i>
                    Show Farmer
                  </button>
                </div>

              </div>
            </div>

            <!-- Right: Status badge -->
            <div class="flex-shrink-0">
              <span id="reportStatus" class="report-status" data-status="pending">pending</span>
            </div>

          </div>

          <!-- Pig meta row -->
          <div class="row g-2 mt-3">
            <div class="col-12 col-sm-4">
              <div class="text-muted small mb-1">Current Weight</div>
              <div class="fw-bold"><span id="pigWeight">—</span></div>
            </div>

            <div class="col-12 col-sm-4">
              <div class="text-muted small mb-1">Cycle</div>
              <div class="fw-bold"><span id="pigCycle">—</span></div>
            </div>

            <div class="col-12 col-sm-4">
              <div class="text-muted small mb-1">Probability</div>
              <div class="fw-bold"><span id="reportProbabilityValue">—</span></div>
            </div>
          </div>

          <!-- Keep old hidden id (compat) -->
          <p id="reportProbability" class="visually-hidden" aria-hidden="true"></p>
        </div>

        <!-- ================= FARMER CARD (Hidden by default; toggled from Pig card) ================= -->
        <div class="mini-card p-3 heat-soft-card" id="farmerInfoCard" style="display:none;">

          <div class="d-flex gap-3 align-items-start">

            <!-- Farmer Avatar Slot -->
            <div id="farmerAvatarSlot" class="heat-avatar-slot heat-avatar-slot--neutral" aria-label="Farmer profile slot">
              <img
                id="farmerAvatarImg"
                src=""
                alt="Farmer"
                class="heat-avatar-img"
                style="display:none;"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div class="heat-avatar-fallback heat-avatar-fallback--neutral">
                <i class="bi bi-person-circle"></i>
              </div>
            </div>

            <div class="flex-grow-1" style="min-width:0;">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <i class="bi bi-person-badge text-secondary"></i>
                <div class="fw-bold" style="font-size:16px; color:#111827;">
                  <span id="farmerName">—</span>
                </div>
              </div>

              <div class="mt-1">
                <span class="text-muted small">Farmer ID:</span>
                <strong id="farmerIdText">—</strong>
              </div>

              <div class="row g-2 mt-2">
                <div class="col-12 col-sm-5">
                  <div class="text-muted small mb-1">Phone</div>
                  <div class="fw-bold"><span id="farmerPhone">—</span></div>
                </div>

                <div class="col-12 col-sm-7">
                  <div class="text-muted small mb-1">Address</div>
                  <div class="fw-bold"><span id="farmerAddress">—</span></div>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- ================= OBSERVED SIGNS ================= -->
        <div class="mini-card p-3 heat-soft-card">
          <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-activity"></i>
            <span class="mini-card-label">Observed Signs</span>
          </div>
          <div id="reportSigns" class="signs-container"></div>
        </div>

        <!-- ================= NOTES ================= -->
        <div class="mini-card p-3 heat-soft-card" id="reportNotesWrap">
          <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-journal-text"></i>
            <span class="mini-card-label">Farmer Notes</span>
          </div>

          <div id="reportNotes" class="subtext" style="font-size:14px;">
            <span class="text-muted">No remarks provided.</span>
          </div>
        </div>

        <!-- ================= EVIDENCE ================= -->
        <div class="mini-card p-3 heat-soft-card" id="evidenceCard">
          <div class="d-flex align-items-center justify-content-between gap-2 mb-2 flex-wrap">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-images"></i>
              <span class="mini-card-label">Evidence</span>
            </div>
            <small class="text-muted">Tap an item to preview</small>
          </div>

          <!-- Inline Preview Panel -->
          <div id="evidencePreview" class="evidence-preview" style="display:none;"></div>

          <!-- Thumbs -->
          <div id="evidenceGallery" class="evidence-gallery"></div>
        </div>

      </div>
    </div>

    <!-- FOOTER / ACTIONS -->
    <div class="modal-footer report-actions">
      <button id="approveBtn" style="display:none;" type="button">
        <i class="bi bi-check-circle"></i> Approve
      </button>

      <button id="rejectBtn" style="display:none;" type="button">
        <i class="bi bi-x-circle"></i> Reject
      </button>

      <button id="confirmAIBtn" style="display:none;" type="button">
        <i class="bi bi-droplet-half"></i> Confirm AI
      </button>

      <button id="confirmPregnancyBtn" style="display:none;" type="button">
        <i class="bi bi-heart-pulse"></i> Confirm Pregnancy
      </button>

      <button id="followUpBtn" style="display:none;" type="button">
        <i class="bi bi-arrow-repeat"></i> Cycle Failed
      </button>

      <button id="confirmFarrowingBtn" style="display:none;" type="button">
        <i class="bi bi-egg-fried"></i> Confirm Farrowing
      </button>

      <button id="closeReportModalBtn" class="secondary" type="button">
        Close
      </button>
    </div>

  </div>
</div>

<!-- ================= AI CONFIRM MODAL ================= -->
<div id="aiConfirmModal" class="modal">
  <div class="modal-content">
    <h3>
      <i class="bi bi-droplet-half"></i> Confirm AI Service
    </h3>

    <label>Select Sire (Boar)</label>
    <select id="boarSelect"></select>

    <div class="d-flex gap-2 mt-3 flex-wrap">
      <button id="submitAI" class="btn-nav" type="button">
        <i class="bi bi-check-circle"></i> Confirm AI
      </button>

      <button
        type="button"
        class="btn-nav secondary"
        onclick="document.getElementById('aiConfirmModal').style.display='none'">
        Cancel
      </button>
    </div>
  </div>
</div>

<!-- ================= FARROWING MODAL ================= -->
<div id="farrowingModal" class="modal">
  <div class="modal-content">
    <h3>
      <i class="bi bi-egg-fried"></i> Register Farrowing Results
    </h3>

    <form id="farrowingForm">
      <label>Actual Farrowing Date</label>
      <input type="date" id="farrowingDateInput" required>

      <div class="count-grid">
        <div>
          <label>Live</label>
          <input type="number" id="liveCount" min="0" value="0">
        </div>
        <div>
          <label>Mortality</label>
          <input type="number" id="mortalityCount" min="0" value="0">
        </div>
      </div>

      <div class="d-flex gap-2 mt-3 flex-wrap">
        <button type="submit" class="btn-nav">
          <i class="bi bi-check-circle"></i> Confirm Farrowing
        </button>

        <button
          type="button"
          class="btn-nav secondary"
          onclick="document.getElementById('farrowingModal').style.display='none'">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ================= REJECT MODAL ================= -->
<div id="rejectReasonModal" class="modal">
  <div class="modal-content">
    <h3>Reject Report</h3>

    <p class="text-muted">
      Please provide a reason for rejecting this report.
    </p>

    <textarea
      id="rejectReasonInput"
      rows="4"
      placeholder="Enter rejection reason..."
      style="resize:none;">
    </textarea>

    <div class="d-flex gap-2 mt-3 flex-wrap">
      <button id="confirmRejectBtn" class="btn-nav" type="button">
        <i class="bi bi-x-circle"></i> Reject
      </button>

      <button
        type="button"
        class="btn-nav secondary"
        onclick="document.getElementById('rejectReasonModal').style.display='none'">
        Cancel
      </button>
    </div>
  </div>
</div>

<!-- ================= TRACK PROGRESS PANEL ================= -->
<div id="trackProgressPanel" class="progress-panel">

  <!-- HEADER -->
  <div class="progress-panel-header">
    <div>
      <h4 class="panel-title">Progress Tracking</h4>
      <p id="progressFarmerName" class="panel-subtitle">
        Farmer: —
      </p>
    </div>

    <button id="closeProgressPanel" class="panel-close" type="button" aria-label="Close">&times;</button>
  </div>

  <!-- BODY -->
  <div class="progress-panel-body">

    <!-- SUMMARY CARD -->
    <div class="cycle-summary-card">
      <div class="cycle-summary-top">
        <div class="cycle-swine">
          <i class="bi bi-heart-fill text-success"></i>
          <strong id="progressSwineId">—</strong>
        </div>

        <span id="cycleStatus" class="cycle-status-badge">
          Active
        </span>
      </div>

      <!-- TIME-BASED INFO -->
      <div class="cycle-time-info">
        <div class="time-row">
          <span class="label">Current Stage</span>
          <strong id="currentStage">—</strong>
        </div>

        <div class="time-row highlight">
          <span class="label">Time Remaining</span>
          <strong id="remainingDays">—</strong>
        </div>
      </div>
    </div>

    <!-- TIMELINE -->
    <div class="cycle-timeline" id="cycleTimeline">
      <div class="timeline-empty text-muted">
        No cycle data available.
      </div>
    </div>

  </div>
</div>