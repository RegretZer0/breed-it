<!-- ================= REPORT DETAILS MODAL ================= -->
<div id="reportDetailsModal" class="modal-overlay">
  <div class="modal-panel modal-panel-lg">

    <!-- HEADER -->
    <div class="modal-header rd-header">
      <div class="d-flex align-items-center gap-2 min-w-0">
        <span class="rd-head-icon">
          <i class="bi bi-clipboard-check"></i>
        </span>

        <div class="min-w-0">
          <h5 class="mb-0 rd-title">Report Details</h5>
          <div class="rd-sub text-muted small">Review report info, signs, notes, and evidence.</div>
        </div>
      </div>

      <button id="closeReportModal" class="modal-close" type="button" aria-label="Close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <!-- BODY -->
    <div class="modal-body rd-body">

      <!-- ================= SUMMARY CARD ================= -->
      <div class="rd-card rd-summary-card">
        <div class="rd-summary-top">

          <!-- LEFT: pig avatar + swine meta -->
          <div class="rd-swine-wrap d-flex align-items-start gap-3">

            <!-- NEW: Pig profile slot -->
            <div class="rd-avatar">
              <img
                id="reportSwinePhoto"
                src="/images/pig-default.png"
                alt="Swine profile"
                loading="lazy"
                onerror="this.src='/images/pig-default.png';"
              />
            </div>

            <!-- Swine (JS writes innerHTML here) -->
            <div class="min-w-0 flex-grow-1">
              <div id="reportSwine" class="rd-swine"></div>

              <div class="rd-submeta mt-2">

                <!-- Date chip (labeled) -->
                <span class="rd-chip" id="reportCreatedAt">
                  <i class="bi bi-calendar3"></i>
                  <span class="rd-chip-label">Date</span>
                  <span class="rd-chip-text">—</span>
                </span>

                <!-- CHANGED: health status pill -->
                <span class="rd-chip" id="reportHealthStatus" data-health="">
                  <i class="bi bi-heart-pulse"></i>
                  <span class="rd-chip-label">Health</span>
                  <span class="rd-chip-text">—</span>
                </span>

              </div>
            </div>
          </div>

          <!-- RIGHT: Report status pill (existing ID) -->
          <span id="reportStatus" class="report-status" data-status=""></span>
        </div>
      </div>

      <!-- ================= INFO CARDS (2-UP DESKTOP) ================= -->
      <div class="rd-info-grid mt-3">

        <div class="rd-card rd-info-card">
          <div class="rd-info-head rd-info-head-split">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-person-badge"></i>
              <span class="rd-info-title">Farmer</span>
            </div>

            <button
              type="button"
              id="toggleFarmerCardBtn"
              class="rd-mini-btn"
              aria-expanded="false"
            >
              <i class="bi bi-eye me-1"></i> View
            </button>
          </div>

          <div id="reportFarmer" class="rd-info-value"></div>

          <!-- collapsible farmer card mount -->
          <div id="farmerMiniCardWrap" class="rd-collapse mt-3" style="display:none;">
            <div id="farmerMiniCard" class="rd-farmer-card"></div>
          </div>
        </div>

        <div class="rd-card rd-info-card">
          <div class="rd-info-head">
            <i class="bi bi-bar-chart"></i>
            <span class="rd-info-title">Probability</span>
          </div>
          <div id="reportProbability" class="rd-info-value"></div>
        </div>

      </div>

      <!-- ================= OBSERVED SIGNS CARD ================= -->
      <div class="rd-card rd-section-card mt-3">
        <div class="rd-section-head">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-clipboard-pulse"></i>
            <h6 class="mb-0">Observed Signs</h6>
          </div>
        </div>
        <div class="rd-section-body">
          <div id="reportSigns" class="signs-container"></div>
        </div>
      </div>

      <!-- ================= REMARKS / NOTES CARD ================= -->
      <div class="rd-card rd-section-card mt-3">
        <div class="rd-section-head">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-journal-text"></i>
            <h6 class="mb-0">Farmer Notes / Remarks</h6>
          </div>
          <div class="text-muted small">Submitted by farmer</div>
        </div>
        <div class="rd-section-body">
          <div id="reportNotes" class="rd-notes text-muted">
            <em>No notes provided.</em>
          </div>
        </div>
      </div>

      <!-- ================= EVIDENCE CARD ================= -->
      <div class="rd-card rd-section-card mt-3">
        <div class="rd-section-head">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-images"></i>
            <h6 class="mb-0">Evidence</h6>
          </div>
          <div class="text-muted small">Tap / click to view</div>
        </div>

        <div class="rd-section-body">
          <div class="media-wrapper">
            <div id="evidenceGallery" class="evidence-gallery"></div>
          </div>

          <div class="rd-note mt-3">
            <i class="bi bi-info-circle"></i>
            <span class="small">Images open in a new tab. Videos can be opened using the link.</span>
          </div>
        </div>
      </div>

    </div>

    <!-- FOOTER ACTIONS (existing IDs kept) -->
    <div class="modal-footer report-actions rd-footer">
      <div class="rd-actions-right">
        <button id="approveBtn" style="display:none;" class="rd-action rd-primary" type="button">
          <i class="bi bi-check-circle"></i> Approve
        </button>

        <button id="rejectBtn" style="display:none;" class="rd-action rd-danger" type="button">
          <i class="bi bi-x-circle"></i> Reject
        </button>

        <button id="confirmAIBtn" style="display:none;" class="rd-action rd-primary" type="button">
          <i class="bi bi-droplet-half"></i> Confirm AI
        </button>

        <button id="confirmPregnancyBtn" style="display:none;" class="rd-action rd-primary" type="button">
          <i class="bi bi-heart-pulse"></i> Confirm Pregnancy
        </button>

        <button id="followUpBtn" style="display:none;" class="rd-action rd-warn" type="button">
          <i class="bi bi-arrow-repeat"></i> Cycle Failed
        </button>

        <button id="confirmFarrowingBtn" style="display:none;" class="rd-action rd-primary" type="button">
          <i class="bi bi-egg-fried"></i> Confirm Farrowing
        </button>

        <button id="closeReportModalBtn" class="rd-action rd-secondary" type="button">
          Close
        </button>
      </div>
    </div>

  </div>
</div>

<!-- ================= EVIDENCE VIEWER MODAL (IMAGE/VIDEO) ================= -->
<div id="evidenceViewerModal" class="modal-overlay" style="display:none;">
  <div class="modal-panel modal-panel-lg ev-panel">

    <div class="modal-header ev-header">
      <div class="d-flex align-items-center gap-2 min-w-0">
        <span class="rd-head-icon">
          <i class="bi bi-aspect-ratio"></i>
        </span>
        <div class="min-w-0">
          <h5 class="mb-0 rd-title">Evidence Viewer</h5>
          <div class="rd-sub text-muted small">Zoom images or play videos.</div>
        </div>
      </div>

      <button id="closeEvidenceViewer" class="modal-close" type="button" aria-label="Close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div class="modal-body ev-body">
      <!-- IMAGE VIEW -->
      <div id="evImageWrap" style="display:none;">
        <div class="ev-toolbar">
          <button id="evZoomOut" type="button" class="ev-btn" aria-label="Zoom out">
            <i class="bi bi-dash-lg"></i>
          </button>
          <button id="evZoomIn" type="button" class="ev-btn" aria-label="Zoom in">
            <i class="bi bi-plus-lg"></i>
          </button>
          <button id="evZoomReset" type="button" class="ev-btn" aria-label="Reset zoom">
            <i class="bi bi-arrow-counterclockwise"></i>
          </button>
          <div class="ev-zoom-label ms-auto text-muted small">
            Zoom: <span id="evZoomLabel">100%</span>
          </div>
        </div>

        <div id="evStage" class="ev-stage" aria-label="Image zoom area">
          <img id="evImage" alt="Evidence image" draggable="false" />
        </div>

        <div class="text-muted small mt-2">
          Tip: Use mouse wheel / trackpad to zoom.
        </div>
      </div>

      <!-- VIDEO VIEW -->
      <div id="evVideoWrap" style="display:none;">
        <div class="ev-stage ev-stage-video">
          <video id="evVideo" controls preload="metadata" style="width:100%; height:100%;"></video>
        </div>
      </div>
    </div>

  </div>
</div>

<div id="aiConfirmModal" class="modal-overlay" style="display:none;">
  <div class="modal-panel" style="max-width:560px;">

    <div class="modal-header">
      <div class="d-flex align-items-center gap-2">
        <span class="rd-head-icon">
          <i class="bi bi-droplet-half"></i>
        </span>
        <div class="min-w-0">
          <h5 class="mb-0 rd-title">Confirm AI Service</h5>
          <div class="text-muted small">Select a sire (boar) and date to confirm AI.</div>
        </div>
      </div>

      <button type="button" class="modal-close" id="closeAIConfirmModal" aria-label="Close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div class="modal-body">
      <div class="mb-3">
        <label class="form-label fw-bold">Select Sire (Boar)</label>
        <select id="boarSelect" class="form-select"></select>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Insemination Date (Time Portal)</label>
        <input type="date" id="ai_date_input" class="form-control" />
        <div class="form-text small text-muted">Leave blank to use current date/time.</div>
      </div>

      <div class="d-flex gap-2 mt-4">
        <button id="submitAI" type="button" class="rd-action rd-primary">
          <i class="bi bi-check-circle"></i> Confirm AI
        </button>

        <button type="button" class="rd-action rd-secondary" id="cancelAIConfirmModal">
          Cancel
        </button>
      </div>
    </div>

  </div>
</div>

<!-- ================= FARROWING MODAL ================= -->
<div class="modal-overlay" id="farrowingModal" style="display:none;">
  <div class="modal-panel">

    <div class="modal-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-egg-fried"></i>
        <h5 class="modal-title">Register Farrowing Results</h5>
      </div>

      <button type="button" class="modal-close" id="closeFarrowingModal" aria-label="Close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <form id="farrowingForm">
      <div class="modal-body">

        <div class="farrow-grid">
          <div>
            <label class="form-label">Actual Farrowing Date</label>
            <input type="date" id="farrowingDateInput" class="form-control" required />
          </div>

          <div>
            <label class="form-label">Mortality</label>
            <input type="number" id="mortalityCount" class="form-control" min="0" value="0" required />
          </div>

          <div>
            <label class="form-label">Male Piglets (Live)</label>
            <input type="number" id="maleCount" class="form-control" min="0" value="0" required />
          </div>

          <div>
            <label class="form-label">Female Piglets (Live)</label>
            <input type="number" id="femaleCount" class="form-control" min="0" value="0" required />
          </div>
        </div>

        <!-- Hidden/derived: total live -->
        <input type="hidden" id="liveCount" value="0" />
        <div class="mt-2 text-muted small">
          Total live: <strong id="totalLiveLabel">0</strong>
        </div>

      </div>

      <div class="modal-footer">
        <button type="submit" class="rd-action rd-primary">
          <i class="bi bi-check-circle"></i> Confirm Farrowing
        </button>
        <button type="button" class="rd-action rd-secondary" id="cancelFarrowingBtn">
          Cancel
        </button>
      </div>
    </form>

  </div>
</div>

<!-- ================= REJECT MODAL (THEMED) ================= -->
<div id="rejectReasonModal" class="modal-overlay" style="display:none;">
  <div class="modal-panel" style="max-width:560px;">

    <div class="modal-header">
      <div class="d-flex align-items-center gap-2">
        <span class="rd-head-icon" style="background:#fff1f2;border-color:#fecdd3;color:#be123c;">
          <i class="bi bi-x-circle"></i>
        </span>
        <div class="min-w-0">
          <h5 class="mb-0 rd-title">Reject Report</h5>
          <div class="text-muted small">Please provide a reason for rejection.</div>
        </div>
      </div>

      <button type="button" class="modal-close" id="closeRejectModal" aria-label="Close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div class="modal-body">
      <label class="form-label fw-bold">Reason</label>
      <textarea
        id="rejectReasonInput"
        rows="4"
        class="form-control"
        placeholder="Enter rejection reason..."
        style="resize:none;"></textarea>

      <div class="d-flex gap-2 mt-3">
        <button id="confirmRejectBtn" type="button" class="rd-action rd-danger">
          <i class="bi bi-x-circle"></i> Reject
        </button>

        <button type="button" class="rd-action rd-secondary" id="cancelRejectModalBtn">
          Cancel
        </button>
      </div>
    </div>

  </div>
</div>

<!-- ================= TRACK PROGRESS PANEL ================= -->
<div id="trackProgressPanel" class="progress-panel">
  <div class="progress-panel-header">
    <div>
      <h4 class="panel-title">Progress Tracking</h4>
      <p id="progressFarmerName" class="panel-subtitle">Farmer: —</p>
    </div>
    <button id="closeProgressPanel" class="panel-close" type="button" aria-label="Close">&times;</button>
  </div>

  <div class="progress-panel-body">

    <div class="cycle-summary-card">
      <div class="cycle-summary-top">
        <div class="cycle-swine">
          <i class="bi bi-heart-fill text-success"></i>
          <strong id="progressSwineId">—</strong>
        </div>
        <span id="cycleStatus" class="cycle-status-badge">Active</span>
      </div>

      <div class="cycle-time-info">
        <div class="time-row">
          <span class="label">Current Stage</span>
          <strong id="currentStage">—</strong>
        </div>
        <div class="time-row highlight">
          <span class="label">Time Remaining</span>
          <strong id="remainingDays">—</strong>
        </div>
      </div>
    </div>

    <div class="cycle-timeline" id="cycleTimeline">
      <div class="timeline-empty text-muted">No cycle data available.</div>
    </div>

  </div>
</div>

<!-- ================= FEEDBACK MODAL (REPLACES alert()) ================= -->
<div id="appFeedbackModal" class="modal-overlay" style="display:none;">
  <div class="modal-panel" style="max-width:520px;">
    <div class="modal-header">
      <div class="d-flex align-items-center gap-2 min-w-0">
        <span class="rd-head-icon" id="appFeedbackIconWrap">
          <i class="bi bi-info-circle" id="appFeedbackIcon"></i>
        </span>
        <div class="min-w-0">
          <h5 class="mb-0 rd-title" id="appFeedbackTitle">Notice</h5>
          <div class="text-muted small" id="appFeedbackSub">—</div>
        </div>
      </div>

      <button type="button" class="modal-close" id="appFeedbackCloseX" aria-label="Close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div class="modal-body">
      <div id="appFeedbackBody" class="text-muted" style="font-weight:700;"></div>

      <div class="modal-footer" style="border-top:0; padding:14px 0 0;">
        <button id="appFeedbackOkBtn" type="button" class="rd-action rd-primary">
          <i class="bi bi-check2-circle"></i> OK
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ================= CONFIRM MODAL (REPLACES confirm()) ================= -->
<div id="appConfirmModal" class="modal-overlay" style="display:none;">
  <div class="modal-panel" style="max-width:520px;">
    <div class="modal-header">
      <div class="d-flex align-items-center gap-2 min-w-0">
        <span class="rd-head-icon" style="background:#fff7e0;border-color:#fde68a;color:#92400e;">
          <i class="bi bi-question-circle"></i>
        </span>
        <div class="min-w-0">
          <h5 class="mb-0 rd-title" id="appConfirmTitle">Confirm</h5>
          <div class="text-muted small" id="appConfirmSub">Please confirm to continue.</div>
        </div>
      </div>

      <button type="button" class="modal-close" id="appConfirmCloseX" aria-label="Close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div class="modal-body">
      <div id="appConfirmBody" class="text-muted" style="font-weight:700;"></div>

      <div class="d-flex gap-2 mt-3 justify-content-end flex-wrap">
        <button id="appConfirmCancelBtn" type="button" class="rd-action rd-secondary">
          Cancel
        </button>
        <button id="appConfirmOkBtn" type="button" class="rd-action rd-primary">
          <i class="bi bi-check-circle"></i> Confirm
        </button>
      </div>
    </div>
  </div>
</div>