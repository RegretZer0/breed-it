<!-- ================= HEAT REPORTS (CARD VIEW) ================= -->
<div class="card page-card reports-card mt-4">
  <div class="card-body">

    <!-- ================= TITLE + ACTIONS ================= -->
    <div class="d-flex align-items-start justify-content-between gap-2 mb-2 flex-wrap">
      <div class="min-w-0">
        <h4 class="page-title mb-1">Farmer Reports</h4>
        <div class="text-muted small">Filter and review submitted reports.</div>
      </div>

      <div class="d-flex align-items-center gap-2 flex-wrap">

        <!-- Re-Heat Monitoring -->
        <button
          type="button"
          id="reheatBtn"
          class="btn btn-outline-success btn-sm"
        >
          <i class="bi bi-arrow-repeat me-1"></i>
          Re-Heat Monitor
        </button>

        <!-- Archive -->
        <button
          type="button"
          id="archiveBtn"
          class="btn btn-outline-secondary btn-sm heat-archive-btn"
        >
          <i class="bi bi-archive me-1"></i>
          Archive
        </button>

</div>
    </div>

    <!-- ================= FILTER TOOLBAR ================= -->
    <div class="mb-3">
      <%- include("./filter") %>
    </div>

    <!-- ================= REPORT CARD LIST ================= -->
    <div id="reportsCardList" class="reports-card-list" aria-live="polite">
      <div class="text-muted">Loading reports...</div>
    </div>

    <!-- ================= PAGINATION ================= -->
    <div class="d-flex justify-content-between align-items-center mt-3" style="gap:12px;">
      <button id="prevPageBtn" class="btn-nav secondary" type="button">Prev</button>

      <span id="pageIndicator" class="fw-semibold" style="font-size:14px;">
        Page 1 of 1
      </span>

      <button id="nextPageBtn" class="btn-nav secondary" type="button">Next</button>
    </div>

  </div>
</div>

<!-- ARCHIVE MODAL (Completed + Rejected only) -->
<div id="archiveModal" class="modal-overlay" style="display:none;">
  <div class="modal-panel" style="max-width: 860px;">

    <div class="modal-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-archive"></i>
        <h5 class="mb-0">Archive</h5>
      </div>
      <button
        id="closeArchiveModal"
        class="modal-close"
        type="button"
        aria-label="Close"
      >
        &times;
      </button>
    </div>

    <div class="modal-body">

      <!-- Top line + actions (ARCHIVE MODAL) -->
      <div class="archive-topbar">
        <div class="archive-toptext text-muted small">
          Showing <b>Completed</b> and <b>Rejected</b> reports.
        </div>

        <div class="archive-top-actions">
          <button
            type="button"
            id="showArchivedBtn"
            class="btn btn-success btn-sm"
          >
            <i class="bi bi-eye me-1"></i> Show archived
          </button>

          <button
            type="button"
            id="backToActiveBtn"
            class="btn btn-outline-secondary btn-sm"
          >
            Back to active
          </button>
        </div>
      </div>

      <!-- ARCHIVE FILTER BAR (PLACE HERE) -->
      <form id="archiveFilterForm" class="archive-filterbar" novalidate>
        <div class="archive-filterrow">

          <!-- Status -->
          <div class="archive-filteritem">
            <label class="form-label mb-1">Report Status</label>
            <select id="archiveStatusFilter" class="form-select">
              <option value="">All (Completed + Rejected)</option>
              <option value="completed">Completed</option>
              <option value="rejected">Rejected</option>
            </select>
          </div>

          <!-- Farmer Search -->
          <div class="archive-filteritem">
            <label class="form-label mb-1">Farmer</label>
            <input
              id="archiveFarmerSearch"
              type="text"
              class="form-control"
              placeholder="Search farmer name"
            />
          </div>

          <!-- Search Tag / Signs -->
          <div class="archive-filteritem">
            <label class="form-label mb-1">Search tag</label>
            <input
              id="archiveTagSearch"
              type="text"
              class="form-control"
              placeholder="e.g. Reddened Vulva"
            />
          </div>

          <!-- Date From -->
          <div class="archive-filteritem">
            <label class="form-label mb-1">Date from</label>
            <input id="archiveDateFrom" type="date" class="form-control" />
          </div>

          <!-- Date To -->
          <div class="archive-filteritem">
            <label class="form-label mb-1">Date to</label>
            <input id="archiveDateTo" type="date" class="form-control" />
          </div>

          <!-- Actions -->
          <div class="archive-filteractions">
            <button id="archiveApplyBtn" type="submit" class="btn btn-success">
              <i class="bi bi-funnel me-1"></i> Apply
            </button>
            <button id="archiveResetBtn" type="button" class="btn btn-outline-secondary">
              Reset
            </button>
          </div>

        </div>
      </form>

      <!-- ARCHIVE LIST (JS renders here) -->
      <div id="archiveCardList" class="reports-card-list">
        <div class="text-muted">Loading archived...</div>
      </div>

      <!-- ARCHIVE PAGINATION (limit = 5 in JS) -->
      <div class="archive-pager">
        <button id="archivePrevBtn" type="button" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-chevron-left me-1"></i> Prev
        </button>

        <div id="archivePageIndicator" class="archive-pageinfo">Page 1 of 1</div>

        <button id="archiveNextBtn" type="button" class="btn btn-outline-secondary btn-sm">
          Next <i class="bi bi-chevron-right ms-1"></i>
        </button>
      </div>

    </div>

    <div class="modal-footer">
      <button id="closeArchiveModalBtn" type="button" class="btn btn-outline-secondary btn-sm">
        Close
      </button>
    </div>

  </div>
</div>

<!-- ================= RE-HEAT MONITOR MODAL ================= -->
<div id="reheatModal" class="modal-overlay" style="display:none;">
  <div class="modal-panel" style="max-width: 860px;">

    <!-- HEADER -->
    <div class="modal-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-arrow-repeat text-success"></i>
        <h5 class="mb-0">Re-Heat Monitoring</h5>
      </div>

      <button
        id="closeReheatModal"
        class="modal-close"
        type="button"
        aria-label="Close"
      >
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <!-- BODY -->
    <div class="modal-body">

      <!-- Description -->
      <div class="text-muted small mb-3">
        Active sows that returned to heat and require monitoring.
      </div>

      <!-- REHEAT FILTER BAR -->
      <div class="reheat-filterbar mb-3">
        <div class="reheat-filter-inner">

          <input 
            type="text" 
            id="reheatSearch" 
            class="form-control form-control-sm"
            placeholder="Search Swine ID..."
          />

          <input 
            type="text" 
            id="reheatFarmerSearch" 
            class="form-control form-control-sm"
            placeholder="Search Farmer..."
          />

          <button
            type="button"
            id="reheatResetBtn"
            class="btn btn-outline-secondary btn-sm"
          >
            Reset
          </button>

        </div>
      </div>

      <!-- LIST -->
      <div id="reheatList" class="reports-card-list">
        <div class="text-muted">No re-heat records yet.</div>
      </div>

      <!-- PAGINATION -->
      <div class="d-flex justify-content-between align-items-center mt-3" style="gap:12px;">
        <button id="reheatPrevBtn" class="btn-nav secondary" type="button">Prev</button>

        <span id="reheatPageIndicator" class="fw-semibold" style="font-size:14px;">
          Page 1 of 1
        </span>

        <button id="reheatNextBtn" class="btn-nav secondary" type="button">Next</button>
      </div>

    </div>

  </div>
</div>