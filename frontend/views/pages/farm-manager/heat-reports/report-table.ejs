<!-- ================= HEAT REPORTS (CARD VIEW) ================= -->
<div class="card page-card reports-card mt-4">
  <div class="card-body">

    <!-- ================= TITLE ================= -->
    <h4 class="page-title mb-3">
      Heat Reports
    </h4>

    <!-- ================= FILTER TOOLBAR ================= -->
    <div class="mb-4">
      <%- include("./filter") %>
    </div>

    <!-- ================= REPORT CARD LIST ================= -->
    <div
      id="reportsCardList"
      class="reports-card-list"
      aria-live="polite"
    >
      <div class="text-muted">Loading reports...</div>
    </div>

    <!-- ================= PAGINATION ================= -->
    <div
      class="d-flex justify-content-between align-items-center mt-4"
      style="gap:12px;"
    >
      <button
        id="prevPageBtn"
        class="btn-nav secondary"
        type="button"
      >
        Prev
      </button>

      <span
        id="pageIndicator"
        class="fw-semibold"
        style="font-size:14px;"
      >
        Page 1 of 1
      </span>

      <button
        id="nextPageBtn"
        class="btn-nav secondary"
        type="button"
      >
        Next
      </button>
    </div>

  </div>
</div>
