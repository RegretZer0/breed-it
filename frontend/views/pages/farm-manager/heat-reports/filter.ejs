<div class="heat-toolbar theme-toolbar">

  <!-- LEFT: TABS -->
  <div class="heat-tabs" role="tablist" aria-label="Cycle status filters">
    <button type="button" class="heat-tab active" data-status="">All</button>
    <button type="button" class="heat-tab" data-status="pending">In-Heat</button>
    <button type="button" class="heat-tab" data-status="under_observation">Observation</button>
    <button type="button" class="heat-tab" data-status="pregnant">Pregnant</button>
    <button type="button" class="heat-tab" data-status="farrowing_ready">Farrowing</button>
    <button type="button" class="heat-tab" data-status="lactating">Lactating</button>
  </div>

  <!-- RIGHT: FILTERS -->
  <form id="heatFilterForm" class="heat-filter-form" autocomplete="off">

    <!-- Farmer dropdown -->
    <div class="dropdown heat-filter-item">
      <button
        class="form-select form-select-sm text-start"
        type="button"
        id="farmerDropdownBtn"
        data-bs-toggle="dropdown"
      >
        Farmer
      </button>

      <div class="dropdown-menu p-2 heat-dropdown-menu">
        <input id="farmerSearch" class="form-control form-control-sm mb-2" placeholder="Search farmer…">
        <div id="farmerOptions">
          <div class="text-muted small px-2">Loading farmers…</div>
        </div>
      </div>
    </div>

    <!-- Report status -->
    <div class="heat-filter-item">
      <select id="reportStatusFilter" class="form-select form-select-sm">
        <option value="">Report Status (All)</option>
        <option value="pending">Pending</option>
        <option value="approved">Approved</option>
        <option value="rejected">Rejected</option>
        <option value="completed">Completed</option>
        <option value="ai_confirmed">AI Confirmed</option>
        <option value="waiting_heat_check">Waiting Heat Check</option>
      </select>
    </div>

    <!-- Search -->
    <div class="heat-filter-item heat-search-wrap">
      <input id="filterSwine" class="form-control form-control-sm" placeholder="Search tag">
    </div>

    <!-- Actions -->
    <div class="heat-filter-actions">
      <button type="submit" class="btn btn-success btn-sm heat-apply-btn">
        <i class="bi bi-funnel-fill me-1"></i> Apply
      </button>
      <button type="button" id="clearFilter" class="btn btn-outline-secondary btn-sm heat-reset-btn">
        Reset
      </button>
    </div>

  </form>
</div>