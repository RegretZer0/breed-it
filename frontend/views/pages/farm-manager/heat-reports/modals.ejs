<!-- ================= REPORT DETAILS MODAL ================= -->
<div id="reportDetailsModal" class="modal-overlay">
  <div class="modal-panel">

    <div class="modal-header">
      <h5>Report Details</h5>
      <button id="closeReportModal" class="modal-close">&times;</button>
    </div>

    <div class="modal-body">
      <!-- BASIC INFO -->
      <div class="detail-grid">
        <div class="report-summary">
          <div class="report-row">
            <p id="reportSwine"></p>
            <span id="reportStatus" class="report-status"></span>
          </div>

          <p id="reportFarmer"></p>
          <p id="reportProbability"></p>

          <div class="report-signs">
            <h6>Observed Signs</h6>
            <div id="reportSigns" class="signs-container"></div>
          </div>
        </div>
      </div>

      <!-- MEDIA -->
      <div class="media-wrapper">
        <div id="evidenceGallery" class="evidence-gallery"></div>
      </div>

      <!-- ACTIONS -->
      <div class="modal-footer report-actions">
        <button id="approveBtn" style="display:none;">
          <i class="bi bi-check-circle"></i> Approve
        </button>

        <button id="rejectBtn" style="display:none;">
          <i class="bi bi-x-circle"></i> Reject
        </button>

        <button id="confirmAIBtn" style="display:none;">
          <i class="bi bi-droplet-half"></i> Confirm AI
        </button>

        <button id="confirmPregnancyBtn" style="display:none;">
          <i class="bi bi-heart-pulse"></i> Confirm Pregnancy
        </button>

        <button id="followUpBtn" style="display:none;">
          <i class="bi bi-arrow-repeat"></i> Cycle Failed
        </button>

        <button id="confirmFarrowingBtn" style="display:none;">
          <i class="bi bi-egg-fried"></i> Confirm Farrowing
        </button>

        <button id="closeReportModalBtn" class="secondary">
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ================= AI CONFIRM MODAL ================= -->
<div id="aiConfirmModal" class="modal">
  <div class="modal-content">
    <h3>
      <i class="bi bi-droplet-half"></i> Confirm AI Service
    </h3>

    <label>Select Sire (Boar)</label>
    <select id="boarSelect"></select>

    <div style="display:flex; gap:10px; margin-top:15px;">
      <button id="submitAI" class="btn-nav">
        <i class="bi bi-check-circle"></i> Confirm AI
      </button>

      <button
        type="button"
        class="btn-nav secondary"
        onclick="document.getElementById('aiConfirmModal').style.display='none'">
        Cancel
      </button>
    </div>
  </div>
</div>

<!-- ================= FARROWING MODAL ================= -->
<div id="farrowingModal" class="modal">
  <div class="modal-content">
    <h3>
      <i class="bi bi-egg-fried"></i> Register Farrowing Results
    </h3>

    <form id="farrowingForm">
      <label>Actual Farrowing Date</label>
      <input type="date" id="farrowingDateInput" required>

      <div class="count-grid">
        <div>
          <label>Live</label>
          <input type="number" id="liveCount" min="0" value="0">
        </div>
        <div>
          <label>Mortality</label>
          <input type="number" id="mortalityCount" min="0" value="0">
        </div>
      </div>

      <div style="display:flex; gap:10px; margin-top:15px;">
        <button type="submit" class="btn-nav">
          <i class="bi bi-check-circle"></i> Confirm Farrowing
        </button>

        <button
          type="button"
          class="btn-nav secondary"
          onclick="document.getElementById('farrowingModal').style.display='none'">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ================= REJECT MODAL ================= -->
<div id="rejectReasonModal" class="modal">
  <div class="modal-content">
    <h3>Reject Report</h3>

    <p class="text-muted">
      Please provide a reason for rejecting this report.
    </p>

    <textarea
      id="rejectReasonInput"
      rows="4"
      placeholder="Enter rejection reason..."
      style="resize:none;">
    </textarea>

    <div style="display:flex; gap:10px; margin-top:14px;">
      <button id="confirmRejectBtn" class="btn-nav">
        <i class="bi bi-x-circle"></i> Reject
      </button>

      <button
        type="button"
        class="btn-nav secondary"
        onclick="document.getElementById('rejectReasonModal').style.display='none'">
        Cancel
      </button>
    </div>
  </div>
</div>

<!-- ================= TRACK PROGRESS PANEL ================= -->
<div id="trackProgressPanel" class="progress-panel">

  <!-- HEADER -->
  <div class="progress-panel-header">
    <div>
      <h4 class="panel-title">Progress Tracking</h4>
      <p id="progressFarmerName" class="panel-subtitle">
        Farmer: —
      </p>
    </div>

    <button id="closeProgressPanel" class="panel-close">&times;</button>
  </div>

  <!-- BODY -->
  <div class="progress-panel-body">

    <!-- SUMMARY CARD -->
    <div class="cycle-summary-card">
      <div class="cycle-summary-top">
        <div class="cycle-swine">
          <i class="bi bi-heart-fill text-success"></i>
          <strong id="progressSwineId">—</strong>
        </div>

        <span id="cycleStatus" class="cycle-status-badge">
          Active
        </span>
      </div>

      <!-- TIME-BASED INFO -->
      <div class="cycle-time-info">
        <div class="time-row">
          <span class="label">Current Stage</span>
          <strong id="currentStage">—</strong>
        </div>

        <div class="time-row highlight">
          <span class="label">Time Remaining</span>
          <strong id="remainingDays">—</strong>
        </div>
      </div>
    </div>

    <!-- TIMELINE -->
    <div class="cycle-timeline" id="cycleTimeline">
      <div class="timeline-empty text-muted">
        No cycle data available.
      </div>
    </div>

  </div>
</div>
