<%- include("../../../partials/farm-manager/header") %>
<%- include("../../../partials/farm-manager/navbar") %>

<div class="app-shell">
  <%- include("../../../partials/farm-manager/sidepanel") %>

  <div class="main-content settings-theme">

    <main class="settings-container">

      <!-- OUTER SHELL (MATCH DASHBOARD STYLE) -->
      <div class="settings-shell">

        <!-- HEADER -->
        <div class="settings-header-card">
          <div>
            <h4><i class="bi bi-gear-fill"></i> System Settings</h4>
            <small>Manage estrus heat signs used for detection and scoring</small>
          </div>

          <button class="btn-add" id="addHeatSignBtn">
            <i class="bi bi-plus-circle"></i>
            Add Heat Sign
          </button>
        </div>

        <!-- GRID -->
        <div class="settings-grid">

          <!-- LEFT -->
          <div class="settings-main">

            <div class="settings-card main-card">

              <!-- TITLE -->
              <div class="settings-title">
                <h6>Estrus Heat Signs</h6>
                <span>Configured detection indicators</span>
              </div>

              <!-- TABS -->
              <div class="heat-tabs">
                <button class="heat-tab active" id="tabActive">
                  Active (<span id="activeCount">0</span>)
                </button>

                <button class="heat-tab" id="tabInactive">
                  Inactive (<span id="inactiveCount">0</span>)
                </button>
              </div>

              <!-- CONTENT -->
              <div class="heat-table-wrap">
                <div id="heatSignsTable" class="heat-grid"></div>
              </div>

              <!-- PAGINATION -->
              <div class="pagination-bar">
                <button id="prevPageBtn"><i class="bi bi-chevron-left"></i></button>
                <span id="pageInfo"></span>
                <button id="nextPageBtn"><i class="bi bi-chevron-right"></i></button>
              </div>

            </div>

          </div>

          <!-- RIGHT -->
          <div class="settings-card side-card">
            <div id="weightTotalDisplay" class="weight-total-display">
              Total Active Weight: <strong id="totalWeightValue">0%</strong>
            </div>

            <h6>Quick Info</h6>

            <ul class="info-list">
              <li>
                <i class="bi bi-info-circle"></i>
                Heat signs help determine estrus readiness
              </li>

              <li>
                <i class="bi bi-lightning-charge"></i>
                Critical signs carry higher weight
              </li>

              <li>
                <i class="bi bi-toggle-on"></i>
                Only active signs affect scoring
              </li>
            </ul>
          </div>

        </div>

      </div>

    </main>

  </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="heatSignModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content modern-modal">

      <!-- HEADER -->
      <div class="modal-header border-0">
        <h5 id="modalTitle">Add Heat Sign</h5>
        <button class="btn-close" id="closeModalX"></button>
      </div>

      <!-- BODY -->
      <div class="modal-body modern-modal-body">

        <div class="form-row">
          <label>Sign Name</label>
          <input id="signName" class="modern-input" placeholder="Enter sign name">
        </div>

        <div class="form-row-inline">
          <div>
            <label>Weight</label>
            <input id="signWeight" type="number" class="modern-input" placeholder="e.g. 10">
          </div>
        </div>

      </div>

      <!-- FOOTER -->
      <div class="modal-footer modern-footer border-0">
        <button id="closeModalBtn" class="btn-cancel">Cancel</button>
        <button id="saveHeatSignBtn" class="btn-save">Save</button>
      </div>

    </div>
  </div>
</div>

<%- include("../../../partials/farm-manager/footer") %>