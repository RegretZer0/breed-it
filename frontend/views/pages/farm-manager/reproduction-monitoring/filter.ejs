<div class="heat-toolbar w-100">
  <form id="filtersForm" class="farmer-filter-form row g-2 align-items-end">

    <!-- Farmer Dropdown -->
    <div class="col-12 col-md-4 col-lg-auto">
      <label class="form-label small text-muted mb-1">Farmer</label>
      <div class="dropdown location-select w-100">
        <button
          class="form-select form-select-sm text-start"
          type="button"
          id="locationDropdownBtn"
          data-bs-toggle="dropdown">
          Farmer
        </button>

        <div class="dropdown-menu p-2 w-100"
             style="max-height:260px;overflow-y:auto;min-width:220px">

          <input
            id="locationSearch"
            class="form-control form-control-sm mb-2"
            placeholder="Search farmer…">

          <div id="locationOptions">
            <div class="text-muted small">
              Loading farmers…
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Search -->
    <div class="col-12 col-md-4 col-lg-4">
      <label class="form-label small text-muted mb-1">Search</label>
      <input
        id="searchFarmer"
        class="form-control form-control-sm"
        placeholder="Search location…">
    </div>

    <!-- Status -->
    <div class="col-12 col-md-4 col-lg-auto">
      <label class="form-label small text-muted mb-1">Status</label>
      <select id="filterStatus" class="form-select form-select-sm">
        <option value="">Status</option>
        <option value="Active">Active</option>
        <option value="Inactive">Inactive</option>
      </select>
    </div>

    <!-- Buttons -->
    <div class="col-12 col-lg-auto">
      <div class="d-grid d-sm-flex gap-2">
        <button type="submit" class="btn btn-success btn-sm">
          Apply
        </button>

        <button type="button" id="resetFilters" class="btn btn-outline-secondary btn-sm">
          Reset
        </button>
      </div>
    </div>

  </form>
</div>