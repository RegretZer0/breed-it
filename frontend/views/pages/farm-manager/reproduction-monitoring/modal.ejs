<!-- modal.ejs (UPDATED to match the new middle-panel-first layout)
     ✅ Keeps ALL existing IDs that your JS already uses:
     - farmerModal, profileAvatar, profileFarmerName, profileFarmerContact, profileFarmerStatus
     - statTotalPigs, statPiglets, statAdultSows, statAdultBoars, statPregnant, statMortality
     - farmerProfileTabs, farmerOverviewTab, farmerPigsTab, breedingPerformanceTab
     - farmerPigCategoryTabs, pigFilterSection, farmerPigFilters, pigSearchTag, pigStatusFilter, resetPigFilters
     - linkedPigList, pigAnalysisPanel, backToPigList, analysisPigTitle, analysisPigMeta, pigAnalysisTabs, pig*Tab
     - breedingKpiSection, breedingSowList, breedingCyclePanel
-->

<div class="modal fade" id="farmerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content profile-modal border-0">

      <!-- HEADER -->
      <div class="modal-header border-0 pb-0">
        <div class="d-flex align-items-center gap-2 min-w-0">
          <i class="bi bi-person-badge text-success fs-5"></i>
          <div class="min-w-0">
            <h5 class="modal-title fw-black mb-0 text-truncate">Farmer Profile</h5>
            <div class="small text-muted text-truncate" id="profileFarmerContact">—</div>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <span id="profileFarmerStatus" class="badge profile-status-badge">—</span>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>

      <!-- BODY -->
      <div class="modal-body pt-3">

        <!-- PROFILE HEADER CARD -->
        <div class="card border-0 shadow-sm mb-3 profile-header-modern">
          <div class="card-body p-3 p-md-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

              <!-- Left: Avatar + name -->
              <div class="d-flex align-items-center gap-3 min-w-0">
                <div class="profile-avatar-lg">
                  <img
                    id="profileAvatar"
                    src="/images/default-avatar.png"
                    alt="Profile"
                    loading="lazy"
                    referrerpolicy="no-referrer"
                  >
                </div>

                <div class="min-w-0">
                  <h4 id="profileFarmerName" class="mb-1 fw-black text-truncate">—</h4>
                  <!-- NOTE: contact is already shown under title; keep ID only once -->
                  <div class="text-muted small text-truncate" id="profileFarmerContact" style="display:none">—</div>
                </div>
              </div>

              <!-- Right: quick actions (optional; safe) -->
              <div class="text-md-end">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill fw-black" data-bs-dismiss="modal">
                  <i class="bi bi-x-lg me-1"></i> Close
                </button>
              </div>

            </div>

            <!-- STATS GRID -->
            <div class="row g-2 g-md-3 mt-3">

              <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-tile">
                  <div class="stat-number" id="statTotalPigs">0</div>
                  <div class="stat-label"><i class="bi bi-grid-3x3-gap"></i> Total Pigs</div>
                </div>
              </div>

              <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-tile">
                  <div class="stat-number" id="statPiglets">0</div>
                  <div class="stat-label"><i class="bi bi-collection"></i> Piglets</div>
                </div>
              </div>

              <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-tile">
                  <div class="stat-number" id="statAdultSows">0</div>
                  <div class="stat-label"><i class="bi bi-gender-female"></i> Adult Sows</div>
                </div>
              </div>

              <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-tile">
                  <div class="stat-number" id="statAdultBoars">0</div>
                  <div class="stat-label"><i class="bi bi-gender-male"></i> Adult Boars</div>
                </div>
              </div>

              <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-tile">
                  <div class="stat-number" id="statPregnant">0</div>
                  <div class="stat-label"><i class="bi bi-patch-check"></i> Pregnant</div>
                </div>
              </div>

              <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-tile">
                  <div class="stat-number" id="statMortality">0.0%</div>
                  <div class="stat-label"><i class="bi bi-activity"></i> Mortality</div>
                </div>
              </div>

            </div>

          </div>
        </div>

        <!-- TOP TABS (Scrollable on mobile) -->
        <div class="tabs-scroll mb-3">
          <ul class="nav nav-pills profile-tabs flex-nowrap" id="farmerProfileTabs" role="tablist" aria-label="Farmer profile tabs">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" data-target="farmerOverviewTab" type="button" role="tab" aria-controls="farmerOverviewTab" aria-selected="true">
                <i class="bi bi-layout-text-sidebar-reverse me-1"></i> Overview
              </button>
            </li>

            <li class="nav-item" role="presentation">
              <button class="nav-link" data-target="farmerPigsTab" type="button" role="tab" aria-controls="farmerPigsTab" aria-selected="false">
                <i class="bi bi-grid me-1"></i> Pigs
              </button>
            </li>

            <li class="nav-item" role="presentation">
              <button class="nav-link" data-target="breedingPerformanceTab" type="button" role="tab" aria-controls="breedingPerformanceTab" aria-selected="false">
                <i class="bi bi-graph-up-arrow me-1"></i> Breeding Performance
              </button>
            </li>
          </ul>
        </div>

        <!-- ================= OVERVIEW TAB ================= -->
        <div id="farmerOverviewTab" class="farmer-tab" role="tabpanel">

          <div class="row g-3">
            <div class="col-12 col-lg-6">
              <div class="profile-card">
                <h6 class="profile-card-title">
                  <i class="bi bi-person-lines-fill me-2 text-success"></i>
                  Farmer Information
                </h6>

                <!-- ✅ IDs used by JS -->
                <div class="profile-row">
                  <span>Farmer ID</span>
                  <span id="profileFarmerIdOverview">—</span>
                </div>

                <div class="profile-row">
                  <span>Pen Count</span>
                  <span id="profilePenCountOverview">—</span>
                </div>

                <div class="profile-row">
                  <span>Pen Capacity</span>
                  <span id="profilePenCapacityOverview">—</span>
                </div>

                <!-- Legacy IDs (keep for compatibility if you still set them elsewhere) -->
                <div class="visually-hidden" aria-hidden="true">
                  <div id="profileFarmerId">—</div>
                  <div id="profilePenCount">—</div>
                  <div id="profilePenCapacity">—</div>
                </div>
              </div>
            </div>

            <div class="col-12 col-lg-6">
              <div class="profile-card">
                <h6 class="profile-card-title">
                  <i class="bi bi-telephone me-2 text-success"></i>
                  Contact Details
                </h6>

                <div class="profile-row">
                  <span>Phone</span>
                  <span id="profilePhone">—</span>
                </div>

                <div class="profile-row">
                  <span>Email</span>
                  <span id="profileEmail">—</span>
                </div>

                <div class="profile-row">
                  <span>Address</span>
                  <span id="profileAddress">—</span>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- ================= PIGS TAB ================= -->
        <div id="farmerPigsTab" class="farmer-tab d-none" role="tabpanel">

          <!-- Category tabs (scrollable on mobile) -->
          <div class="tabs-scroll mb-3">
            <ul class="nav nav-pills flex-nowrap" id="farmerPigCategoryTabs" role="tablist" aria-label="Pig category tabs">
              <li class="nav-item" role="presentation"><button class="nav-link active" data-type="all" type="button">All</button></li>
              <li class="nav-item" role="presentation"><button class="nav-link" data-type="piglet" type="button">Piglets</button></li>
              <li class="nav-item" role="presentation"><button class="nav-link" data-type="sow" type="button">Sows</button></li>
              <li class="nav-item" role="presentation"><button class="nav-link" data-type="boar" type="button">Boars</button></li>
            </ul>
          </div>

          <!-- Filters: responsive -->
          <div id="pigFilterSection">
            <form id="farmerPigFilters" class="row g-2 align-items-end mb-3" autocomplete="off">
              <div class="col-12 col-md-6 col-lg-5">
                <label class="form-label small text-muted mb-1" for="pigSearchTag">Search Tag</label>
                <input type="text" id="pigSearchTag" class="form-control form-control-sm" placeholder="Search tag">
              </div>

              <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label small text-muted mb-1" for="pigStatusFilter">Status</label>
                <select id="pigStatusFilter" class="form-select form-select-sm">
                  <option value="">Status</option>
                  <option value="Healthy">Healthy</option>
                  <option value="Sick">Sick</option>
                  <option value="Deceased">Deceased</option>
                </select>
              </div>

              <div class="col-12 col-lg-4">
                <div class="d-grid d-sm-flex gap-2">
                  <button class="btn btn-success btn-sm" type="submit">Apply</button>
                  <button class="btn btn-outline-secondary btn-sm" type="button" id="resetPigFilters">Reset</button>
                </div>
              </div>
            </form>
          </div>

          <!-- Pig list -->
          <div id="linkedPigList" class="d-flex flex-column gap-3">
            <div class="text-muted text-center py-3">
              Select a farmer to view pigs
            </div>
          </div>

          <!-- Pig analysis panel (unchanged IDs) -->
          <div id="pigAnalysisPanel" class="d-none">

            <button
              type="button"
              class="btn btn-sm btn-outline-secondary mb-3 d-inline-flex align-items-center gap-2"
              id="backToPigList">
              <i class="bi bi-arrow-left"></i>
              <span>Back to Pig List</span>
            </button>

            <div class="card border-0 shadow-sm mb-3">
              <div class="card-body">
                <h5 id="analysisPigTitle" class="mb-1 fw-black">Pig Analysis</h5>
                <div class="text-muted small" id="analysisPigMeta">—</div>
              </div>
            </div>

            <div class="tabs-scroll mb-3">
              <ul class="nav nav-pills flex-nowrap" id="pigAnalysisTabs" role="tablist" aria-label="Pig analysis tabs">
                <li class="nav-item"><button class="nav-link active" data-target="pigProfileTab" type="button">Profile</button></li>
                <li class="nav-item"><button class="nav-link" data-target="pigBreedingTab" type="button">Artificial Insemination Record</button></li>
                <li class="nav-item"><button class="nav-link" data-target="pigPerformanceTab" type="button">Piglets Growth Records</button></li>
                <li class="nav-item"><button class="nav-link" data-target="pigHealthTab" type="button">Health &amp; Defects</button></li>
                <li class="nav-item"><button class="nav-link" data-target="pigSelectionTab" type="button">Selection Status</button></li>
              </ul>
            </div>

            <div id="pigProfileTab" class="pig-analysis-tab"></div>
            <div id="pigBreedingTab" class="pig-analysis-tab d-none"></div>
            <div id="pigPerformanceTab" class="pig-analysis-tab d-none"></div>
            <div id="pigHealthTab" class="pig-analysis-tab d-none"></div>
            <div id="pigSelectionTab" class="pig-analysis-tab d-none"></div>

          </div>

        </div>

        <!-- ================= BREEDING PERFORMANCE TAB ================= -->
        <div id="breedingPerformanceTab" class="farmer-tab d-none" role="tabpanel">

          <div id="breedingKpiSection" class="row g-2 g-md-3 mb-3"></div>

          <!-- LIST (SOWS) -->
          <div id="breedingSowList" class="d-flex flex-column gap-3"></div>

          <!-- DETAIL PANEL (SOW -> CYCLES + CYCLE DETAIL injected here by JS) -->
          <!-- ✅ Keep as single host panel -->
          <div id="breedingCyclePanel" class="mt-3 d-none"></div>

        </div>

      </div>
    </div>
  </div>
</div>