<div class="modal" id="swineModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">

      <!-- ================= MODAL HEADER ================= -->
      <div class="modal-header">
        <h5 class="modal-title" id="modalSwineId">Swine Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <!-- ================= PIG PROFILE HEADER ================= -->
        <div class="pig-profile-header mb-4">
          <div class="profile-main">
            <div class="d-flex align-items-center gap-3">
              <div class="pig-avatar">
                <i class="fa-solid fa-piggy-bank"></i>
              </div>
              <div>
                <h5 class="mb-1" id="profileSwineId">—</h5>
                <div class="small text-muted" id="profileBreedType">—</div>
                <div class="small text-muted" id="profileFarmer">—</div>
              </div>
            </div>

            <span id="profileHealthBadge" class="badge rounded-pill px-3 py-1">—</span>
          </div>

          <div class="profile-stats-row mt-3">
            <div class="stat">
              <div class="label"><i class="fa-solid fa-calendar-days me-1"></i> Age</div>
              <div class="value" id="profileAge">—</div>
            </div>
            <div class="stat">
              <div class="label"><i class="fa-solid fa-weight-scale me-1"></i> Weight</div>
              <div class="value" id="profileWeight">—</div>
            </div>
            <div class="stat">
              <div class="label"><i class="fa-solid fa-layer-group me-1"></i> Stage</div>
              <div class="value" id="profileStage">—</div>
            </div>
            <div class="stat">
              <div class="label"><i class="fa-solid fa-venus-mars me-1"></i> Sex</div>
              <div class="value" id="profileSex">—</div>
            </div>
          </div>
        </div>

        <!-- ================= PROFILE TABS ================= -->
        <ul class="nav nav-pills mb-3 gap-2" id="pigProfileTabs">
          <li class="nav-item">
            <button class="nav-link active" data-target="profileTab" type="button">Overview</button>
          </li>

          <li class="nav-item d-none" id="reproNav">
            <button class="nav-link" data-target="reproductionTab" type="button">Reproduction</button>
          </li>

          <li class="nav-item d-none" id="offspringNav">
            <button class="nav-link" data-target="offspringTab" type="button">Offspring</button>
          </li>

          <li class="nav-item">
            <button class="nav-link" data-target="performanceTab" type="button">Growth</button>
          </li>
        </ul>

        <!-- ================= OVERVIEW TAB ================= -->
        <div id="profileTab" class="profile-tab">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                  <h6 class="mb-3">Current Condition</h6>
                  <div class="d-flex justify-content-between"><span>Status</span><span id="profileStatus">—</span></div>
                  <div class="d-flex justify-content-between"><span>Stage</span><span id="profileStageDisplay">—</span></div>
                  <div class="d-flex justify-content-between"><span>Age</span><span id="profileAgeDisplay">—</span></div>
                  <div class="d-flex justify-content-between"><span>Sex</span><span id="profileSexDisplay">—</span></div>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                  <h6 class="mb-3">Latest Measurements</h6>
                  <div class="d-flex justify-content-between"><span>Weight</span><span id="profileWeightDisplay">—</span></div>
                  <div class="d-flex justify-content-between"><span>Body Length</span><span id="profileLengthDisplay">—</span></div>
                  <div class="d-flex justify-content-between"><span>Heart Girth</span><span id="profileGirthDisplay">—</span></div>
                  <div class="small text-muted mt-2">Last updated: <span id="profileLastUpdate">—</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>

      <!-- ================= REPRODUCTION TAB ================= -->
      <div id="reproductionTab" class="profile-tab d-none">

        <!-- ===== SUMMARY / OVERVIEW ===== -->
        <div
          id="reproSummarySection"
          class="card border-0 shadow-sm mb-4 d-none"
        >
          <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
              <h6 class="mb-0">Reproductive Overview</h6>
            </div>

            <div class="row text-center g-3">

              <div class="col">
                <div class="border rounded py-2">
                  <div class="small text-muted">Cycles</div>
                  <div id="statCycles" class="fw-bold fs-5">0</div>
                </div>
              </div>

              <div class="col">
                <div class="border rounded py-2">
                  <div class="small text-muted">Total Born</div>
                  <div id="statTotalBorn" class="fw-bold fs-5">0</div>
                </div>
              </div>

              <div class="col">
                <div class="border rounded py-2">
                  <div class="small text-muted">Avg Litter</div>
                  <div id="statAvgLitter" class="fw-bold fs-5">0</div>
                </div>
              </div>

              <div class="col">
                <div class="border rounded py-2">
                  <div class="small text-muted">Live</div>
                  <div id="statTotalLive" class="fw-bold fs-5">0</div>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- ===== SECTION TITLE ===== -->
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h6 class="mb-0">Breeding & Farrowing History</h6>
        </div>

        <!-- ===== CYCLE CARDS ===== -->
        <div
          id="reproductionCardList"
          class="d-flex flex-column gap-3"
        ></div>

        <!-- ===== EMPTY STATE ===== -->
        <div
          id="reproductionEmptyState"
          class="text-center text-muted py-4 d-none"
        >
          No breeding or farrowing records yet.
        </div>

      </div>

      <!-- ================= OFFSPRING TAB ================= -->
      <div id="offspringTab" class="profile-tab d-none">

        <!-- FILTER BAR (MATCHES GROWTH YEAR FILTER) -->
        <div class="growth-filter-bar mb-3">
          <div class="growth-filter-label">
            <i class="fa-solid fa-arrows-rotate"></i>
            <span>Cycle</span>
          </div>

          <select
            id="offspringCycleFilter"
            class="growth-year-select">
            <!-- populated via JS -->
          </select>
        </div>

        <!-- EMPTY STATE -->
        <div
          id="offspringEmptyState"
          class="text-muted text-center d-none">
          No offspring found
        </div>

        <!-- CYCLE GROUPED LIST -->
        <div
          id="offspringCycleList"
          class="d-flex flex-column gap-3">
        </div>

      </div>

        <!-- ================= GROWTH TAB ================= -->
        <div id="performanceTab" class="profile-tab d-none">

          <!-- 📊 WEIGHT TREND -->
          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h6 class="mb-0">Weight Trend</h6>
              <small class="text-muted">Auto-updated</small>
            </div>
            <div class="bg-white rounded p-3 shadow-sm">
              <canvas id="growthChart" height="120"></canvas>
            </div>
          </div>

          <!-- 📅 MONTHLY GROWTH -->
          <div>
            <h6 class="mb-3">Monthly Growth Summary</h6>

            <!-- YEAR FILTER BAR -->
            <div class="growth-filter-bar">
              <div class="growth-filter-label">
                <i class="fa-solid fa-calendar"></i>
                <span>Year</span>
              </div>

              <select
                id="growthYearFilter"
                class="growth-year-select">
              </select>
            </div>

            <div id="growthTimeline" class="d-flex flex-column gap-3"></div>
          </div>

        </div>

      </div>
    </div>
  </div>
</div>
