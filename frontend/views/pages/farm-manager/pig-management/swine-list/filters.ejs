<form id="filtersForm" class="swine-filter-form">

  <!-- Farmer -->
  <div class="dropdown">
    <button
      class="form-select form-select-sm text-start"
      type="button"
      id="farmerDropdownBtn"
      data-bs-toggle="dropdown">
      Farmer
    </button>

    <div class="dropdown-menu p-2"
      style="max-height:260px;overflow-y:auto;min-width:220px">
      <input
        id="farmerSearch"
        class="form-control form-control-sm mb-2"
        placeholder="Search farmer…">
      <div id="farmerOptions">
        <div class="text-muted small">Loading farmers…</div>
      </div>
    </div>
  </div>

  <!-- Search tag -->
  <input
    id="filterTag"
    class="form-control form-control-sm"
    placeholder="Search tag">

  <!-- Status -->
  <select id="filterStatus" class="form-select form-select-sm">
    <option value="">Status</option>
    <option value="In-Heat">In-Heat</option>
    <option value="Under Observation">Under Observation</option>
    <option value="Pregnant">Pregnant</option>
    <option value="Farrowing">Farrowing</option>
    <option value="Lactating">Lactating</option>
    <option value="Weaning">Weaning</option>
  </select>

  <!-- BUTTONS -->
<div class="btn-group">
  <button type="submit" class="btn btn-success">
    Apply
  </button>

  <button type="button" id="resetFilters" class="btn btn-outline-secondary">
    Reset
  </button>
</div>


</form>
