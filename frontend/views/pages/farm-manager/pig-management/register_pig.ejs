<%- include("../../../partials/farm-manager/header") %>
<%- include("../../../partials/farm-manager/navbar") %>
<%- include("../../../partials/farm-manager/sidepanel") %>

<main class="main-content">
  <div class="container-fluid">

    <%- include("../../../partials/farm-manager/pigmanagement_panel") %>

    <!-- =========================================================
         OUTER SHELL
    ========================================================== -->
    <div class="card page-card register-shell">
      <div class="card-body">

        <!-- HEADER -->
        <div class="module-head d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3">
          <div class="min-w-0">
            <h4 class="module-title mb-1">REGISTER A NATIVE PIG</h4>
            <p class="module-sub mb-0">Add a new pig record with basic info, parentage, and initial measurements.</p>
          </div>

          <div class="module-hint-card d-none d-lg-flex align-items-center gap-2">
            <i class="bi bi-info-circle"></i>
            <div class="small fw-bold text-muted">
              Tip: Select a farmer first to load Dam/Sire options.
            </div>
          </div>
        </div>

        <!-- =========================================================
             PAGE GRID (LEFT: FORM / RIGHT: CHECKLIST CARD)
             ✅ Checklist is now its OWN card (separate from the form)
             ✅ Form tag wraps only the LEFT side
        ========================================================== -->
        <div class="row g-3">

          <!-- ================= LEFT: FORM ================= -->
          <div class="col-12 col-xl-8">
            <form id="registerSwineForm" novalidate>

              <!-- =========================================================
                   SECTION: FARMER
              ========================================================== -->
              <section class="section-card">
                <div class="section-card-head">
                  <div class="section-left">
                    <div class="section-icon"><i class="bi bi-person-badge"></i></div>
                    <div class="min-w-0">
                      <div class="section-title">Farmer Information</div>
                      <div class="section-sub">Select exactly one farmer to load available sows/boars.</div>
                    </div>
                  </div>
                </div>

                <div class="section-card-body">

                  <!-- hidden input (required) -->
                  <input type="hidden" id="farmerSelect" required />

                  <!-- selected farmer preview -->
                  <div id="selectedFarmerCard" class="selected-card d-none">
                    <div class="selected-card-left">
                      <div class="avatar">
                        <img
                          id="selectedFarmerImg"
                          src="/images/default-avatar.png"
                          alt="Farmer"
                          onerror="this.onerror=null;this.src='/images/default-avatar.png';"
                        />
                      </div>

                      <div class="meta min-w-0">
                        <div class="name text-truncate" id="selectedFarmerName">—</div>
                        <div class="sub text-truncate" id="selectedFarmerId">—</div>

                        <div class="pill-row">
                          <span class="pill">
                            <i class="bi bi-geo-alt"></i>
                            <span class="text-truncate d-inline-block" style="max-width:240px;" id="selectedFarmerAddress">—</span>
                          </span>

                          <span class="pill">
                            <i class="bi bi-telephone"></i>
                            <span id="selectedFarmerContact">—</span>
                          </span>

                          <span class="pill">
                            <i class="bi bi-grid-3x3-gap"></i>
                            <span>Pens:</span> <b id="selectedFarmerPenCount">—</b>
                          </span>

                          <span class="pill">
                            <i class="bi bi-boxes"></i>
                            <span>Cap:</span> <b id="selectedFarmerPenCap">—</b>
                          </span>
                        </div>
                      </div>
                    </div>

                    <div class="selected-card-right">
                      <span class="badge-soft">
                        <i class="bi bi-check-circle"></i> Selected
                      </span>

                      <div class="btn-row">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="changeFarmerBtn">
                          <i class="bi bi-arrow-repeat me-1"></i> Change
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm" id="clearFarmerBtn">
                          <i class="bi bi-x-circle me-1"></i> Deselect
                        </button>
                      </div>
                    </div>
                  </div>

                  <!-- empty state -->
                  <div id="farmerEmptyCard" class="empty-card">
                    <div class="empty-left">
                      <div class="empty-icon"><i class="bi bi-person-plus"></i></div>
                      <div class="min-w-0">
                        <div class="empty-title">No farmer selected</div>
                        <div class="empty-sub">Select a farmer to continue and load parent options.</div>
                      </div>
                    </div>

                    <button type="button" class="btn btn-success" id="selectFarmerCtaBtn">
                      <i class="bi bi-search me-1"></i> Choose Farmer
                    </button>
                  </div>

                </div>
              </section>

              <!-- =========================================================
                   SECTION: BASIC INFO
              ========================================================== -->
              <section class="section-card">
                <div class="section-card-head">
                  <div class="section-left">
                    <div class="section-icon"><i class="bi bi-clipboard-data"></i></div>
                    <div class="min-w-0">
                      <div class="section-title">Pig Information</div>
                      <div class="section-sub">Basic identity & status info.</div>
                    </div>
                  </div>
                </div>

                <div class="section-card-body">
                  <div class="row g-3">

                    <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Batch ID / Source ID</label>
                      <input type="text" id="batch" class="form-control" placeholder="Enter Batch ID" />
                      <div class="field-hint">Auto-generated for adults / inherited for piglets.</div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Sex</label>
                      <select id="sex" class="form-select" required>
                        <option value="">Select Sex</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                      </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Age Stage</label>
                      <select id="ageStage" class="form-select" required>
                        <option value="">Select Stage</option>
                        <option value="piglet">Piglet</option>
                        <option value="growing">Growing / Finishing</option>
                        <option value="adult">Adult (Breeder)</option>
                      </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Breed</label>
                      <input type="text" id="breed" class="form-control" value="Native" readonly />
                    </div>

                    <!-- <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Color</label>
                      <select id="colorSelect" class="form-select">
                        <option value="">Select Color</option>
                        <option value="Black">Black</option>
                        <option value="Black with White Markings">Black with White Markings</option>
                        <option value="Brown">Brown</option>
                        <option value="Reddish Brown">Reddish Brown</option>
                        <option value="Spotted (Black & White)">Spotted (Black & White)</option>
                        <option value="Gray">Gray</option>
                        <option value="Other">Other (Specify)</option>
                      </select>
                    </div> -->

                    <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Color</label>
                      <input type="text" id="colorSelect" class="form-select" value="Black" readonly />
                    </div>

                    <!-- <div class="col-12 col-md-6 col-xl-3 d-none" id="otherColorGroup">
                      <label class="form-label">Specify Color</label>
                      <input type="text" id="otherColorInput" class="form-control" placeholder="Enter color description" />
                    </div> -->

                    <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Birth Date</label>
                      <input type="date" id="birth_date" class="form-control" required />
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Date Registered</label>
                      <input type="date" id="date_transfer" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Health Status</label>
                      <select id="health_status" class="form-select">
                        <option value="Healthy">Healthy</option>
                        <option value="Sick">Sick</option>
                        <option value="Deceased">Deceased</option>
                      </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3 d-none" id="teatCountGroup">
                      <label class="form-label">Teat Count (Adult Female)</label>
                      <input type="number" id="teatCount" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6 col-xl-3 d-none" id="teatAlignmentGroup">
                      <label class="form-label">Teat Alignment</label>
                      <select id="teatAlignment" class="form-select">
                        <option value="Even">Even</option>
                        <option value="Uneven">Uneven</option>
                      </select>
                    </div>

                  </div>
                </div>
              </section>

              <!-- =========================================================
                   SECTION: PARENTAGE
              ========================================================== -->
              <section class="section-card">
                <div class="section-card-head">
                  <div class="section-left">
                    <div class="section-icon"><i class="bi bi-diagram-3"></i></div>
                    <div class="min-w-0">
                      <div class="section-title">Parentage</div>
                      <div class="section-sub">Optional, but recommended for piglets or tracked lineage.</div>
                    </div>
                  </div>
                </div>

                <div class="section-card-body">
                  <div class="row g-3">
                    <div class="col-12 col-lg-6">
                      <label class="form-label">Dam (Mother)</label>
                      <select id="dam_id" class="form-select">
                        <option value="">-- Select Sow --</option>
                      </select>
                      <div class="field-hint">Loads from selected farmer’s adult females.</div>
                    </div>

                    <div class="col-12 col-lg-6">
                      <label class="form-label">Sire (Father)</label>
                      <select id="sire_id" class="form-select">
                        <option value="">-- Select Boar --</option>
                      </select>
                      <div class="field-hint">Loads based on the selected sow history + active boars.</div>
                    </div>
                  </div>
                </div>
              </section>

              <!-- =========================================================
                   SECTION: MEASUREMENTS
              ========================================================== -->
              <section class="section-card">
                <div class="section-card-head">
                  <div class="section-left">
                    <div class="section-icon"><i class="bi bi-rulers"></i></div>
                    <div class="min-w-0">
                      <div class="section-title">Initial Measurements</div>
                      <div class="section-sub">Required weight; others optional.</div>
                    </div>
                  </div>
                </div>

                <div class="section-card-body">
                  <div class="row g-3">
                    <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Weight (kg)</label>
                      <input type="number" id="weight" step="0.01" class="form-control" required />
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Body Length (cm)</label>
                      <input type="number" id="bodyLength" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Heart Girth (cm)</label>
                      <input type="number" id="heartGirth" class="form-control" />
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                      <label class="form-label">Teeth Count</label>
                      <input type="number" id="teethCount" class="form-control" />
                    </div>
                  </div>
                </div>
              </section>

              <!-- =========================================================
                   SECTION: DEFORMITIES
              ========================================================== -->
              <section class="section-card">
                <div class="section-card-head">
                  <div class="section-left">
                    <div class="section-icon"><i class="bi bi-exclamation-diamond"></i></div>
                    <div class="min-w-0">
                      <div class="section-title">Observed Deformities</div>
                      <div class="section-sub">Hidden automatically for adult stage.</div>
                    </div>
                  </div>
                </div>

                <div class="section-card-body">
                  <div id="deformityChecklist" class="pill-checklist">
                    <label class="pill-check"><input type="checkbox" value="Splayleg"> <span>Splayleg</span></label>
                    <label class="pill-check"><input type="checkbox" value="Bent Legs"> <span>Bent Legs</span></label>
                    <label class="pill-check"><input type="checkbox" value="Scrotal Hernia"> <span>Scrotal Hernia</span></label>
                    <label class="pill-check"><input type="checkbox" value="Umbilical Hernia"> <span>Umbilical Hernia</span></label>
                    <label class="pill-check"><input type="checkbox" value="Atresia Ani"> <span>Atresia Ani</span></label>
                    <label class="pill-check"><input type="checkbox" value="Cleft Palate"> <span>Cleft Palate</span></label>
                  </div>
                </div>
              </section>

              <!-- FOOTER ACTIONS (✅ smaller buttons) -->
              <div class="form-actions">
                <button type="reset" class="btn btn-outline-secondary btn-md" id="resetRegisterBtn">
                  <i class="bi bi-eraser me-1"></i> Clear
                </button>

                <button type="submit" class="btn btn-success btn-md" id="submitRegisterBtn">
                  <i class="bi bi-check2-circle me-1"></i> Register Pig
                </button>
              </div>

            </form>
          </div>

          <!-- ================= RIGHT: CHECKLIST (OWN CARD, OUTSIDE FORM) ================= -->
          <div class="col-12 col-xl-4">
            <div class="sticky-xl">
              <div class="card page-card side-summary">
                <div class="card-body">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="fw-black">
                      <i class="bi bi-view-list me-2"></i> Registration Checklist
                    </div>
                    <span class="chip-soft">
                      <i class="bi bi-shield-check me-1"></i> MVP
                    </span>
                  </div>

                  <div class="small text-muted fw-bold mb-3">
                    This panel helps users finish the form with fewer mistakes.
                  </div>

                  <div class="checklist">
                    <div class="check-item">
                      <i class="bi bi-person-check"></i>
                      <div>
                        <div class="check-title">Select Farmer</div>
                        <div class="check-sub">Loads parent options automatically.</div>
                      </div>
                    </div>

                    <div class="check-item">
                      <i class="bi bi-card-checklist"></i>
                      <div>
                        <div class="check-title">Pig Information</div>
                        <div class="check-sub">Sex, age stage, birth date required.</div>
                      </div>
                    </div>

                    <div class="check-item">
                      <i class="bi bi-rulers"></i>
                      <div>
                        <div class="check-title">Measurements</div>
                        <div class="check-sub">Weight is required.</div>
                      </div>
                    </div>

                    <div class="check-item">
                      <i class="bi bi-diagram-3"></i>
                      <div>
                        <div class="check-title">Parentage</div>
                        <div class="check-sub">Optional but recommended for lineage.</div>
                      </div>
                    </div>
                  </div>

                  <hr class="my-3">

                  <div class="d-flex gap-2">
                    <div class="mini-stat">
                      <div class="mini-stat-top"><i class="bi bi-calendar2-week"></i> Date</div>
                      <div class="mini-stat-val">Use “Date Registered” if transferred</div>
                    </div>
                    <div class="mini-stat">
                      <div class="mini-stat-top"><i class="bi bi-heart-pulse"></i> Health</div>
                      <div class="mini-stat-val">Healthy by default</div>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>

        </div><!-- /row -->

      </div>
    </div>
  </div>

  <!-- =========================================================
       FARMER PICKER MODAL (CENTER)
  ========================================================== -->
  <div class="modal fade" id="farmerPickerModal" tabindex="-1" aria-labelledby="farmerPickerModalLabel">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
      <div class="modal-content farmer-modal">

        <div class="modal-header">
          <h5 class="modal-title" id="farmerPickerModalLabel">
            <i class="bi bi-people me-2"></i> Select a Farmer
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <div class="farmer-modal-controls">
            <div class="searchbox">
              <i class="bi bi-search"></i>
              <input type="text" id="farmerPanelSearch" class="form-control" placeholder="Search by name / farmer ID / address..." />
            </div>

            <button class="btn btn-outline-secondary" type="button" id="farmerSearchClearBtn">
              Clear
            </button>
          </div>

          <div class="farmer-modal-hint text-muted small mt-2">
            Choose exactly one farmer.
          </div>

          <div id="farmerPanelList" class="farmer-list mt-3">
            <div class="text-muted small p-2">Loading farmers...</div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- =========================================================
       FEEDBACK MODAL (SUCCESS / ERROR / INFO)
       ✅ Use this modal instead of alert()
       ✅ Appears centered with close button
  ========================================================== -->
  <div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content feedback-modal">

        <div class="modal-header">
          <h5 class="modal-title" id="feedbackModalLabel">Message</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <div class="feedback-body">
            <div class="feedback-icon" id="feedbackIconWrap">
              <i class="bi bi-info-circle" id="feedbackIcon"></i>
            </div>

            <div class="feedback-text">
              <div class="feedback-title" id="feedbackTitle">Notice</div>
              <div class="feedback-msg" id="feedbackMsg">—</div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-success" data-bs-dismiss="modal">
            Close
          </button>
        </div>

      </div>
    </div>
  </div>

</main>

<%- include("../../../partials/farm-manager/footer") %>