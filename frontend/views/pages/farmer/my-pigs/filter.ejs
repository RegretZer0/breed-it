<div class="pig-filter">

  <input 
    type="text" 
    id="searchInput" 
    placeholder="Search by Tag ID"
  />

  <select id="statusFilter">
    <option value="">All Status</option>
    <option value="Healthy">Healthy</option>
    <option value="Monitoring">Monitoring</option>
