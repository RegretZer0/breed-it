<%- include("../../partials/farmer/farmer_nav") %>

<div class="app-root">
  <main class="profile-container">

  <!-- PROFILE HEADER -->
  <section class="profile-header-card">
    <div class="profile-avatar">
      <img 
        id="profileAvatarImg" 
        src="/images/default-avatar.png" 
        alt="Profile Picture"
      />
    </div>

    <div class="profile-header-info">
      <h2 id="profileName">Loading...</h2>
      <p class="role">Pig Farmer</p>
    </div>
  </section>


  <!-- VIEW PROFILE CARD -->
  <section id="viewProfile" class="profile-card modern-card">

    <div class="info-grid">
      <div class="info-item">
        <label>Farmer ID</label>
        <span id="farmer_id">-</span>
      </div>

      <div class="info-item">
        <label>Email</label>
        <span id="email">-</span>
      </div>

      <div class="info-item">
        <label>Contact Number</label>
        <span id="contact_no">-</span>
      </div>

      <div class="info-item">
        <label>Address</label>
        <span id="address">-</span>
      </div>

      <div class="info-item">
        <label>Number of Pens</label>
        <span id="num_of_pens">0</span>
      </div>

      <div class="info-item">
        <label>Pen Capacity</label>
        <span id="pen_capacity">0</span>
      </div>
    </div>

    <button class="primary-btn edit-profile-btn" id="editProfileBtn">
      <i class="bi bi-pencil"></i>
      Edit Profile
    </button>

  </section>


  <!-- EDIT PROFILE -->
  <section id="editProfile" class="profile-card modern-card hidden">

    <h3 class="section-title">Edit Profile</h3>

    <!-- =========================
         AVATAR UPLOAD SECTION
    ========================== -->
    <div class="avatar-upload">

      <div class="avatar-preview">
        <img 
          id="editAvatarImg" 
          src="/images/default-avatar.png" 
          alt="Edit Avatar"
        />
      </div>

      <button type="button" id="changeAvatarBtn">Change Photo</button>

      <input
        type="file"
        id="avatarInput"
        accept="image/*"
        hidden
      />
    </div>


    <!-- =========================
         FORM GRID
    ========================== -->
    <div class="form-grid">

      <div class="form-group">
        <label>Name</label>
        <input type="text" id="editName" disabled />
      </div>

      <div class="form-group">
        <label>Email</label>
        <input type="email" id="editEmail" disabled />
      </div>

      <div class="form-group">
        <label>Contact Number</label>
        <input type="tel" id="editContact_no" required />
      </div>

      <div class="form-group">
        <label>Address</label>
        <input type="text" id="editAddress" required />
      </div>

      <div class="form-group">
        <label>Number of Pens</label>
        <input type="number" id="editNumPens" min="0" required />
      </div>

      <div class="form-group">
        <label>Pen Capacity</label>
        <input type="number" id="editPenCapacity" min="0" required />
      </div>

    </div>

    <button class="secondary-btn mt-3" id="openChangePassword">
      Change Password
    </button>

    <div class="actions modern-actions">
      <button class="cancel-btn" id="cancelEdit">Cancel</button>
      <button class="primary-btn save-btn">Save</button>
    </div>

  </section>

  </main>
</div>


<!-- =========================
     PREVIEW MODAL
========================= -->
<div id="previewModal" class="modal hidden">
  <div class="modal-content">
    <h3>Confirm Profile Changes</h3>

    <div class="modal-preview">
      <p><strong>Name:</strong> <span id="previewName"></span></p>
      <p><strong>Email:</strong> <span id="previewEmail"></span></p>
      <p><strong>Contact:</strong> <span id="previewContact"></span></p>
      <p><strong>Address:</strong> <span id="previewAddress"></span></p>
      <p><strong>Number of Pens:</strong> <span id="previewNumPens"></span></p>
      <p><strong>Pen Capacity:</strong> <span id="previewPenCapacity"></span></p>
    </div>

    <div class="modal-actions">
      <button id="previewCancel" class="cancel-btn">CANCEL</button>
      <button id="previewConfirm" class="save-btn">CONFIRM</button>
    </div>
  </div>
</div>


<!-- =========================
     SUCCESS MODAL
========================= -->
<div id="successModal" class="success-overlay hidden">
  <div class="success-modal">
    <div class="success-icon">
      <i class="bi bi-check-lg"></i>
    </div>

    <h3>Profile Updated</h3>
    <p>Your profile changes have been saved successfully.</p>

    <button id="closeSuccessModal" class="primary-btn w-100">
      Continue
    </button>
  </div>
</div>


<!-- =========================
     ERROR MODAL
========================= -->
<div id="errorModal" class="error-overlay hidden">
  <div class="error-modal">
    <div class="error-icon">
      <i class="bi bi-x-lg"></i>
    </div>

    <h3>Update Failed</h3>
    <p>Something went wrong while saving your profile.</p>

    <button id="closeErrorModal" class="error-btn w-100">
      Try Again
    </button>
  </div>
</div>


<!-- =========================
     CHANGE PASSWORD MODAL
========================= -->
<div id="changePasswordModal" class="modal hidden">
  <div class="modal-content change-password-modal">

    <h3 class="modal-title">Change Password</h3>

    <button
      class="btn-otp w-100"
      id="requestChangeOtpBtn"
      type="button"
    >
      Send OTP to Email
    </button>

    <form id="changePasswordForm" class="mt-3">

      <div class="form-group">
        <label for="changeOtp">OTP</label>
        <input
          type="text"
          id="changeOtp"
          class="form-control otp-input"
          required
        />
      </div>

      <div class="form-group">
        <label for="changeNewPassword">New Password</label>
        <input
          type="password"
          id="changeNewPassword"
          class="form-control"
          required
        />
      </div>

      <p id="changePasswordMessage" class="modal-message"></p>

      <div class="change-password-actions">
        <button type="button" class="btn-cancel" id="closeChangePassword">
          Cancel
        </button>

        <button type="submit" class="btn-primary">
          Confirm
        </button>
      </div>

    </form>

  </div>
</div>

<%- include("../../partials/farmer/farmer_footer") %>
