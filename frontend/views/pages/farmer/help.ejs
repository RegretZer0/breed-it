<%- include("../../partials/farmer/farmer_nav") %>

<div class="app-root">
  <main class="help-container container-fluid">

    <!-- HERO -->
    <section class="help-hero mb-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
          <h2 class="mb-1">Need Help?</h2>
          <p class="mb-0">Find guides, answers and support quickly.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
          <span class="help-hero-chip">
            <i class="bi bi-life-preserver me-2"></i>
            Help & Support
          </span>
        </div>
      </div>
    </section>

    <!-- OPTIONS (1 ROW PER TAB / CARD) -->
    <section class="help-options d-grid gap-3">

      <a href="javascript:void(0)" class="help-row-card text-decoration-none" role="button" aria-label="Video Tutorials">
        <div class="row-card-left">
          <div class="row-card-icon">
            <i class="bi bi-play-circle"></i>
          </div>
          <div class="min-w-0">
            <div class="row-card-title">Video Tutorials</div>
            <div class="row-card-sub text-truncate">Step-by-step walkthroughs</div>
          </div>
        </div>
        <div class="row-card-right">
          <i class="bi bi-chevron-right"></i>
        </div>
      </a>

      <a href="javascript:void(0)" class="help-row-card text-decoration-none" role="button" aria-label="Frequently Asked Questions">
        <div class="row-card-left">
          <div class="row-card-icon">
            <i class="bi bi-patch-question"></i>
          </div>
          <div class="min-w-0">
            <div class="row-card-title">Frequently Asked Questions</div>
            <div class="row-card-sub text-truncate">Quick answers and fixes</div>
          </div>
        </div>
        <div class="row-card-right">
          <i class="bi bi-chevron-right"></i>
        </div>
      </a>

      <a
        href="javascript:void(0)"
        class="help-row-card text-decoration-none"
        role="button"
        aria-label="Support"
        data-bs-toggle="modal"
        data-bs-target="#helpModal"
      >
        <div class="row-card-left">
          <div class="row-card-icon">
            <i class="bi bi-headset"></i>
          </div>
          <div class="min-w-0">
            <div class="row-card-title">Support</div>
            <div class="row-card-sub text-truncate">Submit a ticket and track status</div>
          </div>
        </div>
        <div class="row-card-right">
          <i class="bi bi-chevron-right"></i>
        </div>
      </a>

    </section>
  </main>
</div>

<!-- SUPPORT MODAL (unchanged from your latest) -->
<div class="modal fade" id="helpModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content help-modal-shell border-0">

      <div class="modal-header border-0 pb-0">
        <div class="d-flex align-items-start gap-3">
          <div class="help-modal-badge">
            <i class="bi bi-life-preserver"></i>
          </div>
          <div>
            <h5 class="modal-title mb-1">Help & Support</h5>
            <div class="text-muted small">Guides, common fixes, and ticket submission</div>
          </div>
        </div>

        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body pt-3">
        <div class="container-fluid">
          <div class="row g-3 g-lg-4">

            <div class="col-12 col-lg-4">
              <div class="card help-pane border-0 h-100">
                <div class="card-body p-3 p-md-4">

                  <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="pane-icon">
                      <i class="bi bi-lightning-charge"></i>
                    </div>
                    <div class="fw-semibold">Quick Guide</div>
                  </div>

                  <ul class="list-unstyled mb-3 help-bullets">
                    <li class="d-flex gap-2">
                      <span class="dot"></span>
                      <div>
                        <div class="fw-semibold small mb-1">Sidebar</div>
                        <div class="text-muted small">Use the left navigation to switch modules.</div>
                      </div>
                    </li>

                    <li class="d-flex gap-2">
                      <span class="dot"></span>
                      <div>
                        <div class="fw-semibold small mb-1">Notifications</div>
                        <div class="text-muted small">Click the bell to view alerts and history.</div>
                      </div>
                    </li>

                    <li class="d-flex gap-2">
                      <span class="dot"></span>
                      <div>
                        <div class="fw-semibold small mb-1">Account Settings</div>
                        <div class="text-muted small">Update your profile and password.</div>
                      </div>
                    </li>

                    <li class="d-flex gap-2">
                      <span class="dot"></span>
                      <div>
                        <div class="fw-semibold small mb-1">Data Safety</div>
                        <div class="text-muted small">Avoid refreshing during file uploads.</div>
                      </div>
                    </li>
                  </ul>

                  <hr class="my-3">

                  <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="pane-icon">
                      <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <div class="fw-semibold">Common Issues</div>
                  </div>

                  <div class="d-grid gap-2">
                    <div class="issue-card">
                      <div class="fw-semibold small">“Page disappeared” / stuck scroll</div>
                      <div class="text-muted small">Close any open modal/offcanvas, then refresh the page.</div>
                    </div>

                    <div class="issue-card">
                      <div class="fw-semibold small">Upload not showing</div>
                      <div class="text-muted small">Confirm file type/size and keep the internet stable during upload.</div>
                    </div>

                    <div class="issue-card">
                      <div class="fw-semibold small">Session expired</div>
                      <div class="text-muted small">Login again if you were inactive for a while.</div>
                    </div>
                  </div>

                  <hr class="my-3">

                  <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="pane-icon">
                      <i class="bi bi-envelope"></i>
                    </div>
                    <div class="fw-semibold">Support Email</div>
                  </div>
                  <div class="text-muted small">breedit.contact@gmail.com</div>

                </div>
              </div>
            </div>

            <div class="col-12 col-lg-8">
              <div class="card help-pane border-0">
                <div class="card-body p-3 p-md-4">

                  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                      <div class="pane-icon">
                        <i class="bi bi-ticket-perforated"></i>
                      </div>
                      <div class="fw-semibold">Submit a Support Ticket</div>
                    </div>

                    <button
                      type="button"
                      class="btn btn-sm btn-help-soft"
                      id="openTicketHistoryBtn"
                      data-bs-toggle="modal"
                      data-bs-target="#ticketHistoryModal"
                    >
                      <i class="bi bi-clock-history me-1"></i>
                      Ticket History
                    </button>
                  </div>

                  <form id="helpTicketForm" novalidate>
                    <div class="row g-3">
                      <div class="col-12 col-md-6">
                        <label class="form-label small text-muted" for="helpName">Name</label>
                        <input type="text" class="form-control help-input" id="helpName" placeholder="Your name">
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label small text-muted" for="helpEmail">Email</label>
                        <input type="email" class="form-control help-input" id="helpEmail" placeholder="you@email.com">
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label small text-muted" for="helpCategory">Category</label>
                        <select class="form-select help-input" id="helpCategory">
                          <option value="">Select category</option>
                          <option value="technical">Bug / Error</option>
                          <option value="account">Account / Access</option>
                          <option value="billing">Data Concern</option>
                          <option value="other">Other</option>
                        </select>
                      </div>

                      <div class="col-12 col-md-6">
                        <label class="form-label small text-muted" for="helpPriority">Priority</label>
                        <select class="form-select help-input" id="helpPriority">
                          <option value="low">Low</option>
                          <option value="normal" selected>Normal</option>
                          <option value="high">High</option>
                          <option value="urgent">Urgent</option>
                        </select>
                        <div class="form-text">Priority is set automatically based on the category.</div>
                      </div>

                      <div class="col-12">
                        <label class="form-label small text-muted" for="helpSubject">Subject</label>
                        <input
                          type="text"
                          class="form-control help-input"
                          id="helpSubject"
                          placeholder="Short summary (e.g., cannot upload profile photo)"
                        >
                      </div>

                      <div class="col-12">
                        <label class="form-label small text-muted" for="helpMessage">Message</label>
                        <textarea
                          class="form-control help-textarea"
                          id="helpMessage"
                          rows="6"
                          placeholder="Describe the issue. Include steps to reproduce if possible."
                        ></textarea>
                        <div class="form-text">Tip: include what page you were on and what button you clicked.</div>
                      </div>

                      <div class="col-12 d-flex flex-column flex-sm-row gap-2 justify-content-end pt-2">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                          Cancel
                        </button>

                        <button type="submit" class="btn btn-help-primary" id="helpSubmitTicketBtn">
                          <i class="bi bi-send me-2"></i>
                          Submit Ticket
                        </button>
                      </div>
                    </div>
                  </form>

                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- =========================
     TICKET HISTORY MODAL (MATCHED)
========================= -->
<div class="modal fade" id="ticketHistoryModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content help-modal-shell">

      <div class="modal-header help-modal-header">
        <div class="d-flex align-items-center gap-2">
          <span class="help-ic"><i class="bi bi-receipt"></i></span>
          <div class="min-w-0">
            <h5 class="modal-title mb-0">Ticket History</h5>
            <div class="help-sub small text-muted">View submitted tickets and their status.</div>
          </div>
        </div>

        <button type="button" class="btn-close help-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body help-modal-body">

        <!-- Filters -->
        <div class="help-card mb-3">
          <div class="help-card-body">

            <div class="row g-2 align-items-end">
              <div class="col-12 col-md-3">
                <label class="help-label">Status</label>
                <select class="form-select help-control" id="ticketFilterStatus">
                  <option value="">All</option>
                  <option value="submitted">Submitted</option>
                  <option value="in_progress">In progress</option>
                  <option value="resolved">Resolved</option>
                </select>
              </div>

              <div class="col-12 col-md-3">
                <label class="help-label">Category</label>
                <select class="form-select help-control" id="ticketFilterCategory">
                  <option value="">All</option>
                  <option value="account">Account</option>
                  <option value="upload">Upload</option>
                  <option value="data">Data</option>
                  <option value="bug">Bug</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div class="col-12 col-md-3">
                <label class="help-label">Priority</label>
                <select class="form-select help-control" id="ticketFilterPriority">
                  <option value="">All</option>
                  <option value="low">Low</option>
                  <option value="normal">Normal</option>
                  <option value="urgent">Urgent</option>
                </select>
              </div>

              <div class="col-12 col-md-3">
                <label class="help-label">Search</label>
                <input class="form-control help-control" id="ticketSearch" placeholder="Subject, ref, message..." />
              </div>

              <div class="col-12 col-md-3">
                <label class="help-label">From</label>
                <input type="date" class="form-control help-control" id="ticketDateFrom" />
              </div>

              <div class="col-12 col-md-3">
                <label class="help-label">To</label>
                <input type="date" class="form-control help-control" id="ticketDateTo" />
              </div>

              <div class="col-12 col-md-6 d-flex gap-2 justify-content-md-end">
                <button class="btn btn-outline-success help-btn" id="ticketFilterResetBtn" type="button">
                  <i class="bi bi-arrow-counterclockwise"></i> Reset
                </button>
                <button class="btn btn-success help-btn" id="ticketFilterApplyBtn" type="button">
                  <i class="bi bi-funnel"></i> Apply
                </button>
              </div>
            </div>

          </div>
        </div>

        <!-- List -->
        <div class="help-card">
          <div class="help-card-body">

            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
              <div class="small text-muted" id="ticketHistoryMeta">—</div>

              <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-success btn-sm" id="ticketPrevBtn" type="button">Prev</button>
                <span class="small fw-semibold" id="ticketPageLabel">Page 1</span>
                <button class="btn btn-outline-success btn-sm" id="ticketNextBtn" type="button">Next</button>
              </div>
            </div>

            <div id="ticketHistoryList" class="ticket-history-list">
              <!-- cards inserted here -->
            </div>

            <div id="ticketHistoryEmpty" class="text-center text-muted py-4 d-none">
              No tickets found.
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<%- include("../../partials/farmer/farmer_footer") %>