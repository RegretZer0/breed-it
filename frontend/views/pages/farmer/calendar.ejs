<%- include("../../partials/farmer/farmer_nav") %>

<div class="calendar-root container-fluid py-4">

  <div class="row g-4">

    <!-- ================= CALENDAR ================= -->
    <div class="col-lg-8">
      <div class="calendar-card">

        <div class="calendar-header">
          <div>
            <h4>Breeding & Farrowing Schedule</h4>
            <p>Monitor Artificial Insemination, Heat Re-checks, Farrowing & Weaning</p>
          </div>
        </div>

        <div id="calendar"></div>

      </div>
    </div>

    <!-- ================= TASK PANEL ================= -->
    <div class="col-lg-4">
      <div class="task-card-wrapper">

        <div class="task-header">
          <h4>Tasks</h4>
          <span id="selectedDateLabel">No date selected</span>
        </div>

        <div id="taskPanel">
          <div class="empty-state">
            Click a calendar date to view tasks.
          </div>
        </div>

      </div>
    </div>

  </div>

</div>

