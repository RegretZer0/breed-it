<%- include("../../partials/farmer/farmer_nav") %>

<div class="calendar-root container-fluid py-4">
  <div class="container-xxl">

    <!-- ================= PAGE TOP BAR ================= -->
    <!-- ================= PAGE TOP BAR (TITLE CARD) ================= -->
    <div class="calendar-pagecard mb-4">
      <div class="calendar-topbar">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
          <div class="d-flex align-items-start gap-3">
            <div class="calendar-app-icon d-none d-sm-flex">
              <i class="bi bi-calendar2-week"></i>
            </div>

            <div>
              <h4 class="calendar-title mb-1">Breeding & Farrowing Schedule</h4>
              <div class="calendar-subtitle">
                Monitor Artificial Insemination, Heat Re-checks, Farrowing & Weaning
              </div>
            </div>
          </div>

          <div class="calendar-legend d-flex flex-wrap gap-2">
            <span class="legend-chip" style="--c:#ff9a1f;"><i class="bi bi-fire"></i> In-Heat</span>
            <span class="legend-chip" style="--c:#1ea7ff;"><i class="bi bi-eye"></i> Under Observation</span>
            <span class="legend-chip" style="--c:#43c572;"><i class="bi bi-heart-fill"></i> Pregnant</span>
            <span class="legend-chip" style="--c:#cf2631;"><i class="bi bi-exclamation-triangle-fill"></i> Farrowing</span>
            <span class="legend-chip" style="--c:#eb79ae;"><i class="bi bi-droplet-fill"></i> Lactating</span>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">

      <!-- ================= CALENDAR ================= -->
      <div class="col-lg-8">
        <div class="calendar-card h-100">

          <!-- Card header (app-like) -->
          <div class="calendar-card-head">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
              <div class="d-flex align-items-center gap-2">
                <div class="pill-icon">
                  <i class="bi bi-clipboard2-pulse"></i>
                </div>
                <div class="small text-muted">
                  Tap a date to preview tasks and actions on the right panel.
                </div>
              </div>

              <div class="d-flex align-items-center gap-2">
                <span class="today-chip">
                  <i class="bi bi-dot"></i> Calendar View
                </span>
              </div>
            </div>
          </div>

          <!-- IMPORTANT: keep this ID -->
          <div id="calendar"></div>

        </div>
      </div>

      <!-- ================= TASK PANEL ================= -->
      <div class="col-lg-4">
        <div class="task-card-wrapper h-100">

          <!-- Sticky header inside panel -->
          <div class="task-header sticky-top">
            <div class="d-flex align-items-center justify-content-between gap-2">
              <div class="d-flex align-items-center gap-2">
                <div class="pill-icon">
                  <i class="bi bi-list-check"></i>
                </div>
                <h4 class="mb-0">Tasks</h4>
              </div>

              <!-- IMPORTANT: keep this ID -->
              <span id="selectedDateLabel" class="date-pill">No date selected</span>
            </div>
          </div>

          <!-- IMPORTANT: keep this ID -->
          <div id="taskPanel">
            <div class="empty-state">
              <div class="empty-icon">
                <i class="bi bi-hand-index-thumb"></i>
              </div>
              <div class="fw-semibold">No date selected</div>
              <div class="small text-muted">Click a calendar date to view tasks.</div>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</div>

<%- include("../../partials/farmer/farmer_footer") %>