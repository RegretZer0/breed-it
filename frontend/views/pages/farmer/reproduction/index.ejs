<%- include("../../../partials/farmer/farmer_nav") %>

<div class="app-root">
  <main class="container-fluid py-3 py-lg-4">

    <!-- APP HERO (TITLE CARD) -->
    <div class="repro-hero card shadow-sm mb-3 overflow-hidden">
      <div class="card-body">
        <div class="row g-3 align-items-center">

          <!-- Left: greeting / title -->
          <div class="col-12">
            <div class="d-flex align-items-start gap-3">
              <div class="repro-hero-avatar d-none d-sm-flex">
                <i class="bi bi-activity"></i>
              </div>

              <div class="min-w-0">
                <div class="repro-hero-kicker">Hi! Farmer</div>
                <h4 class="mb-1 repro-title text-truncate">Reproduction Monitoring</h4>
                <div class="repro-hero-sub text-truncate">
                  Track sow cycles, monitor piglets, review performance, and finalize selection.
                </div>

              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- ✅ FILTER CARD (NEW) -->
    <div class="card repro-filter-card shadow-sm border-0 mb-3 mb-lg-4">
      <div class="card-body">
        <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap mb-2">
          <div class="min-w-0">
            <div class="fw-bold d-flex align-items-center gap-2">
              <span class="repro-pill"><i class="bi bi-funnel"></i></span>
              <span>Filters</span>
            </div>
            <div class="text-muted small">Search by sow tag/pig ID and narrow down by status.</div>
          </div>
        </div>

        <div class="row g-2 align-items-center">
          <!-- Search (KEEP ID: reproductionSearch) -->
          <div class="col-12 col-lg-6">
            <div class="input-group">
              <span class="input-group-text bg-white">
                <i class="bi bi-search"></i>
              </span>
              <input
                type="text"
                id="reproductionSearch"
                class="form-control"
                placeholder="Tag / Pig ID..."
              />
            </div>
          </div>

          <!-- Status dropdown -->
          <div class="col-12 col-lg-3">
            <select id="reproStatusFilter" class="form-select">
              <option value="all" selected>All Status</option>
              <option value="open_sows">Open sows</option>
              <option value="in_heat">In-heat</option>
              <option value="under_observation">Under observation</option>
              <option value="pregnant">Pregnant</option>
              <option value="farrowing">Farrowing</option>
              <option value="lactating">Lactating</option>
              <option value="weaning">Weaning</option>
            </select>
          </div>

          <!-- Apply / Reset -->
          <div class="col-12 col-lg-3">
            <div class="d-grid d-sm-flex gap-2 justify-content-lg-end">
              <button type="button" class="btn btn-success" data-act="applySowFilters">
                <i class="bi bi-check2-circle me-1"></i> Apply
              </button>
              <button type="button" class="btn btn-outline-success" data-act="resetSowFilters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
              </button>
            </div>
          </div>
        </div>

        <div class="small text-muted mt-2">
          Tip: Try “pregnant”, “lactating”, or a sow tag.
        </div>
      </div>
    </div>

    <!-- MAIN -->
    <div class="row g-3 g-lg-4">
      <div class="col-12">
        <div class="repro-center-wrap">
          <%- include("./sow_list") %>
        </div>
      </div>
    </div>

    <!-- LEGACY IDS (HIDDEN COMPAT) -->
    <%- include("./legacy_compat") %>

  </main>
</div>

<%- include("../../../partials/farmer/farmer_footer") %>