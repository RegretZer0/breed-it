<%- include("../../../partials/farmer/farmer_nav") %>

<div class="app-root">
  <main class="container-fluid py-3 py-lg-4">

    <!-- HERO + SEARCH (KEEP ID: reproductionSearch) -->
    <div class="repro-hero card shadow-sm mb-3 mb-lg-4">
      <div class="card-body">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
          <div class="min-w-0">
            <h4 class="mb-1 repro-title">Reproduction & Monitoring Pipeline</h4>
            <div class="text-muted small">
              Manage sow cycles, monitor piglets, review performance, and handle selection — optimized for mobile and desktop.
            </div>
          </div>

          <div class="repro-search">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-white">
                <i class="bi bi-search"></i>
              </span>
              <input
                type="text"
                id="reproductionSearch"
                class="form-control"
                placeholder="Filter sows by tag or stage..."
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MAIN LAYOUT (SOW LIST ONLY; PANEL IS NOW A MODAL OVERLAY VIA JS) -->
    <div class="row g-3 g-lg-4">
      <div class="col-12">
        <div class="repro-center-wrap">
          <%- include("./sow_list") %>
        </div>
      </div>
    </div>

      <!-- NOTE:
        No panel container here.
        The sow detail panel appears in the middle using a Bootstrap modal
        generated by /js/reproduction/reproduction.ui.js
      -->
    </div>

    <!-- LEGACY IDS (HIDDEN COMPAT) -->
    <%- include("./legacy_compat") %>

  </main>
</div>

<%- include("../../../partials/farmer/farmer_footer") %>