<!-- =========================
     PIG LIST (STACKED) + PAGINATION BOTTOM
========================== -->
<section class="card repro-card border-0 shadow-sm">
  <div class="card-body">

    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
      <div class="d-flex align-items-center gap-2">
        <div class="repro-section-icon">
          <i class="bi bi-list-ul"></i>
        </div>
        <div>
          <div class="fw-bold">My Pigs</div>
          <div class="small text-muted">1 pig per row. Tap View Details to open analysis tabs.</div>
        </div>
      </div>
    </div>

    <!-- JS fills cards here -->
    <div id="pigCardsGrid" class="row g-3">
      <div class="col-12">
        <div class="card pig-card placeholder-wave border-0">
          <div class="card-body">
            <div class="d-flex gap-3 align-items-start">
              <div class="pig-avatar placeholder"></div>
              <div class="flex-grow-1">
                <div class="placeholder col-8 mb-2"></div>
                <div class="placeholder col-6 mb-2"></div>
                <div class="placeholder col-10 mb-3"></div>
                <div class="d-flex gap-2">
                  <div class="placeholder col-4"></div>
                  <div class="placeholder col-4"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="pigCardsEmpty" class="text-center text-muted py-4 d-none">
      <i class="bi bi-inboxes fs-2 d-block mb-2"></i>
      No pigs found for the current filters.
    </div>

    <!-- PAGINATION AT BOTTOM -->
    <div class="repro-pager mt-3 pt-2">
      <div class="d-flex align-items-center justify-content-center gap-2">
        <button class="btn btn-outline-secondary btn-sm" id="pigPrevPageBtn" type="button">
          <i class="bi bi-chevron-left"></i>
        </button>
        <span class="small text-muted" id="pigPageLabel">Page 1</span>
        <button class="btn btn-outline-secondary btn-sm" id="pigNextPageBtn" type="button">
          <i class="bi bi-chevron-right"></i>
        </button>
      </div>
    </div>

  </div>
</section>