<!-- =========================
     DETAILS MODAL
========================== -->
<div class="modal fade" id="pigDetailsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable repro-modal-dialog">
    <div class="modal-content repro-modal border-0">

      <!-- ================= HEADER (STICKY APP BAR) ================= -->
      <div class="modal-header repro-modal-head">
        <div class="w-100">

          <!-- Top app-bar row -->
          <div class="repro-appbar d-flex align-items-start justify-content-between gap-3">
            <div class="min-w-0">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="repro-appbar-icon flex-shrink-0">
                  <i class="bi bi-clipboard-data"></i>
                </div>

                <div class="min-w-0">
                  <h5 class="modal-title mb-0 text-truncate" id="pigDetailsTitle">Pig Analysis: —</h5>
                  <div class="small repro-appbar-sub text-truncate" id="pigDetailsSub">—</div>
                </div>

                <span class="badge rounded-pill d-none" id="pigDetailsStatusBadge">—</span>
              </div>
            </div>

            <button type="button" class="btn btn-light repro-close-btn" data-bs-dismiss="modal" aria-label="Close" title="Close">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>

          <!-- TOP-LEVEL TABS: Profile + Reproduction -->
          <div class="repro-tabsbar mt-3">
            <ul class="nav nav-pills repro-detail-tabs" id="pigDetailsTabs" role="tablist" aria-label="Pig details tabs">

              <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tabProfile"
                        data-bs-toggle="pill" data-bs-target="#paneProfile"
                        type="button" role="tab">
                  <i class="bi bi-person-badge me-2"></i>Profile
                </button>
              </li>

              <li class="nav-item" role="presentation">
                <button class="nav-link" id="tabReproduction"
                        data-bs-toggle="pill" data-bs-target="#paneReproduction"
                        type="button" role="tab">
                  <i class="bi bi-diagram-3 me-2"></i>Reproduction
                </button>
              </li>

            </ul>
          </div>

        </div>
      </div>

      <!-- ================= BODY ================= -->
      <div class="modal-body repro-modal-body">
        <div class="tab-content repro-modal-container">

          <!-- ================= PROFILE (UNCHANGED IDs) ================= -->
          <div class="tab-pane fade show active" id="paneProfile" role="tabpanel">

            <div class="card border-0 shadow-sm repro-inner-card repro-sheet">
              <div class="card-body">

                <div class="repro-sheet-head d-flex align-items-start justify-content-between gap-3 flex-wrap">
                  <div class="d-flex align-items-center gap-3 min-w-0">

                    <div class="repro-profile-avatar flex-shrink-0">
                      <img id="profilePhotoImg" class="repro-profile-avatar-img" src="" alt="Pig profile photo" />
                      <div id="profilePhotoFallback" class="repro-profile-avatar-fallback d-none">
                        <i class="bi bi-piggy-bank"></i>
                      </div>
                    </div>

                    <div class="min-w-0">
                      <div class="repro-profile-name text-truncate" id="profileTag">—</div>

                      <div class="repro-profile-subline">
                        <span class="me-2"><i class="bi bi-award me-1"></i><span id="profileBreed">—</span></span>
                        <span class="text-muted me-2">•</span>
                        <span class="me-2"><i class="bi bi-gender-ambiguous me-1"></i><span id="profileSex">—</span></span>
                        <span class="text-muted me-2">•</span>
                        <span><i class="bi bi-diagram-2 me-1"></i><span id="profileAgeStage">—</span></span>
                      </div>
                    </div>
                  </div>

                  <div class="repro-profile-status">
                    <span class="badge rounded-pill" id="profileHealth">—</span>
                  </div>
                </div>

                <div class="row g-2 g-md-3 mt-3">
                  <div class="col-12 col-sm-6 col-lg-3">
                    <div class="repro-metric repro-metric-tile">
                      <div class="repro-metric-top">
                        <i class="bi bi-activity"></i>
                        <span class="repro-metric-label">Current Status</span>
                      </div>
                      <div class="repro-metric-value" id="profileStatus">—</div>
                    </div>
                  </div>

                  <div class="col-12 col-sm-6 col-lg-3">
                    <div class="repro-metric repro-metric-tile">
                      <div class="repro-metric-top">
                        <i class="bi bi-hourglass-split"></i>
                        <span class="repro-metric-label">Age</span>
                      </div>
                      <div class="repro-metric-value" id="profileAge">—</div>
                    </div>
                  </div>

                  <div class="col-12 col-sm-6 col-lg-3">
                    <div class="repro-metric repro-metric-tile">
                      <div class="repro-metric-top">
                        <i class="bi bi-calendar-event"></i>
                        <span class="repro-metric-label">Birth Date</span>
                      </div>
                      <div class="repro-metric-value" id="profileBirthDate">—</div>
                    </div>
                  </div>

                  <div class="col-12 col-sm-6 col-lg-3">
                    <div class="repro-metric repro-metric-tile">
                      <div class="repro-metric-top">
                        <i class="bi bi-heart-pulse"></i>
                        <span class="repro-metric-label">Health</span>
                      </div>
                      <div class="repro-metric-value">
                        <span class="repro-health-text" id="profileHealthMirror">—</span>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="mt-3">
                  <div class="d-flex flex-wrap gap-2" id="profileBadges"></div>
                </div>

                <div class="repro-profile-note small text-muted mt-3">
                  <i class="bi bi-info-circle me-1"></i>
                  Profile is shown from current swine data. We can enrich this later with full DB profile fields.
                </div>

              </div>
            </div>

          </div>

          <!-- ================= REPRODUCTION (VERTICAL PLANNER) ================= -->
          <div class="tab-pane fade" id="paneReproduction" role="tabpanel">

            <!-- These two panels will be hidden when a cycle is opened -->
            <div id="reproCyclesPanelsWrap">

              <!-- Cycle Filter (top) -->
              <div class="card border-0 shadow-sm repro-inner-card repro-sheet mb-3 repro-cycles-filter-card">
                <div class="card-body">

                  <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                    <div class="min-w-0">
                      <div class="fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-layers"></i>
                        Cycles
                      </div>
                      <div class="small text-muted">
                        Select a cycle to unlock cycle details below.
                      </div>
                    </div>

                    <!-- filter controls -->
                    <div class="repro-cycle-controls d-flex align-items-end gap-2 flex-wrap">
                      <div class="min-w-0 repro-cycle-selectwrap">
                        <label class="form-label small mb-1">Cycle Filter</label>
                        <select class="form-select form-select-sm" id="aiCycleSelect">
                          <option value="">All cycles</option>
                        </select>
                      </div>

                      <button class="btn btn-outline-secondary btn-sm repro-cycle-refresh" type="button" id="aiRefreshBtn" title="Refresh cycles">
                        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                      </button>
                    </div>
                  </div>

                </div>
              </div>

              <!-- Cycle Cards List (middle) -->
              <div class="card border-0 shadow-sm repro-inner-card repro-sheet mb-3 repro-cycles-list-card">
                <div class="card-body">

                  <div class="d-flex align-items-center justify-content-between gap-2 mb-3 flex-wrap">
                    <div class="fw-bold d-flex align-items-center gap-2">
                      <i class="bi bi-collection"></i>
                      Cycle List
                    </div>
                    <div class="small text-muted">
                      Tap <b>Open Cycle</b> to view details.
                    </div>
                  </div>

                  <div id="aiEmpty" class="text-center text-muted py-4 d-none">
                    <i class="bi bi-archive fs-2 d-block mb-2"></i>
                    No cycles found for this sow.
                  </div>

                  <div class="repro-cycle-list d-flex flex-column gap-2" id="aiCycleCards">
                    <div class="card border-0 shadow-sm repro-inner-card">
                      <div class="card-body text-muted small">
                        Loading cycles...
                      </div>
                    </div>
                  </div>

                </div>
              </div>

            </div>

            <!-- Cycle Details (bottom) -->
            <div class="card border-0 shadow-sm repro-inner-card repro-sheet" id="reproCycleDetailsPanel">
              <div class="card-body">

                <!-- Placeholder (shown until cycle picked) -->
                <div id="reproInnerPlaceholder" class="repro-placeholder text-muted small">
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-hand-index-thumb"></i>
                    <span>Select a cycle above to reveal cycle tabs and details.</span>
                  </div>
                </div>

                <!-- Inner tabs (hidden until cycle picked) -->
                <div class="d-none" id="reproInnerTabsWrap">

                  <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-3">
                    <div class="fw-bold d-flex align-items-center gap-2">
                      <i class="bi bi-ui-checks"></i>
                      Cycle Details
                    </div>

                    <div class="d-flex align-items-center gap-2">
                      <span class="badge rounded-pill text-bg-secondary d-none" id="aiAnalysisStatusBadge">—</span>

                      <!-- NEW: close cycle details panel (does not replace any existing ID) -->
                      <button type="button" class="btn btn-outline-secondary btn-sm" id="reproCloseCycleBtn">
                        <i class="bi bi-x-lg me-1"></i>Close
                      </button>
                    </div>
                  </div>

                  <div class="repro-inner-tabsbar mb-3">
                    <ul class="nav nav-pills repro-detail-tabs" id="reproInnerTabs" role="tablist" aria-label="Cycle detail tabs">

                      <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tabAI"
                                data-bs-toggle="pill" data-bs-target="#paneAI"
                                type="button" role="tab">
                          <i class="bi bi-droplet me-2"></i>Artificial Insemination Record
                        </button>
                      </li>

                      <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tabPiglets"
                                data-bs-toggle="pill" data-bs-target="#panePiglets"
                                type="button" role="tab">
                          <i class="bi bi-graph-up-arrow me-2"></i>Piglets Growth Records
                        </button>
                      </li>

                      <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tabHealth"
                                data-bs-toggle="pill" data-bs-target="#paneHealth"
                                type="button" role="tab">
                          <i class="bi bi-shield-check me-2"></i>Health &amp; Defects
                        </button>
                      </li>

                      <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tabSelection"
                                data-bs-toggle="pill" data-bs-target="#paneSelection"
                                type="button" role="tab">
                          <i class="bi bi-check2-circle me-2"></i>Selection Status
                        </button>
                      </li>

                    </ul>
                  </div>

                  <!-- Inner panes (UNCHANGED IDs) -->
                  <div class="tab-content">

                    <div class="tab-pane fade show active" id="paneAI" role="tabpanel">
                      <div class="card border-0 repro-soft-panel">
                        <div class="card-body">

                          <div id="aiAnalysisPlaceholder" class="text-muted small">
                            Select a cycle then click <b>Open Cycle</b> to view AI analysis.
                          </div>

                          <div id="aiAnalysisContent" class="d-none">
                            <div class="row g-2">
                              <div class="col-12 col-md-6">
                                <div class="profile-field">
                                  <div class="label">Cycle</div>
                                  <div class="value" id="aiCycleLabel">—</div>
                                </div>
                              </div>
                              <div class="col-12 col-md-6">
                                <div class="profile-field">
                                  <div class="label">Date Started</div>
                                  <div class="value" id="aiDateStarted">—</div>
                                </div>
                              </div>

                              <div class="col-12 col-md-6">
                                <div class="profile-field">
                                  <div class="label">Sow Metrics (during period)</div>
                                  <div class="value" id="aiSowMetrics">—</div>
                                </div>
                              </div>
                              <div class="col-12 col-md-6">
                                <div class="profile-field">
                                  <div class="label">Current Stage (period)</div>
                                  <div class="value" id="aiPeriodStage">—</div>
                                </div>
                              </div>

                              <div class="col-12">
                                <div class="card border-0 ai-subcard">
                                  <div class="card-body">
                                    <div class="fw-semibold mb-2">
                                      <i class="bi bi-gender-male me-1"></i> Boar Info
                                    </div>
                                    <div class="row g-2">
                                      <div class="col-12 col-md-6">
                                        <div class="profile-field">
                                          <div class="label">Boar Tag/ID</div>
                                          <div class="value" id="aiBoarTag">—</div>
                                        </div>
                                      </div>
                                      <div class="col-12 col-md-6">
                                        <div class="profile-field">
                                          <div class="label">Boar Breed</div>
                                          <div class="value" id="aiBoarBreed">—</div>
                                        </div>
                                      </div>
                                      <div class="col-12 col-md-6">
                                        <div class="profile-field">
                                          <div class="label">Semen Batch/Source</div>
                                          <div class="value" id="aiBoarBatch">—</div>
                                        </div>
                                      </div>
                                      <div class="col-12 col-md-6">
                                        <div class="profile-field">
                                          <div class="label">AI Date</div>
                                          <div class="value" id="aiDate">—</div>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </div>

                            </div>
                          </div>

                        </div>
                      </div>
                    </div>

                    <div class="tab-pane fade" id="panePiglets" role="tabpanel">
                      <div id="pigletsGrowthWrap" class="card border-0 shadow-sm repro-inner-card repro-sheet">
                        <div class="card-body">
                          <div class="d-flex align-items-center justify-content-between gap-2 mb-3 flex-wrap">
                            <div>
                              <div class="fw-bold d-flex align-items-center gap-2">
                                <i class="bi bi-bar-chart-line"></i>
                                Piglets Growth Records
                              </div>
                              <div class="small text-muted">Growth measurements per litter.</div>
                            </div>

                            <button type="button" class="btn btn-outline-secondary btn-sm" id="pigletsGrowthRefreshBtn">
                              <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                            </button>
                          </div>

                          <div id="pigletsGrowthTableHost">
                            <div class="text-muted small">Loading piglets growth records...</div>
                          </div>

                          <div id="pigletsGrowthEmpty" class="text-center text-muted py-3 d-none">
                            <i class="bi bi-inboxes fs-3 d-block mb-2"></i>
                            No piglets growth records found for this sow.
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="tab-pane fade" id="paneHealth" role="tabpanel">
                      <div class="card border-0 shadow-sm repro-inner-card repro-sheet">
                        <div class="card-body text-muted small">
                          Next: Health &amp; Defects (cycle-based).
                        </div>
                      </div>
                    </div>

                    <div class="tab-pane fade" id="paneSelection" role="tabpanel">
                      <div class="card border-0 shadow-sm repro-inner-card repro-sheet">
                        <div class="card-body text-muted small">
                          Next: Selection Status (cycle-based).
                        </div>
                      </div>
                    </div>

                  </div>

                </div>

              </div>
            </div>

          </div>

        </div>
      </div>

      <!-- ================= FOOTER ================= -->
      <div class="modal-footer repro-modal-foot">
        <div class="w-100 d-flex align-items-center justify-content-end gap-2">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i>Close
          </button>
        </div>
      </div>

    </div>
  </div>
</div>