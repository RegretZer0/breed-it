<form id="heatReportForm" class="form-card" novalidate>

  <!-- ================= GENERAL ================= -->
  <div class="form-section">
    <h4>General Information</h4>

    <!-- KEEP THIS for compatibility (older code expects #swineSelect) -->
    <select id="swineSelect" disabled hidden>
      <option value="">Loading your swine...</option>
    </select>

    <!-- IMPORTANT: This is what the JS actually uses -->
    <input type="hidden" id="selectedSwineId" />

    <!-- Picker trigger (shown when no pig selected) -->
    <div id="pickPigTriggerWrap">
      <label class="mb-2 d-block">Select Pig</label>

      <button type="button" class="btn-soft" id="openPigPickerBtn">
        <i class="bi bi-search"></i>
        Select a Pig
      </button>

      <small class="hint-text d-block mt-2">
        Only sows with <b>Open</b> status are selectable.
      </small>
    </div>

    <!-- Selected pig card (shown after selecting) -->
    <div id="selectedPigWrap" class="selected-pig-wrap hidden">
      <label class="mb-2 d-block">Selected Pig</label>

      <!-- JS injects the selected card here -->
      <div id="selectedPigCard"></div>
    </div>
  </div>


  <!-- ================= HEAT SIGNS ================= -->
  <div class="form-section">
    <h4>Observed Heat Signs</h4>
      <div class="heat-chips" id="heatSignsContainer">
        <!-- dynamic signs will render here -->
      </div>

        <!-- ================= HEAT PROBABILITY BAR ================= -->
        <div id="heatProbabilityWrap" style="margin: 16px 0;">
          <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
            <strong>Probability</strong>
            <span id="heatProbabilityValue">0%</span>
          </div>

          <div style="
            width:100%;
            height:10px;
            background:#e5e7eb;
            border-radius:8px;
            overflow:hidden;
          ">
            <div id="heatProbabilityBar" style="
              height:100%;
              width:0%;
              background:linear-gradient(90deg,#22c55e,#16a34a);
              transition:width 0.3s ease;
            "></div>
          </div>
        </div>
    <small class="hint-text">Select all that apply</small>
  </div>



  <!-- ================= REMARKS ================= -->
  <div class="form-section">
    <h4>Remarks</h4>

    <label for="remarks">Optional Notes</label>
    <textarea
      id="remarks"
      name="remarks"
      rows="3"
      placeholder="Add additional observations (optional)"
    ></textarea>

    <small class="hint-text">
      This will be included when the report is submitted.
    </small>
  </div>


  <!-- ================= UPLOAD EVIDENCE ================= -->
  <div class="form-section">
    <h4>Upload Evidence</h4>

    <div class="upload-box">

      <!-- IMPORTANT FIX:
           remove "required" because the input is hidden (browser can't focus it when invalid).
           validate in JS instead (you already require files in backend). -->
      <input
        type="file"
        id="evidence"
        name="evidence"
        accept="image/*,video/*"
        multiple
        hidden
      />

      <button type="button" class="upload-btn" id="uploadBtn">
        <i class="fa-solid fa-plus"></i>
      </button>

      <span id="fileCountBadge" class="file-counter-badge"></span>

      <div id="mediaPreview"></div>

      <small class="hint-text">
        Upload clear photos or videos (maximum 5 files)
      </small>

    </div>
  </div>


  <!-- ================= ACTIONS ================= -->
  <div class="form-actions">
    <button type="button" class="cancel-btn" id="cancelCreate">
      CANCEL
    </button>

    <button type="submit" class="btn-submit send-btn">
      SEND REPORT
    </button>
  </div>

  <p id="reportMessage"></p>

</form>


<!-- =====================================================
     PIG PICKER PANEL (Overlay / Modal-like)
===================================================== -->
<div id="pigPickerPanel" class="pig-picker-panel hidden" aria-hidden="true">

  <div class="pig-picker-card" role="dialog" aria-modal="true" aria-label="Select a Pig">

    <!-- Header -->
    <div class="pig-picker-header">
      <div class="picker-title">
        <i class="bi bi-list-check"></i>
        <span>Select an Open Sow</span>
      </div>

      <button type="button" class="picker-close" id="closePigPickerBtn" aria-label="Close picker">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <!-- Search row -->
    <div class="pig-picker-controls">
      <div class="picker-search">
        <i class="bi bi-tag"></i>
        <input
          type="text"
          id="pigPickerSearchInput"
          placeholder="Search by ID / breed / tag..."
          autocomplete="off"
        />
      </div>

      <button type="button" class="btn-soft" id="pigPickerSearchBtn">
        <i class="bi bi-search"></i>
        Search
      </button>
    </div>

    <small class="hint-text" style="margin-top:8px;">
      Showing available sows currently in <b>Open status</b>.
    </small>

    <!-- List -->
    <div id="pigPickerList" class="pig-picker-list" aria-live="polite">
      <div class="empty-state">Loading available sows...</div>
    </div>

    <!-- Pagination -->
    <div id="pigPickerPagination" class="picker-pagination"></div>

  </div>
</div>