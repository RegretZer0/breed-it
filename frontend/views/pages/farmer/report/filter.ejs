<!-- ================= STATS ================= -->
<div class="stats-container">

  <div class="stat-card">
    <div class="stat-icon">
      <i class="bi bi-piggy-bank"></i>
    </div>
    <div>
      <h4>Open Sows</h4>
      <span id="countOpen">0</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon">
      <i class="bi bi-heart-pulse"></i>
    </div>
    <div>
      <h4>In-Heat</h4>
      <span id="countInHeat">0</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon">
      <i class="bi bi-search"></i>
    </div>
    <div>
      <h4>Under Observation</h4>
      <span id="countObservation">0</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon">
      <i class="bi bi-clipboard2-pulse"></i>
    </div>
    <div>
      <h4>Pregnant</h4>
      <span id="countPregnant">0</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon">
      <i class="bi bi-calendar-heart"></i>
    </div>
    <div>
      <h4>Farrowing</h4>
      <span id="countFarrowing">0</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon">
      <i class="bi bi-egg-fried"></i>
    </div>
    <div>
      <h4>Lactating</h4>
      <span id="countLactating">0</span>
    </div>
  </div>

</div>

<!-- ================= STATUS + FILTER (ONE BAR) ================= -->
<div class="filter-bar-card">

  <!-- LEFT: Approval Status Tabs -->
  <div class="status-tabs">
    <button class="status-tab active" data-status="">All</button>
    <button class="status-tab" data-status="pending">Pending</button>
    <button class="status-tab" data-status="approved">Approved</button>
    <button class="status-tab" data-status="rejected">Rejected</button>
  </div>

  <!-- RIGHT: Filter Controls -->
  <div class="filter-controls">
    <div class="filter filter-search">
      <label>Search by Tag</label>
      <input type="text" id="tagSearchInput" placeholder="Search tag..." />
    </div>

    <div class="filter filter-status">
      <label>Stage</label>
      <select id="statusFilter">
        <option value="">All</option>
        <option value="open">Open</option>
        <option value="in_heat">In-Heat</option>
        <option value="under_observation">Under Observation</option>
        <option value="pregnant">Pregnant</option>
        <option value="farrowing">Farrowing</option>
        <option value="lactating">Lactating</option>
      </select>
    </div>

    <button class="search-btn btn-apply" id="searchBtn" type="button">
      <i class="bi bi-funnel"></i>
      Apply
    </button>

    <button class="search-btn btn-reset" id="clearFilterBtn" type="button">
      <i class="bi bi-x-circle"></i>
      Reset
    </button>
  </div>

</div>