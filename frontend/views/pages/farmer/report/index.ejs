<%- include("../../../partials/farmer/farmer_nav") %>

<div class="app-root">
  <main class="report-container">

    <!-- ================= MODULE: PAGE HEADER (TITLE CARD) ================= -->
    <header class="title-card" id="moduleTitleCard">
      <h2 class="title-main" id="moduleTitleMain">REPORT - HEAT MONITORING</h2>
      <p class="title-sub" id="moduleTitleSub">Track breeding cycle & pregnancy progress</p>
    </header>

    <!-- ================= MODULE: TABS ================= -->
    <div class="report-tabs">
      <button class="tab active" id="logsTab">LOGS</button>
      <button class="tab outline" id="createTab">CREATE REPORT</button>

      <!-- ARCHIVE BUTTON (NEW) -->
      <!-- Placed in the same row as tabs; will wrap nicely on small screens via CSS -->
      <button class="tab outline ms-auto" id="openArchiveBtn" type="button" title="View archived reports">
        <span>ARCHIVE</span>
      </button>
    </div>

    <!-- ================= MODULE: LOGS SECTION ================= -->
    <section id="logsSection">

      <!-- MODULE: LOGS FILTERS -->
      <div class="logs-controls">
        <%- include("./filter") %>
      </div>

      <!-- MODULE: LOGS REPORT LIST -->
      <div id="reportsTableBody" class="reports-list reports-card-list">
        <div class="empty-state">
          Checking for active reports...
        </div>
      </div>

      <!-- MODULE: PAGINATION (UNDER LAST CARD) -->
      <div id="reportsPagination" class="reports-pagination"></div>

    </section>

    <!-- ================= MODULE: CREATE SECTION ================= -->
    <section id="createSection" class="hidden">

      <!-- MODULE: CREATE FORM -->
      <%- include("./create-form") %>

    </section>

  </main>
</div>

<!-- ================= MODULE: MODALS ================= -->
<%- include("./modal") %>
<%- include("./edit-modal") %>

<%- include("../../../partials/farmer/farmer_footer") %>