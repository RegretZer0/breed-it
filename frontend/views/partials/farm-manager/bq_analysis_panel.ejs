<!-- Header card -->
<div class="card page-card bq-panel-card mb-3">
  <div class="card-body">

    <h4 class="page-title d-flex align-items-center gap-2 mb-0">
      <i class="bi bi-graph-up-arrow"></i>
      BREED QUALITY ANALYTICS
    </h4>

    <div
      class="tabs-row mt-3 d-flex flex-wrap gap-3"
      role="tablist"
      aria-label="Breed quality analytics sections"
    >
      <!-- SWINE ANALYSIS -->
      <a
        href="/farm-manager/breed-quality-analytics/swine-analysis"
        class="tab-btn <%= current_page === 'swine_analysis' ? 'active' : '' %>"
        role="tab"
        aria-selected="<%= current_page === 'swine_analysis' ? 'true' : 'false' %>"
        aria-current="<%= current_page === 'swine_analysis' ? 'page' : 'false' %>"
      >
        <i class="bi bi-trophy"></i>
        Breed Quality Ranking
      </a>

      <!-- HBE ANALYSIS -->
      <a
        href="/farm-manager/breed-quality-analytics/HBE-analysis"
        class="tab-btn <%= current_page === 'HBE_analysis' ? 'active' : '' %>"
        role="tab"
        aria-selected="<%= current_page === 'HBE_analysis' ? 'true' : 'false' %>"
        aria-current="<%= current_page === 'HBE_analysis' ? 'page' : 'false' %>"
      >
        <i class="bi bi-activity"></i>
        Heat and Breeding Analytics
      </a>
    </div>

  </div>
</div>