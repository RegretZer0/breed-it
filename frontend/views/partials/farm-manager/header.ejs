  <script>
    /**
     * Synchronizes the UI with the Virtual Time Warp offset
     */
    function initVirtualClock() {
      const clockEl = document.getElementById('globalVirtualClock');
      const containerEl = document.getElementById('virtualClockContainer');
      if (!clockEl) return;

      function updateClock() {
        // Read offset set by Admin Teleport tool
        const offset = parseInt(localStorage.getItem('timeWarpOffset') || "0");
        
        // Calculate Virtual "Now"
        const virtualNow = new Date(Date.now() + offset);

        const options = { 
          year: 'numeric', 
          month: 'short', 
          day: '2-digit',
          hour: '2-digit', 
          minute: '2-digit', 
          second: '2-digit',
          hour12: true 
        };

        clockEl.textContent = virtualNow.toLocaleString('en-US', options);

        // Visual feedback if time is warped
        if (offset !== 0) {
          clockEl.style.color = "#dc3545"; // Bootstrap Danger Red
          containerEl.style.borderColor = "#dc3545";
          containerEl.style.background = "#fff5f5";
        } else {
          clockEl.style.color = "#212529";
          containerEl.style.borderColor = "#e2e8f0";
          containerEl.style.background = "#f8fafc";
        }
      }

      setInterval(updateClock, 1000);
      updateClock();
    }

    document.addEventListener('DOMContentLoaded', initVirtualClock);
  </script>
</head>
<body>

  <div class="container-fluid py-2 border-bottom" style="background-color: #f8fafc;">
    <div class="d-flex justify-content-end">
      <div id="virtualClockContainer" class="d-flex align-items-center gap-2 px-3 py-1 rounded border shadow-sm transition-all" 
           style="background: #f8fafc; border: 1px solid #e2e8f0;">
        <div class="d-flex flex-column text-end">
          <span class="text-uppercase fw-bold text-muted" style="font-size: 0.6rem; letter-spacing: 0.05rem;">
            <i class="bi bi-clock-history"></i> Virtual Server Time
          </span>
          <span id="globalVirtualClock" class="fw-bold" style="font-size: 0.9rem; font-family: 'Courier New', monospace;">
            Loading...
          </span>
        </div>
      </div>
    </div>
  </div>