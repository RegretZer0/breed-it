<!-- Sidebar -->
<aside class="sidebar d-flex flex-column" id="sidebar">

  <!-- Close icon inside sidebar (mobile) -->
  <!-- <div class="sidebar-close-wrap d-lg-none">
    <button
      id="sidebarCloseBtn"
      class="sidebar-close-btn"
      aria-label="Close sidebar"
      type="button"
    >
      <i class="bi bi-x-lg"></i>
    </button>
  </div> -->

  <!-- Brand (optional, compact like the reference) -->
  <div class="sidebar-brand px-2 mb-2 d-none d-lg-flex align-items-center gap-2">
    <div class="sidebar-brand-mark">
      <i class="bi bi-grid-1x2-fill"></i>
    </div>
    <div class="sidebar-brand-text">
      <div class="sidebar-brand-title">BREED-IT</div>
      <div class="sidebar-brand-sub">Farm Manager</div>
    </div>
  </div>

  <nav class="nav flex-column w-100 px-2 sidebar-nav">

      <!-- DASHBOARD -->
      <a
        href="/farm-manager/dashboard/"
        class="nav-link <%= current_page === 'dashboard' ? 'active' : '' %>"
        data-bs-toggle="tooltip"
        data-bs-placement="right"
        title="Dashboard"
      >
        <span class="nav-ic" aria-hidden="true"><i class="bi bi-speedometer2"></i></span>
        <span class="nav-tx">Dashboard</span>
      </a>

      <!-- PIG MANAGEMENT -->
      <a
        href="/farm-manager/pig-management/swine-list"
        class="nav-link <%= current_section === 'pig_management' ? 'active' : '' %>"
        data-bs-toggle="tooltip"
        data-bs-placement="right"
        title="Swine Management"
      >
        <span class="nav-ic" aria-hidden="true"><i class="bi bi-house-heart"></i></span>
        <span class="nav-tx">Swine Management</span>
      </a>

      <!-- REPORTS -->
      <a
        href="/farm-manager/heat-reports/index"
        class="nav-link <%= current_page === 'reports' ? 'active' : '' %>"
        data-bs-toggle="tooltip"
        data-bs-placement="right"
        title="Heat Reports Verification"
      >
        <span class="nav-ic" aria-hidden="true"><i class="bi bi-clipboard-check"></i></span>
        <span class="nav-tx">Heat Reports</span>
      </a>

      <!-- REPRODUCTION MONITORING -->
      <a
        href="/farm-manager/reproduction-monitoring/index"
        class="nav-link <%= current_page === 'reproduction_monitoring' ? 'active' : '' %>"
        data-bs-toggle="tooltip"
        data-bs-placement="right"
        title="Reproduction Monitoring"
      >
        <span class="nav-ic" aria-hidden="true"><i class="bi bi-calendar2-week"></i></span>
        <span class="nav-tx">Reproduction Monitoring</span>
      </a>

      <!-- SWINE ANALYSIS -->
      <a
        href="/farm-manager/breed-quality-analytics/swine-analysis"
        class="nav-link <%= current_page === 'swine_analysis' ? 'active' : '' %>"
        data-bs-toggle="tooltip"
        data-bs-placement="right"
        title="Breed Quality Analytics"
      >
        <span class="nav-ic" aria-hidden="true"><i class="bi bi-activity"></i></span>
        <span class="nav-tx">Breed Quality Analytics</span>
      </a>

      <!-- ACCOUNT MANAGEMENT -->
      <% if (user?.role === "farm_manager") { %>
        <a
          href="/farm-manager/user-management/manage"
          class="nav-link <%= current_section === 'user_management' ? 'active' : '' %>"
          data-bs-toggle="tooltip"
          data-bs-placement="right"
          title="Account Management"
        >
          <span class="nav-ic" aria-hidden="true"><i class="bi bi-person-gear"></i></span>
          <span class="nav-tx">Account Management</span>
        </a>
      <% } %>

        <!-- SYSTEM SETTINGS -->
      <% if (user?.role === "farm_manager") { %>
        <a
          href="/farm-manager/system-settings/index"
          class="nav-link <%= current_section === 'system_settings' ? 'active' : '' %>"
          data-bs-toggle="tooltip"
          data-bs-placement="right"
          title="System Settings"
        >
          <span class="nav-ic" aria-hidden="true"><i class="bi bi-gear"></i></span>
          <span class="nav-tx">System Settings</span>
        </a>
      <% } %>

  </nav>

  <!-- Bottom helper area (optional) -->
  <div class="sidebar-foot mt-auto px-2 pb-2 d-none d-lg-block">
    <div class="sidebar-foot-card">
      <div class="sidebar-foot-title">Tip</div>
      <div class="sidebar-foot-text">Use the sidebar to jump between modules quickly.</div>
    </div>
  </div>

</aside>

<!-- Overlay for small-screen sidebar -->
<div id="overlay" class="overlay d-none"></div>