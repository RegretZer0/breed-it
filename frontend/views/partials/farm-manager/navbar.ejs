<!-- Topbar -->
<header class="topbar d-flex align-items-center">
  <div class="container-fluid d-flex align-items-center px-3">

    <!-- Left -->
    <div class="d-flex align-items-center top-left flex-shrink-0">
      <!-- Burger icon -->
      <button
        type="button"
        id="burgerBtn"
        class="burger-btn me-2 d-lg-none"
        aria-label="Open sidebar"
      >
        <i class="bi bi-list"></i>
      </button>

      <img
        src="../../images/logo.png"
        alt="Breed-it logo"
        class="brand-logo"
      />
      <div class="brand-text ms-2">BREED-IT</div>
    </div>

    <!-- Right -->
    <div class="ms-auto d-flex align-items-center gap-2 top-icons">

      <!-- Notifications -->
      <button
        type="button"
        class="icon-btn"
        title="Notifications"
        data-bs-toggle="offcanvas"
        data-bs-target="#notificationsPanel"
      >
        <i class="bi bi-bell"></i>
      </button>

      <!-- Settings -->
      <button
        type="button"
        class="icon-btn"
        title="Settings"
        data-bs-toggle="offcanvas"
        data-bs-target="#settingsPanel"
      >
        <i class="bi bi-gear"></i>
      </button>

      <!-- User dropdown -->
      <div class="dropdown">
        <button
          type="button"
          class="icon-btn dropdown-toggle"
          id="userDropdown"
          data-bs-toggle="dropdown"
          aria-expanded="false"
          title="User"
        >
          <i class="bi bi-person-circle"></i>
        </button>

        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
          <li>
            <button
              type="button"
              class="dropdown-item"
              id="accountSettingsBtn"
              data-bs-toggle="modal"
              data-bs-target="#accountSettingsModal"
            >
              Account Settings
            </button>
          </li>

          <li>
            <button
              type="button"
              class="dropdown-item"
              id="helpBtn"
              data-bs-toggle="modal"
              data-bs-target="#helpModal"
            >
              Help
            </button>
          </li>

          <li><hr class="dropdown-divider" /></li>

          <li>
            <button
              type="button"
              class="dropdown-item text-danger"
              id="logoutBtn"
            >
              Logout
            </button>
          </li>
        </ul>
      </div>

    </div>
  </div>
</header>

<!-- App shell -->
<div class="app-shell">