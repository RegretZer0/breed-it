<!-- Topbar -->
<header class="topbar d-flex align-items-center">
  <div class="container-fluid d-flex align-items-center px-3">

    <!-- Left -->
    <div class="d-flex align-items-center top-left flex-shrink-0">
      <!-- Burger icon -->
      <button
        type="button"
        id="burgerBtn"
        class="burger-btn me-2 d-lg-none"
        aria-label="Open sidebar"
      >
        <i class="bi bi-list"></i>
      </button>

      <img
        src="../../images/logo.png"
        alt="Breed-it logo"
        class="brand-logo"
      />
      <div class="brand-text ms-2">BREED-IT</div>
    </div>

    <!-- Right -->
    <div class="ms-auto d-flex align-items-center gap-2 top-icons">

      <!-- Notifications -->
      <button
        type="button"
        class="icon-btn position-relative"
        title="Notifications"
        data-bs-toggle="offcanvas"
        data-bs-target="#notificationsPanel"
        aria-controls="notificationsPanel"
      >
        <i class="bi bi-bell"></i>

        <!-- JS expects this ID -->
        <span
          id="notificationBadge"
          class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
          style="display:none;"
        >
          <span class="visually-hidden">unread notifications</span>
        </span>
      </button>

      <!-- User dropdown -->
      <div class="dropdown">
        <button
          type="button"
          class="icon-btn dropdown-toggle"
          id="userDropdown"
          data-bs-toggle="dropdown"
          aria-expanded="false"
          title="User"
        >
          <i class="bi bi-person-circle"></i>
        </button>

        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
          <li>
            <button
              type="button"
              class="dropdown-item"
              id="accountSettingsBtn"
              data-bs-toggle="modal"
              data-bs-target="#accountSettingsModal"
            >
              Account Settings
            </button>
          </li>

          <li>
            <button
              type="button"
              class="dropdown-item"
              id="helpBtn"
              data-bs-toggle="modal"
              data-bs-target="#helpModal"
            >
              Help
            </button>
          </li>

          <li><hr class="dropdown-divider" /></li>

          <li>
            <button
              type="button"
              class="dropdown-item text-danger"
              id="logoutBtn"
            >
              Logout
            </button>
          </li>
        </ul>
      </div>

    </div>
  </div>
</header>

<!-- =======================
     NOTIFICATIONS PANEL (OFFCANVAS)
======================= -->
<div
  class="offcanvas offcanvas-end"
  tabindex="-1"
  id="notificationsPanel"
  aria-labelledby="notificationsPanelLabel"
>
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="notificationsPanelLabel">Recent Notifications</h5>
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-success btn-sm flex-fill" id="markAllNotificationsReadBtn" type="button">Mark all read</button>
        <button class="btn-close" type="button" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
  </div>

  <div class="offcanvas-body">
    <!-- JS injects items here -->
    <div id="notificationsList" class="list-group list-group-flush small">
      <div class="text-muted small py-2">Loading notifications…</div>
    </div>

    <div class="text-center mt-3">
      <button class="btn btn-outline-secondary btn-sm" id="viewAllNotificationsBtn">
        View All Notifications
      </button>
    </div>
  </div>
</div>

 <!-- =======================
     NOTIFICATION HISTORY MODAL
  ======================= -->
  <div class="modal fade" id="notificationHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
      <div class="modal-content">

        <div class="modal-header">
          <h5 class="modal-title">Notification History</h5>
          <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-success btn-sm" id="markAllNotificationsReadBtnModal">
              Mark all read
            </button>
            <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
        </div> <!-- CLOSE MODAL HEADER -->

        <div class="modal-body">

          <!-- Filters -->
          <div class="d-flex flex-wrap gap-2 mb-3">
            <select class="form-select form-select-sm w-auto" id="notifFilterType">
              <option value="">All Types</option>
              <option value="info">Info</option>
              <option value="success">Success</option>
              <option value="alert">Alert</option>
              <option value="error">Error</option>
              <option value="maintenance">Maintenance</option>
            </select>

            <select class="form-select form-select-sm w-auto" id="notifFilterTime">
              <option value="">All Time</option>
              <option value="24h">Last 24 hours</option>
              <option value="7d">Last 7 days</option>
              <option value="30d">Last 30 days</option>
            </select>
          </div>

          <!-- Pagination -->
          <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="notifPrevPageBtn">
              <i class="bi bi-chevron-left"></i>
              Prev
            </button>

            <div class="small text-muted fw-semibold" id="notifPageLabel">Page 1 / 1</div>

            <button type="button" class="btn btn-outline-secondary btn-sm" id="notifNextPageBtn">
              Next
              <i class="bi bi-chevron-right"></i>
            </button>
          </div>

          <!-- JS injects history here -->
          <div class="list-group list-group-flush" id="notificationHistoryList">
            <div class="text-muted small py-2">Loading notifications…</div>
          </div>

        </div>

      </div>
    </div>
  </div>

<!-- =======================
     ACCOUNT SETTINGS MODAL
======================= -->
<div class="modal fade" id="accountSettingsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
    <div class="modal-content acct-shell">

      <!-- HEADER -->
      <div class="modal-header acct-header">
        <div class="d-flex align-items-center gap-2">
          <span class="acct-ic"><i class="bi bi-gear"></i></span>
          <div class="min-w-0">
            <h5 class="modal-title mb-0 text-truncate">Account Settings</h5>
            <div class="small text-muted">Update your profile information and preferences</div>
          </div>
        </div>

        <button class="btn-close acct-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- BODY -->
      <div class="modal-body acct-body">

        <!-- TOP PROFILE STRIP -->
        <div class="acct-top card border-0 mb-3">
          <div class="card-body acct-top-body d-flex flex-wrap align-items-center justify-content-between gap-3">

            <div class="d-flex align-items-center gap-3">
              <img
                id="accountAvatarPreviewTop"
                src="<%= (user && user.profile_photo) ? user.profile_photo : '/images/default-avatar.png' %>"
                alt="Profile"
                class="acct-avatar"
                onerror="this.src='/images/default-avatar.png';"
              />

              <div class="min-w-0">
                <div class="acct-name text-truncate"><%= user?.name || '—' %></div>
                <div class="acct-meta d-flex flex-wrap gap-2 small">
                  <span class="acct-meta-item">
                    <i class="bi bi-envelope"></i>
                    <span class="text-truncate"><%= user?.email || '—' %></span>
                  </span>
                  <span class="acct-meta-item">
                    <i class="bi bi-shield-check"></i>
                    <span><%= user?.role || '—' %></span>
                  </span>
                </div>
              </div>
            </div>

            <div class="d-flex align-items-center gap-2">
              <button type="button" class="btn btn-outline-success acct-pill-btn" id="editAccountProfileBtn">
                <i class="bi bi-pencil-square me-1"></i>
                Edit Profile
              </button>
            </div>

          </div>
        </div>

        <div class="row g-3">

          <!-- LEFT: PHOTO -->
          <div class="col-12 col-lg-4">
            <div class="acct-card h-100">
              <div class="acct-card-head">
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-image"></i>
                  <span class="fw-black">Profile Photo</span>
                </div>
                <span class="badge acct-badge">Global</span>
              </div>

              <div class="acct-card-body">
                <div class="d-flex gap-2 flex-wrap">
                  <input
                    type="file"
                    class="form-control acct-control"
                    id="accountProfilePhoto"
                    accept="image/*"
                  />
                </div>

                <div class="small text-muted mt-2">
                  Recommended: square image. Max ~2MB.
                </div>

                <div class="acct-photo-preview mt-3">
                  <img
                    id="accountAvatarPreview"
                    src="<%= (user && user.profile_photo) ? user.profile_photo : '/images/default-avatar.png' %>"
                    alt="Profile preview"
                    onerror="this.src='/images/default-avatar.png';"
                  />
                </div>

                <div class="d-flex justify-content-between align-items-center gap-2 mt-3">
                  <button type="button" class="btn btn-outline-secondary acct-btn" id="accountPhotoResetBtn" disabled>
                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    Reset
                  </button>

                  <button type="button" class="btn btn-success acct-btn" id="accountPhotoUploadBtn" disabled>
                    <i class="bi bi-cloud-arrow-up me-1"></i>
                    Upload
                  </button>
                </div>

                <div class="acct-footnote small text-muted mt-2">
                  Photo works for <b>farm_manager</b> & <b>encoder</b>.
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT: DETAILS -->
          <div class="col-12 col-lg-8">
            <div class="acct-card">
              <div class="acct-card-head">
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-person-lines-fill"></i>
                  <span class="fw-black">Profile Information</span>
                </div>
              </div>

              <div class="acct-card-body">
                <!-- IMPORTANT: keep IDs if your JS already uses them; if not, these are safe NEW IDs -->
                <form id="accountSettingsForm" autocomplete="off">

                  <div class="row g-3">
                    <div class="col-12 col-md-6">
                      <label class="form-label acct-label">First Name</label>
                      <input
                        type="text"
                        class="form-control acct-control"
                        id="accountFirstName"
                        value="<%= user?.first_name || '' %>"
                        readonly
                        required
                      />
                    </div>

                    <div class="col-12 col-md-6">
                      <label class="form-label acct-label">Last Name</label>
                      <input
                        type="text"
                        class="form-control acct-control"
                        id="accountLastName"
                        value="<%= user?.last_name || '' %>"
                        readonly
                        required
                      />
                    </div>

                    <div class="col-12">
                      <label class="form-label acct-label">Address</label>
                      <input
                        type="text"
                        class="form-control acct-control"
                        id="accountAddress"
                        value="<%= user?.address || '' %>"
                        readonly
                      />
                    </div>

                    <div class="col-12 col-md-6">
                      <label class="form-label acct-label">Contact</label>
                      <input
                        type="text"
                        class="form-control acct-control"
                        id="accountContact"
                        value="<%= user?.contact_info || '' %>"
                        readonly
                      />
                    </div>

                    <div class="col-12 col-md-6">
                      <label class="form-label acct-label">Email</label>
                      <input
                        type="email"
                        class="form-control acct-control"
                        id="accountEmail"
                        value="<%= user?.email || '' %>"
                        readonly
                      />
                      <div class="small text-muted mt-1">
                        Email updates require backend rules. (Readonly for safety)
                      </div>
                    </div>
                  </div>

                  <div class="d-flex flex-wrap justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-outline-secondary acct-btn" id="accountCancelEditBtn" disabled>
                      <i class="bi bi-x-circle me-1"></i>
                      Cancel
                    </button>

                    <button type="submit" class="btn btn-success acct-btn" id="accountSaveBtn" disabled>
                      <i class="bi bi-check-circle me-1"></i>
                      Save Changes
                    </button>
                  </div>

                </form>

                <div class="small text-muted mt-2">
                  <i class="bi bi-info-circle me-1"></i>
                  Works for <b>farm_manager</b> & <b>encoder</b>
                </div>
              </div>
            </div>

            <!-- Change Password CTA -->
            <button
              class="btn acct-pass-btn w-100 mt-3"
              type="button"
              data-bs-toggle="modal"
              data-bs-target="#changePasswordModal"
            >
              <i class="bi bi-shield-lock me-1"></i>
              Change Password
            </button>

          </div>

        </div>

      </div>

    </div>
  </div>
</div>

<!-- =======================
     ACCOUNT FEEDBACK MODAL (NEW)
======================= -->
<div class="modal fade" id="accountFeedbackModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content acct-modal">
      <div class="modal-header acct-modal-header">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-info-circle"></i>
          <h6 class="modal-title mb-0" id="accountFeedbackTitle">Message</h6>
        </div>
        <!-- Close [x] -->
        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="accountFeedbackMessage" class="small mb-0">...</div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-success" type="button" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

<!-- =======================
     CHANGE PASSWORD MODAL (THEME ALIGNED)
======================= -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content acct-modal">

      <!-- HEADER -->
      <div class="modal-header acct-modal-header">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-shield-lock"></i>
          <h6 class="modal-title mb-0">Change Password</h6>
        </div>

        <!-- Close [x] -->
        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- BODY -->
      <div class="modal-body">

        <div class="acct-card p-3">

          <form id="changePasswordForm" autocomplete="off">

            <!-- Step 1: Request OTP -->
            <div class="mb-3">
              <label class="form-label small fw-semibold">Verification Code</label>
              <div class="d-flex gap-2">
                <input
                  type="text"
                  id="changePasswordOtp"
                  class="form-control"
                  placeholder="Enter OTP"
                  required
                />
                <button
                  type="button"
                  class="btn btn-outline-success"
                  id="requestChangePasswordOtpBtn"
                >
                  Send Code
                </button>
              </div>
              <div class="small text-muted mt-1">
                A 6-digit code will be sent to your registered email.
              </div>
            </div>

            <!-- New Password -->
            <div class="mb-3">
              <label class="form-label small fw-semibold">New Password</label>

              <div class="input-group password-group">
                <input
                  type="password"
                  id="changePasswordNew"
                  class="form-control"
                  placeholder="Minimum 8 characters"
                  required
                />
                <button
                  type="button"
                  class="btn btn-outline-secondary toggle-password-btn"
                  data-target="changePasswordNew"
                  aria-label="Toggle password visibility"
                >
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>

            <!-- Confirm Password -->
            <div class="mb-3">
              <label class="form-label small fw-semibold">Confirm Password</label>

              <div class="input-group password-group">
                <input
                  type="password"
                  id="changePasswordConfirm"
                  class="form-control"
                  placeholder="Re-enter password"
                  required
                />
                <button
                  type="button"
                  class="btn btn-outline-secondary toggle-password-btn"
                  data-target="changePasswordConfirm"
                  aria-label="Toggle password visibility"
                >
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>

            <!-- ACTIONS -->
            <div class="d-flex justify-content-end gap-2 mt-3">
              <button
                type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal"
              >
                Cancel
              </button>

              <button
                type="submit"
                class="btn btn-success"
                id="confirmChangePasswordBtn"
              >
                <i class="bi bi-check-circle me-1"></i>
                Update Password
              </button>
            </div>

          </form>

        </div>

      </div>

    </div>
  </div>
</div>

<!-- =======================
     HELP MODAL
======================= -->
<div class="modal fade" id="helpModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
    <div class="modal-content help-modal-shell">

      <!-- Header -->
      <div class="modal-header help-modal-header">
        <div class="d-flex align-items-center gap-2">
          <span class="help-ic">
            <i class="bi bi-life-preserver"></i>
          </span>
          <div class="min-w-0">
            <h5 class="modal-title mb-0 text-truncate">Help & Support</h5>
            <div class="help-sub small text-muted">Guides, common fixes, and ticket submission</div>
          </div>
        </div>

        <button class="btn-close help-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Body -->
      <div class="modal-body help-modal-body">
        <div class="row g-3">

          <!-- LEFT: GUIDE -->
          <div class="col-12 col-lg-4">
            <div class="help-card h-100">
              <div class="help-card-body">

                <!-- Quick Guide -->
                <div class="help-section">
                  <div class="help-section-title">
                    <i class="bi bi-compass"></i>
                    <span>Quick Guide</span>
                  </div>

                  <ul class="help-bullets">
                    <li>
                      <span class="dot"></span>
                      <div><b>Sidebar</b>: Use the left navigation to switch modules.</div>
                    </li>
                    <li>
                      <span class="dot"></span>
                      <div><b>Notifications</b>: Click the bell to view alerts and history.</div>
                    </li>
                    <li>
                      <span class="dot"></span>
                      <div><b>Account Settings</b>: Update your profile and password.</div>
                    </li>
                    <li>
                      <span class="dot"></span>
                      <div><b>Data Safety</b>: Avoid refreshing during file uploads.</div>
                    </li>
                  </ul>
                </div>

                <div class="help-divider"></div>

                <!-- Common Issues -->
                <div class="help-section">
                  <div class="help-section-title">
                    <i class="bi bi-question-circle"></i>
                    <span>Common Issues</span>
                  </div>

                  <div class="help-faq">
                    <div class="faq-item">
                      <div class="faq-q">“Page disappeared” / stuck scroll</div>
                      <div class="faq-a">Close any open modal/offcanvas, then refresh the page.</div>
                    </div>

                    <div class="faq-item">
                      <div class="faq-q">Upload not showing</div>
                      <div class="faq-a">Confirm file type/size and keep the internet stable during upload.</div>
                    </div>

                    <div class="faq-item">
                      <div class="faq-q">Session expired</div>
                      <div class="faq-a">Login again if you were inactive for a while.</div>
                    </div>
                  </div>
                </div>

                <div class="help-divider"></div>

                <!-- Support Email -->
                <div class="help-section">
                  <div class="help-section-title">
                    <i class="bi bi-envelope"></i>
                    <span>Support Email</span>
                  </div>
                  <div class="small text-muted">support@breedit.local</div>
                </div>

              </div>
            </div>
          </div>

          <!-- RIGHT: TICKET -->
          <div class="col-12 col-lg-8">
            <div class="help-card">
              <div class="help-card-body">

                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                  <div class="d-flex align-items-center gap-2">
                    <span class="help-pill-ic"><i class="bi bi-ticket-perforated"></i></span>
                    <div class="help-form-title">Submit a Support Ticket</div>
                  </div>
                  <button type="button" class="badge help-badge help-badge-btn" id="openTicketHistoryBtn">Ticket History</button>
                </div>

                <form id="helpTicketForm" autocomplete="off">
                  <div class="row g-3">

                    <div class="col-12 col-md-6">
                      <label class="form-label help-label">Name</label>
                      <input
                        type="text"
                        class="form-control help-control"
                        id="helpName"
                        value="<%= user?.name || '' %>"
                        placeholder="Your name"
                        required
                      />
                    </div>

                    <div class="col-12 col-md-6">
                      <label class="form-label help-label">Email</label>
                      <input
                        type="email"
                        class="form-control help-control"
                        id="helpEmail"
                        value="<%= user?.email || '' %>"
                        placeholder="you@email.com"
                        required
                      />
                    </div>

                    <div class="col-12 col-md-6">
                      <label class="form-label help-label">Category</label>
                      <select class="form-select help-control" id="helpCategory" required>
                        <option value="" selected disabled>Select category</option>
                        <option value="bug">Bug / Error</option>
                        <option value="account">Account / Access</option>
                        <option value="data">Data Concern</option>
                        <option value="feature">Feature Request</option>
                        <option value="other">Other</option>
                      </select>
                    </div>

                    <div class="col-12 col-md-6">
                      <label class="form-label help-label">Priority</label>
                      <select class="form-select help-control" id="helpPriority" required>
                        <option value="low">Low</option>
                        <option value="normal" selected>Normal</option>
                        <option value="high">High</option>
                        <option value="urgent">Urgent</option>
                      </select>
                      <div class="help-hint">Urgent = blocking your work.</div>
                    </div>

                    <div class="col-12">
                      <label class="form-label help-label">Subject</label>
                      <input
                        type="text"
                        class="form-control help-control"
                        id="helpSubject"
                        placeholder="Short summary (e.g., cannot upload profile photo)"
                        required
                      />
                    </div>

                    <div class="col-12">
                      <label class="form-label help-label">Message</label>
                      <textarea
                        class="form-control help-control"
                        id="helpMessage"
                        rows="5"
                        placeholder="Describe the issue. Include steps to reproduce if possible."
                        required
                      ></textarea>
                      <div class="help-hint mt-1">
                        Tip: include what page you were on and what button you clicked.
                      </div>
                    </div>

                  </div>

                  <div class="d-flex flex-wrap justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-outline-secondary help-btn" data-bs-dismiss="modal">
                      Cancel
                    </button>
                    <button type="submit" class="btn btn-success help-btn" id="helpSubmitTicketBtn">
                      <i class="bi bi-send me-1"></i> Submit Ticket
                    </button>
                  </div>

                </form>

              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
<!-- =========================
     TICKET HISTORY MODAL
========================= -->
<div class="modal fade" id="ticketHistoryModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content help-modal-shell">

      <div class="modal-header help-modal-header">
        <div class="d-flex align-items-center gap-2">
          <span class="help-ic"><i class="bi bi-receipt"></i></span>
          <div class="min-w-0">
            <h5 class="modal-title mb-0">Ticket History</h5>
            <div class="help-sub small text-muted">View submitted tickets and their status.</div>
          </div>
        </div>

        <button type="button" class="btn-close help-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body help-modal-body">

