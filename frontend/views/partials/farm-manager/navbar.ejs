<!-- Topbar -->
<header class="topbar d-flex align-items-center">
  <div class="container-fluid d-flex align-items-center px-3">

    <!-- Left -->
    <div class="d-flex align-items-center top-left flex-shrink-0">
      <!-- Burger icon -->
      <button
        type="button"
        id="burgerBtn"
        class="burger-btn me-2 d-lg-none"
        aria-label="Open sidebar"
      >
        <i class="bi bi-list"></i>
      </button>

      <img
        src="../../images/logo.png"
        alt="Breed-it logo"
        class="brand-logo"
      />
      <div class="brand-text ms-2">BREED-IT</div>
    </div>

    <!-- Right -->
    <div class="ms-auto d-flex align-items-center gap-2 top-icons">

      <!-- Notifications -->
      <button
        type="button"
        class="icon-btn position-relative"
        title="Notifications"
        data-bs-toggle="offcanvas"
        data-bs-target="#notificationsPanel"
        aria-controls="notificationsPanel"
      >
        <i class="bi bi-bell"></i>

        <!-- JS expects this ID -->
        <span
          id="notificationBadge"
          class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
          style="display:none;"
        >
          <span class="visually-hidden">unread notifications</span>
        </span>
      </button>

      <!-- User dropdown -->
      <div class="dropdown">
        <button
          type="button"
          class="icon-btn dropdown-toggle"
          id="userDropdown"
          data-bs-toggle="dropdown"
          aria-expanded="false"
          title="User"
        >
          <i class="bi bi-person-circle"></i>
        </button>

        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
          <li>
            <button
              type="button"
              class="dropdown-item"
              id="accountSettingsBtn"
              data-bs-toggle="modal"
              data-bs-target="#accountSettingsModal"
            >
              Account Settings
            </button>
          </li>

          <li>
            <button
              type="button"
              class="dropdown-item"
              id="helpBtn"
              data-bs-toggle="modal"
              data-bs-target="#helpModal"
            >
              Help
            </button>
          </li>

          <li><hr class="dropdown-divider" /></li>

          <li>
            <button
              type="button"
              class="dropdown-item text-danger"
              id="logoutBtn"
            >
              Logout
            </button>
          </li>
        </ul>
      </div>

    </div>
  </div>
</header>

<!-- =======================
     NOTIFICATIONS PANEL (OFFCANVAS)
======================= -->
<div
  class="offcanvas offcanvas-end"
  tabindex="-1"
  id="notificationsPanel"
  aria-labelledby="notificationsPanelLabel"
>
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="notificationsPanelLabel">Recent Notifications</h5>
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-success btn-sm flex-fill" id="markAllNotificationsReadBtn" type="button">Mark all read</button>
        <button class="btn-close" type="button" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
  </div>

  <div class="offcanvas-body">
    <!-- JS injects items here -->
    <div id="notificationsList" class="list-group list-group-flush small">
      <div class="text-muted small py-2">Loading notifications…</div>
    </div>

    <div class="text-center mt-3">
      <button class="btn btn-outline-secondary btn-sm" id="viewAllNotificationsBtn">
        View All Notifications
      </button>
    </div>
  </div>
</div>

 <!-- =======================
     NOTIFICATION HISTORY MODAL
  ======================= -->
  <div class="modal fade" id="notificationHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
      <div class="modal-content">

        <div class="modal-header">
          <h5 class="modal-title">Notification History</h5>
          <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-success btn-sm" id="markAllNotificationsReadBtnModal">
              Mark all read
            </button>
            <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
        </div> <!-- CLOSE MODAL HEADER -->

        <div class="modal-body">

          <!-- Filters -->
          <div class="d-flex flex-wrap gap-2 mb-3">
            <select class="form-select form-select-sm w-auto" id="notifFilterType">
              <option value="">All Types</option>
              <option value="info">Info</option>
              <option value="success">Success</option>
              <option value="alert">Alert</option>
              <option value="error">Error</option>
              <option value="maintenance">Maintenance</option>
            </select>

            <select class="form-select form-select-sm w-auto" id="notifFilterTime">
              <option value="">All Time</option>
              <option value="24h">Last 24 hours</option>
              <option value="7d">Last 7 days</option>
              <option value="30d">Last 30 days</option>
            </select>
          </div>

          <!-- Pagination -->
          <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="notifPrevPageBtn">
              <i class="bi bi-chevron-left"></i>
              Prev
            </button>

            <div class="small text-muted fw-semibold" id="notifPageLabel">Page 1 / 1</div>

            <button type="button" class="btn btn-outline-secondary btn-sm" id="notifNextPageBtn">
              Next
              <i class="bi bi-chevron-right"></i>
            </button>
          </div>

          <!-- JS injects history here -->
          <div class="list-group list-group-flush" id="notificationHistoryList">
            <div class="text-muted small py-2">Loading notifications…</div>
          </div>

        </div>

      </div>
    </div>
  </div>

<!-- =======================
     ACCOUNT SETTINGS MODAL
======================= -->
<div class="modal fade" id="accountSettingsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-end modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Account Settings</h5>
        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <p class="mb-1"><strong>Name:</strong> <%= user?.name || "—" %></p>
        <p class="mb-1"><strong>Email:</strong> <%= user?.email || "—" %></p>
        <p class="mb-0"><strong>Role:</strong> <%= user?.role || "—" %></p>

        <button
          class="btn btn-outline-primary w-100 mt-3"
          type="button"
          data-bs-toggle="modal"
          data-bs-target="#changePasswordModal"
        >
          Change Password
        </button>
      </div>

    </div>
  </div>
</div>

<!-- =======================
     CHANGE PASSWORD MODAL
======================= -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Change Password</h5>
        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">

        <!-- STEP 1 -->
        <button
          class="btn btn-outline-secondary w-100 mb-3"
          type="button"
          id="requestChangeOtpBtn"
        >
          Send OTP to Email
        </button>

        <!-- STEP 2 -->
        <form id="changePasswordForm">
          <div class="mb-3">
            <label class="form-label small">OTP</label>
            <input
              type="text"
              class="form-control otp-input"
              id="changeOtp"
              required
            />
          </div>

          <div class="mb-3">
            <label class="form-label small">New Password</label>
            <input
              type="password"
              class="form-control"
              id="changeNewPassword"
              required
            />
          </div>

          <button class="btn btn-primary w-100" type="submit">
            Change Password
          </button>
        </form>

        <p id="changePasswordMessage" class="small text-center mt-3 mb-0"></p>

      </div>

    </div>
  </div>
</div>

<!-- =======================
     HELP MODAL
======================= -->
<div class="modal fade" id="helpModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Help</h5>
        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <ul class="small mb-2">
          <li>Use the sidebar to navigate modules.</li>
          <li>Your session may expire after inactivity.</li>
          <li>Contact admin for account issues.</li>
        </ul>

        <p class="small mt-2 text-muted mb-0">
          Support: support@breedit.local
        </p>
      </div>

    </div>
  </div>
</div>

<!-- App shell -->
<div class="app-shell">