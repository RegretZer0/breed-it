<!-- Header card with tabs -->
<div class="card page-card panel-card mb-3">
  <div class="card-body">

    <!-- Title row -->
    <div class="panel-title-row">
      <h2 class="page-title panel-title mb-0">
        USER MANAGEMENT
      </h2>
    </div>

    <!-- Tabs -->
    <div
      class="tabs-row tabs-grid-2 mt-3"
      role="tablist"
      aria-label="Farmer management sections"
    >

      <!-- MANAGE ACCOUNT -->
      <a
        href="/farm-manager/user-management/manage"
        class="tab-btn <%= current_page === 'manage_account' ? 'active' : '' %>"
        role="tab"
        aria-selected="<%= current_page === 'manage_account' ? 'true' : 'false' %>"
      >
        Manage Account
      </a>

      <!-- NEW ACCOUNT -->
      <a
        href="/farm-manager/user-management/create"
        class="tab-btn <%= current_page === 'create_account' ? 'active' : '' %>"
        role="tab"
        aria-selected="<%= current_page === 'create_account' ? 'true' : 'false' %>"
      >
        New Account
      </a>

    </div>
  </div>
</div>