<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
  
  <link rel="stylesheet" href="../../../css/farmer/globalNav.css">

  <% if (page_title === "Farmer Dashboard") { %>
    <link rel="stylesheet" href="../../../css/farmer/farmer_dashboard.css">

  <% } else if (page_title === "MyPigs") { %>
    <link rel="stylesheet" href="../../../css/farmer/mypigs.css">

  <% } else if (page_title === "Report") { %>
    <link rel="stylesheet" href="../../../css/farmer/report/report.css">
    <link rel="stylesheet" href="../../../css/farmer/report/report-card.css">
    <link rel="stylesheet" href="../../../css/farmer/report/report-filter.css">
    <link rel="stylesheet" href="../../../css/farmer/report/report-modal.css">

  <% } else if (page_title === "Profile") { %>
    <link rel="stylesheet" href="../../../css/farmer/profile.css">

  <% } else if (page_title === "Your Schedule") { %>
    <link rel="stylesheet" href="../../../css/farmer/calendar.css">

  <% } else if (page_title === "Reproduction Growth") { %>
    <link rel="stylesheet" href="../../../css/farmer/reproduction.css">

  <% } else if (page_title === "Breeding Analytics") { %>
    <link rel="stylesheet" href="../../../css/farmer/breeding_analytics.css">

  <% } else if (page_title === "Help") { %>
    <link rel="stylesheet" href="../../../css/farmer/help.css">
    
  <% } %>

  <script>
    function initVirtualClock() {
      const clockEl = document.getElementById('globalVirtualClock');
      const containerEl = document.getElementById('virtualClockContainer');
      if (!clockEl) return;

      function updateClock() {
        const offset = parseInt(localStorage.getItem('timeWarpOffset') || "0");
        const virtualNow = new Date(Date.now() + offset);

        const options = { 
          month: 'short', 
          day: '2-digit',
          year: 'numeric',
          hour: '2-digit', 
          minute: '2-digit',
          hour12: true 
        };

        clockEl.textContent = virtualNow.toLocaleString('en-US', options);

        if (offset !== 0) {
          containerEl.style.color = "#dc3545"; 
          containerEl.style.fontWeight = "bold";
        } else {
          containerEl.style.color = "inherit";
          containerEl.style.fontWeight = "normal";
        }
      }

      setInterval(updateClock, 1000);
      updateClock();
    }
    document.addEventListener('DOMContentLoaded', initVirtualClock);
  </script>
</head>

<body>

<div class="mobile-menu" id="mobileMenu">
  <div class="menu-list">

    <button class="close-btn" id="closeMenu" aria-label="Close menu">
      <i class="bi bi-x-lg"></i>
    </button>

    <ul class="menu-items">
      <li data-action="settings">
        <i class="bi bi-gear"></i>
        <span data-i18n="settings">Settings</span>
      </li>

      <li data-action="logout">
        <i class="bi bi-box-arrow-right"></i>
        <span data-i18n="logout">Logout</span>
      </li>
    </ul>

  </div>
</div>


<header class="page-header">
  <div class="nav-left">
    <% if (current_page !== "farmer_dashboard") { %>
      <button class="back-btn" id="backBtn" aria-label="Back">
        <i class="bi bi-chevron-left"></i>
      </button>
    <% } else { %>
      <div class="back-btn-placeholder"></div>
    <% } %>
  </div>

  <div class="nav-center" id="virtualClockContainer" style="font-size: 0.8rem; display: flex; align-items: center; gap: 4px; opacity: 0.9;">
    <i class="bi bi-clock-history" style="font-size: 0.7rem;"></i>
    <span id="globalVirtualClock">Loading...</span>
  </div>

  <div class="nav-right">

    <button class="icon-btn" id="openNotifications" aria-label="Notifications">
      <i class="bi bi-bell"></i>
      <span id="notificationBadge"
            class="notification-badge"
            style="display:none;">
      </span>
    </button>

    <button class="menu-btn" id="openMenu" aria-label="Menu">
      <i class="bi bi-list"></i>
    </button>

  </div>
</header>


<div class="side-panel" id="settingsPanel">
  <div class="panel-header">
    <h3 data-i18n="settings">Settings</h3>
    <button class="close-panel" data-close="settingsPanel" aria-label="Close">
      <i class="bi bi-x-lg"></i>
    </button>
  </div>

  <div class="panel-content">

    <div class="settings-section">
      <h4 data-i18n="language">Language</h4>

      <select id="languageSelect" class="settings-select">
        <option value="en">English</option>
        <option value="tl">Tagalog</option>
      </select>
    </div>

    <div class="settings-actions">
      <button class="reset-btn"
              data-i18n="reset"
              id="resetSettings">
        Reset
      </button>

      <button class="save-btn"
              data-i18n="save"
              id="saveSettings">
        Save
      </button>
    </div>

  </div>
</div>

<div class="side-panel notifications-panel" id="notificationsPanel">

  <div class="panel-hero">
    <h3>Notifications</h3>
    <button class="close-panel"
            data-close="notificationsPanel"
            aria-label="Close">
      <i class="bi bi-x-lg"></i>
    </button>
  </div>

  <div class="panel-body">

    <div id="notificationsList" class="notification-list">
      </div>

    <button id="viewAllNotificationsBtn"
            class="view-all-btn">
      View All Notifications
    </button>

  </div>
</div>

<div class="side-panel notifications-panel history-panel"
     id="notificationHistoryModal">

  <div class="panel-hero">
    <h3>Notification History</h3>
    <button class="close-panel"
            data-close="notificationHistoryModal"
            aria-label="Close">
      <i class="bi bi-x-lg"></i>
    </button>
  </div>

  <div class="panel-body">

    <div id="notificationHistoryList"
         class="notification-list">
    </div>

  </div>
</div>