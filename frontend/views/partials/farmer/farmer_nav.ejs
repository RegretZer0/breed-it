<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
  
  <!-- Global Farmer Nav CSS -->
  <link rel="stylesheet" href="../../../css/farmer/globalNav.css">

  <% if (page_title === "Farmer Dashboard") { %>
    <link rel="stylesheet" href="../../../css/farmer/farmer_dashboard.css">

  <% } else if (page_title === "MyPigs") { %>
    <link rel="stylesheet" href="../../../css/farmer/mypigs.css">

  <% } else if (page_title === "Report") { %>
    <link rel="stylesheet" href="../../../css/farmer/report/report.css">
    <link rel="stylesheet" href="../../../css/farmer/report/report-card.css">
    <link rel="stylesheet" href="../../../css/farmer/report/report-filter.css">
    <link rel="stylesheet" href="../../../css/farmer/report/report-modal.css">

  <% } else if (page_title === "Profile") { %>
    <link rel="stylesheet" href="../../../css/farmer/profile.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css">

  <% } else if (page_title === "Your Schedule") { %>
    <link rel="stylesheet" href="../../../css/farmer/calendar.css">

  <% } else if (page_title === "Reproduction Growth") { %>
    <link rel="stylesheet" href="../../../css/farmer/reproduction.css">

  <% } else if (page_title === "Breeding Analytics") { %>
    <link rel="stylesheet" href="../../../css/farmer/breeding_analytics.css">

  <% } else if (page_title === "Help") { %>
    <link rel="stylesheet" href="../../../css/farmer/help.css">
    
  <% } %>
</head>

<body>

<!-- =========================
     MOBILE MENU
========================= -->
<div class="mobile-menu" id="mobileMenu">
  <div class="menu-list">

    <!-- Close Button -->
    <button class="close-btn" id="closeMenu" aria-label="Close menu">
      <i class="bi bi-x-lg"></i>
    </button>

    <!-- Menu Items -->
    <ul class="menu-items">
      <li data-action="settings">
        <i class="bi bi-gear"></i>
        <span data-i18n="settings">Settings</span>
      </li>

      <li data-action="logout">
        <i class="bi bi-box-arrow-right"></i>
        <span data-i18n="logout">Logout</span>
      </li>
    </ul>

  </div>
</div>


<!-- =========================
     HEADER
========================= -->
<header class="page-header">
  <div class="nav-left">
    <% if (current_page !== "farmer_dashboard") { %>
      <button class="back-btn" id="backBtn" aria-label="Back">
        <i class="bi bi-chevron-left"></i>
      </button>
    <% } else { %>
      <div class="back-btn-placeholder"></div>
    <% } %>
  </div>

  <!-- RIGHT SIDE ICONS -->
  <div class="nav-right">

    <!-- Notifications -->
    <button class="icon-btn" id="openNotifications" aria-label="Notifications">
      <i class="bi bi-bell"></i>
      <span id="notificationBadge"
            class="notification-badge"
            style="display:none;">
      </span>
    </button>

    <!-- Burger Menu -->
    <button class="menu-btn" id="openMenu" aria-label="Menu">
      <i class="bi bi-list"></i>
    </button>

  </div>
</header>


<div class="side-panel" id="settingsPanel">
  <div class="panel-header">
    <h3 data-i18n="settings">Settings</h3>
    <button class="close-panel" data-close="settingsPanel" aria-label="Close">
      <i class="bi bi-x-lg"></i>
    </button>
  </div>

  <div class="panel-content">

    <div class="settings-section">
      <h4 data-i18n="language">Language</h4>

      <select id="languageSelect" class="settings-select">
        <option value="en">English</option>
        <option value="tl">Tagalog</option>
      </select>
    </div>

    <div class="settings-actions">
      <button class="reset-btn"
              data-i18n="reset"
              id="resetSettings">
        Reset
      </button>

      <button class="save-btn"
              data-i18n="save"
              id="saveSettings">
        Save
      </button>
    </div>

  </div>
</div>

<!-- =========================
     NOTIFICATIONS PANEL (REDESIGNED) — SINGLE INSTANCE ONLY
========================= -->
<div class="side-panel notifications-panel" id="notificationsPanel">
  <div class="panel-hero">
    <div class="d-flex flex-column">
      <h3 class="mb-0">Notifications</h3>
      <small class="opacity-75">Latest updates</small>
    </div>

    <div class="d-flex align-items-center gap-2">
      <button type="button"
              class="btn btn-light btn-sm notif-hero-btn"
              id="markAllNotificationsReadBtn">
        <i class="bi bi-check2-all me-1"></i> Mark all
      </button>

      <button class="close-panel"
              data-close="notificationsPanel"
              aria-label="Close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
  </div>

  <div class="panel-body">
    <div id="notificationsList" class="notification-list">
      <!-- Dynamic -->
    </div>

    <button id="viewAllNotificationsBtn" class="view-all-btn">
      View All Notifications
    </button>
  </div>
</div>

<!-- =========================
     NOTIFICATION HISTORY PANEL (REDESIGNED)
========================= -->
<div class="side-panel notifications-panel history-panel"
     id="notificationHistoryModal">

  <div class="panel-hero">
    <div class="d-flex flex-column">
      <h3 class="mb-0">Notification History</h3>
      <small class="opacity-75">All notifications</small>
    </div>

    <div class="d-flex align-items-center gap-2">
      <button type="button"
              class="btn btn-light btn-sm notif-hero-btn"
              id="markAllNotificationsReadBtnModal">
        <i class="bi bi-check2-all me-1"></i> Mark all
      </button>

      <button class="close-panel"
              data-close="notificationHistoryModal"
              aria-label="Close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
  </div>

  <div class="panel-body">
    <div class="notif-filters">
      <div class="row g-2 align-items-end">
        <div class="col-12 col-md-6">
          <label class="form-label notif-filter-label">Type</label>
          <select class="form-select form-select-sm" id="notifFilterType">
            <option value="">All Types</option>
            <option value="info">Info</option>
            <option value="success">Success</option>
            <option value="warning">Warning</option>
          </select>
        </div>

        <div class="col-12 col-md-6">
          <label class="form-label notif-filter-label">Time</label>
          <select class="form-select form-select-sm" id="notifFilterTime">
            <option value="">Any time</option>
            <option value="today">Today</option>
            <option value="7d">Last 7 days</option>
            <option value="30d">Last 30 days</option>
          </select>
        </div>
      </div>
    </div>

    <div id="notificationHistoryList" class="notification-list">
      <!-- Dynamic -->
    </div>

    <div class="notif-pager">
      <button type="button" class="btn btn-outline-secondary btn-sm" id="notifPrevPageBtn">
        <i class="bi bi-chevron-left"></i>
      </button>

      <div class="notif-page-label" id="notifPageLabel">Page 1 / 1</div>

      <button type="button" class="btn btn-outline-secondary btn-sm" id="notifNextPageBtn">
        <i class="bi bi-chevron-right"></i>
      </button>
    </div>
  </div>
</div>